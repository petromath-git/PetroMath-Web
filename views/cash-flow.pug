extends layout
include mixins/mixins
include mixins/new-closing-mixins

block content
    - const creditPrefix = 'cashflow-credit-';
    - const debitPrefix = 'cashflow-debit-';
    - var denominationValuesJson = config.cashFlowDenominationValuesJson;
    - let divClass = "";
    if(cashFlowStatus == 'CLOSED')
        - divClass = 'disabledInputs';
    input(type='hidden' id='cashflowId_hiddenId' value=cashflowId)
    input(type='hidden' id='user' value=user)
    input(type='hidden' id='denominationValuesJson_hiddenValue' value= denominationValuesJson)
    
    //- NEW: Shift Closings Summary Table
    if shiftClosings && shiftClosings.length > 0
        div.row.mb-4.cashflow-page
            div.col-12
                div.card
                    div.card-header.text-white.bg-dark Cashier Shifts Contributing to this Cash Flow
                    div.card-body
                        //- On phones only Date / Cashier / Collection / Status are shown
                        div.table-responsive
                            table.table
                                thead.thead-light
                                    tr
                                        th.text-center.d-none.d-md-table-cell Closing ID
                                        th.text-center Closing Date
                                        th.text-center Cashier Name
                                        th.text-center Total Collection
                                        th.text-center Status
                                        th.text-center.d-none.d-md-table-cell Notes
                                tbody
                                    - var totalCollectionSum = 0;
                                    each closing in shiftClosings
                                        tr
                                            td.text-center.d-none.d-md-table-cell= closing.closing_id
                                            td.text-center.text-nowrap= new Date(closing.closing_date).toLocaleDateString('en-IN')
                                            td.text-center= closing.cashier_name || 'N/A'
                                            td.text-right.text-nowrap ₹ #{parseFloat(closing.total_collection || 0).toFixed(2)}
                                            td.text-center
                                                if closing.status === 'CLOSED'
                                                    span.badge.badge-success #{closing.status}
                                                else if closing.status === 'DRAFT'
                                                    span.badge.badge-warning #{closing.status}
                                                else
                                                    span.badge.badge-secondary #{closing.status}
                                            td.text-center.d-none.d-md-table-cell= closing.notes || '-'
                                        - totalCollectionSum += parseFloat(closing.total_collection || 0);
                                //- Summary Row
                                tr.bg-info.text-white.font-weight-bold
                                    td.d-none.d-md-table-cell &nbsp;
                                    td.text-center(colspan="2")
                                        strong TOTAL (#{shiftClosings.length} shifts)
                                    td.text-right.text-nowrap
                                        strong ₹ #{totalCollectionSum.toFixed(2)}
                                    td &nbsp;
                                    td.d-none.d-md-table-cell &nbsp;
    else
        //- No closings found message
        div.row.mb-4
            div.col-12
                div.alert.alert-warning.text-center
                    i.fa.fa-info-circle
                    |  No Cashier Shifts found for this cash flow period.

    div
    //- EXISTING: Credit/Debit Tables (unchanged)
    div.row.cashflow-page#cashflow-txn-data(class=divClass)
        div.col-12.col-lg-6.mb-3
            div.card
                div.card-header.text-white.bg-dark OutFlow
                div.card-body
                    table.table.cashflow-entry-table(id= debitPrefix + "table")
                        tbody.thead-light
                            +addCashFlowHeader()
                            - var debitRowCnt = 0
                            if cashFlowDebits && cashFlowDebits.length > 0
                                each val, index in cashFlowDebits
                                    +addCashFlowEntry(val, config.cashSaleTypes[1], debitPrefix, debitRowCnt++)

                            while debitRowCnt < maxCashFlowRows
                                +newCashFlowEntry(config.cashSaleTypes[1], debitPrefix, debitRowCnt++)
                            tr.cashflow-total-row
                                td &nbsp;
                                td(style="text-align:right") Total
                                td
                                    input.form-control#cashflow-debit-total(readonly)
                    div
                        a.btn.btn-primary(id='debit-add-new' onclick='showAddedRow(\'cashflow-debit\')')
                            span.oi.oi-plus
                            span.d-md-none &nbsp;Add OutFlow
        div.col-12.col-lg-6.mb-3
            div.card
                div.card-header.text-white.bg-dark InFlow
                div.card-body
                    table.table.cashflow-entry-table(id=creditPrefix+"table")
                        thead.thead-light
                            +addCashFlowHeader()
                            - var rowCnt = 0
                            if cashFlowCredits && cashFlowCredits.length > 0
                                each val,index in cashFlowCredits
                                    +addCashFlowEntry(val, config.cashSaleTypes[0], creditPrefix, rowCnt++)

                            while rowCnt < maxCashFlowRows
                                +newCashFlowEntry(config.cashSaleTypes[0], creditPrefix, rowCnt++)
                            tr.cashflow-total-row
                                td &nbsp;
                                td(style="text-align:right") Total
                                td
                                    input.form-control#cashflow-credit-total(readonly)
                    div
                        a.btn.btn-primary(id='credit-add-new' onclick='showAddedRow(\'cashflow-credit\')')
                            span.oi.oi-plus
                            span.d-md-none &nbsp;Add InFlow
    div.row
        div.col-12
            div.card
                div.card-body.text-right
                    strong Difference (InFlow &minus; OutFlow):&nbsp;
                    strong#cashflow-difference-total 0.00
    div &nbsp;
    if showCashFlowDenominations
        div.row.cashflow-page(class=divClass)
            div.col-12.col-md-6.offset-md-3.col-lg-4.offset-lg-4
                div.card
                    div.card-header.text-white.bg-dark Denominations
                    div.card-body
                        div.table-responsive
                            table.table#denom-table
                                tbody
                                    +addDenomRows(cashFlowDenoms)
                                    tr
                                        td.text-right Total
                                        td
                                            input.form-control#denominations_total(type='text' name='denominations_total' readonly value='0')

    div.row
        div &nbsp;
    div.cashflow-actions(style="text-align:center")
        if(cashFlowStatus != 'CLOSED')
            span
                button.btn.btn-primary(type="button", onClick="saveCashFlowTxnsAndDenoms()") SAVE
            span &nbsp;
            span
                //- After closing, land on that day's Day Close report
                button.btn.btn-dark(id='cashflow-close' disabled=true onClick=`finishClosing('cashflowId','close-cashflow','reports-dsr?date=${cashflowDate}')`) CLOSE &raquo;
        else
            a.btn.btn-primary(href='/reports-dsr?date=' + cashflowDate)
                i.bi.bi-file-earmark-pdf
                span &nbsp;View Day Close Report
            span &nbsp;
            a.btn.btn-outline-secondary(href='/cashflowhome') Back to Day Close

    input(type='hidden' id='cashflow-debit-rowcnt_hiddenValue' value=debitRowCnt)
    script.
        document.addEventListener('DOMContentLoaded', function() {
            calculateCashflowDebitTotal();
            calculateCashflowCreditTotal();
            initCashflowVendorPickers('cashflow-debit-', parseInt(document.getElementById('cashflow-debit-rowcnt_hiddenValue').value, 10));
        });

