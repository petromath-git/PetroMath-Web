extends ../layout

block content
    .card.mb-3
        .card-header(style='background-color: #f8f9fa;')
            .d-flex.justify-content-between.align-items-center
                h6.mb-0
                    i.bi.bi-cash-stack.me-2
                    | Payments — All Locations
                a.btn.btn-outline-secondary.btn-sm(href='/platform-billing')
                    i.bi.bi-arrow-left.me-1
                    | Back to Invoices
        .card-body
            .row.g-3
                .col-md-2.col-6
                    label.form-label Period:
                    select.form-control#periodPreset(onchange="glSetPeriod(this)" data-from="fromDate" data-to="toDate")
                        option(value="this_month") This Month
                        option(value="last_month") Last Month
                        option(value="this_fy") This Financial Year
                        option(value="last_fy") Last Financial Year
                        option(value="custom" selected) Custom
                .col-md-3.col-6
                    label.form-label From Date:
                    input#fromDate.form-control(type='date' value=fromDate)
                .col-md-3.col-6
                    label.form-label To Date:
                    input#toDate.form-control(type='date' value=toDate max=today)
                .col-md-3.col-6
                    label.form-label Location:
                    select#filterLocation.form-control
                        option(value='') All Locations
                        each loc in locations
                            option(value=loc.location_code selected=(locationCode === loc.location_code))= loc.location_name + ' (' + loc.location_code + ')'
                .col-md-2.d-flex.align-items-end
                    button.btn.btn-primary.w-100(type='button' onclick='applyFilter()')
                        i.bi.bi-search.me-2
                        | Go

    div.container-fluid
        if payments && payments.length
            .table-responsive
                table.table.table-desktop(style='width:100% !important;')
                    thead.thead-light
                        tr
                            th Date
                            th Location
                            th.text-right Amount
                            th Mode
                            th Reference
                            th Invoices Covered
                    tbody
                        each p in payments
                            tr
                                td= new Date(p.payment_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})
                                td= p.location_name + ' (' + p.location_code + ')'
                                td.text-right ₹#{Number(p.amount).toLocaleString('en-IN', {minimumFractionDigits: 2})}
                                td= p.payment_mode
                                td= p.reference_number || '-'
                                td= p.invoice_numbers || '-'
        else
            .alert.alert-info No payments found for the selected period.

    script.
        function applyFilter() {
            const from = document.getElementById('fromDate').value;
            const to   = document.getElementById('toDate').value;
            const loc  = document.getElementById('filterLocation').value;
            window.location.href = '/platform-billing/payments?fromDate=' + from + '&toDate=' + to + '&locationCode=' + loc;
        }
