extends ../layout

block content
    style.
        .table-responsive {
            max-height: calc(100vh - 350px);
            overflow-y: auto;
        }
        table.table-desktop thead.thead-light {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #f8f9fa;
        }
        .badge-status-UNPAID { background-color: #dc3545; }
        .badge-status-PARTIAL { background-color: #fd7e14; }
        .badge-status-PAID { background-color: #198754; }
        .badge-status-CANCELLED { background-color: #6c757d; }
        .badge-run-SUCCESS { background-color: #198754; color: #fff; }
        .badge-run-PARTIAL { background-color: #fd7e14; color: #fff; }
        .badge-run-FAILED { background-color: #dc3545; color: #fff; }
        .badge-run-RUNNING { background-color: #0d6efd; color: #fff; }

    .card.mb-3
        .card-header(style='background-color: #f8f9fa;')
            .d-flex.justify-content-between.align-items-center
                h6.mb-0
                    i.bi.bi-receipt.me-2
                    | Platform Billing — All Locations
                div
                    a.btn.btn-outline-secondary.btn-sm.me-2(href='/platform-billing/plans')
                        i.bi.bi-sliders.me-1
                        | Billing Plans
                    a.btn.btn-outline-secondary.btn-sm.me-2(href='/platform-billing/payments')
                        i.bi.bi-cash-stack.me-1
                        | Payments
                    a.btn.btn-outline-secondary.btn-sm.me-2(href='/platform-billing/ledger')
                        i.bi.bi-journal-text.me-1
                        | Ledger
                    a.btn.btn-outline-secondary.btn-sm.me-2(href='/platform-billing/runs')
                        i.bi.bi-clock-history.me-1
                        | Run Log
                    a.btn.btn-outline-secondary.btn-sm.me-2(href='/distributors')
                        i.bi.bi-people.me-1
                        | Distributors
                    button.btn.btn-outline-success.btn-sm.me-2#btnOpenGenerate(type='button')
                        i.bi.bi-lightning-charge.me-1
                        | Generate Invoices
                    button.btn.btn-primary.btn-sm#btnOpenPayment(type='button')
                        i.bi.bi-cash-coin.me-1
                        | Record Payment
        .card-body
            .small.text-muted.mb-2
                i.bi.bi-clock-history.me-1
                | Invoices are generated automatically on the 3rd of every month (next run: #{nextAutoRun}) —
                | Arrears locations are billed for the month just ended, Advance locations for the current month.
                | Set each location's timing on
                a(href='/platform-billing/plans')  Billing Plans
            .small.mb-2
                if lastRun
                    | Last run: #{lastRun.started_label} (#{lastRun.trigger_type.toLowerCase()}) —
                    span.badge.ml-1(class=`badge-run-${lastRun.status}`)= lastRun.status
                    |  #{lastRun.generated_count} generated
                    if lastRun.error_count
                        | , #{lastRun.error_count} failed
                    |  ·
                    a(href='/platform-billing/runs')  view log
                else
                    span.text-muted No billing runs recorded yet.
            .row.g-3
                .col-md-2.col-6
                    label.form-label Period:
                    select.form-control#periodPreset(onchange="glSetPeriod(this)" data-from="fromPeriod" data-to="toPeriod")
                        option(value="this_month") This Month
                        option(value="last_month") Last Month
                        option(value="this_fy") This Financial Year
                        option(value="last_fy") Last Financial Year
                        option(value="custom" selected) Custom
                .col-md-2.col-6
                    label.form-label From Period:
                    input#fromPeriod.form-control(type='date' value=fromPeriod)
                .col-md-2.col-6
                    label.form-label To Period:
                    input#toPeriod.form-control(type='date' value=toPeriod max=today)
                .col-md-3.col-6
                    label.form-label Location:
                    select#filterLocation.form-control
                        option(value='') All Locations
                        each loc in locations
                            option(value=loc.location_code selected=(locationCode === loc.location_code))= loc.location_name + ' (' + loc.location_code + ')'
                .col-md-2.col-6
                    label.form-label Payment:
                    select#filterPaymentStatus.form-control
                        option(value='') All
                        option(value='UNPAID' selected=(paymentStatus === 'UNPAID')) Unpaid (incl. partial)
                        option(value='PAID' selected=(paymentStatus === 'PAID')) Paid
                .col-md-1.d-flex.align-items-end
                    button.btn.btn-primary.w-100(type='button' onclick='applyFilter()')
                        i.bi.bi-search.me-2
                        | Go

    div.container-fluid
        if invoices && invoices.length
            .table-responsive
                table.table.table-desktop(style='width:100% !important;')
                    thead.thead-light.sticky-top
                        tr
                            th Location
                            th Invoice #
                            th Service Month
                            th.text-right Gross
                            th.text-right Discount
                            th.text-right Net
                            th.text-right Paid
                            th.text-right Balance
                            th.text-center Status
                            th.text-center PDF
                            th.text-center Adjust
                    tbody
                        each inv in invoices
                            tr
                                td
                                    = inv.location_name + ' (' + inv.location_code + ')'
                                    if inv.billing_timing
                                        span.badge.ml-1(class=inv.billing_timing === 'ADVANCE' ? 'badge-info' : 'badge-secondary' title='Current billing timing')= inv.billing_timing === 'ADVANCE' ? 'Advance' : 'Arrears'
                                td= inv.invoice_number
                                td= inv.service_label
                                td.text-right= Number(inv.gross_amount).toLocaleString('en-IN', {minimumFractionDigits: 2})
                                td.text-right= Number(inv.discount_amount).toLocaleString('en-IN', {minimumFractionDigits: 2})
                                td.text-right= Number(inv.net_amount).toLocaleString('en-IN', {minimumFractionDigits: 2})
                                td.text-right= Number(inv.paid_amount).toLocaleString('en-IN', {minimumFractionDigits: 2})
                                td.text-right= (Number(inv.net_amount) - Number(inv.paid_amount)).toLocaleString('en-IN', {minimumFractionDigits: 2})
                                td.text-center
                                    span.badge(class=`badge-status-${inv.status}`)= inv.status
                                td.text-center
                                    a.btn.btn-outline-secondary.btn-sm(href=`/platform-billing/${inv.invoice_id}/pdf` title='Download PDF')
                                        i.bi.bi-file-earmark-pdf
                                td.text-center
                                    button.btn.btn-outline-secondary.btn-sm.btn-adjust(type='button' data-invoice-id=inv.invoice_id data-invoice-number=inv.invoice_number)
                                        i.bi.bi-pencil-square
        else
            .alert.alert-info No invoices found for the selected period.

    //- ── Generate Invoices Modal ──────────────────────────────────────────
    #generateModal.modal(tabindex='-1')
        .modal-dialog
            .modal-content
                .modal-header
                    h5.modal-title Generate Invoices
                    button.close(type='button' data-dismiss='modal' aria-label='Close')
                        span(aria-hidden='true') &times;
                .modal-body
                    p.small.text-muted You normally don't need this — the same run happens automatically on the 3rd of every month.
                    .form-check.mb-2
                        input.form-check-input#genModeDue(type='radio' name='genMode' value='DUE' checked)
                        label.form-check-label(for='genModeDue')
                            strong Bill everything that's due now
                            br
                            small.text-muted Each location's due month as per its billing timing, plus any month that was missed. Already-billed months are skipped.
                    .form-check.mb-2
                        input.form-check-input#genModeMonth(type='radio' name='genMode' value='MONTH')
                        label.form-check-label(for='genModeMonth')
                            strong Bill a specific service month
                            br
                            small.text-muted Ignores billing timing — use for a one-off backfill.
                    #genMonthBlock.pl-4(style='display:none;')
                        label.form-label Service month:
                        input#genPeriodMonth.form-control(type='month' max=thisMonth)
                    .mt-3
                        label.form-label Location:
                        select#genLocation.form-control
                            option(value='') All locations
                            each loc in locations
                                option(value=loc.location_code)= loc.location_name + ' (' + loc.location_code + ')'
                .modal-footer
                    button.btn.btn-secondary(type='button' data-dismiss='modal') Cancel
                    button.btn.btn-success#btnGenerate(type='button') Generate

    //- ── Record Payment Modal ─────────────────────────────────────────────
    #paymentModal.modal(tabindex='-1')
        .modal-dialog
            .modal-content
                .modal-header
                    h5.modal-title Record Payment
                    button.close(type='button' data-dismiss='modal' aria-label='Close')
                        span(aria-hidden='true') &times;
                .modal-body
                    .mb-3
                        label.form-label Location:
                        select#payLocation.form-control
                            option(value='') -- Select --
                            each loc in locations
                                option(value=loc.location_code)= loc.location_name + ' (' + loc.location_code + ')'
                    .mb-3
                        label.form-label Payment Date:
                        input#payDate.form-control(type='date' value=today)
                    .mb-3
                        label.form-label Amount:
                        input#payAmount.form-control(type='number' step='0.01' min='0')
                    .mb-3
                        label.form-label Mode:
                        select#payMode.form-control
                            option(value='MANUAL_CASH') Cash
                            option(value='MANUAL_UPI') UPI / GPay
                            option(value='MANUAL_BANK') Bank Transfer
                            option(value='MANUAL_CHEQUE') Cheque
                            option(value='OTHER') Other
                    .mb-3
                        label.form-label Reference No. (optional):
                        input#payReference.form-control(type='text')
                    .mb-3#outstandingBlock(style='display:none;')
                        label.form-label Outstanding invoices for this location (optional — leave all unchecked to auto-apply the amount oldest-invoice-first):
                        div#outstandingList.border.rounded.p-2(style='max-height:200px; overflow-y:auto;')
                .modal-footer
                    button.btn.btn-secondary(type='button' data-dismiss='modal') Cancel
                    button.btn.btn-primary#btnSavePayment(type='button') Save Payment

    //- ── Adjustment Modal ─────────────────────────────────────────────────
    #adjustModal.modal(tabindex='-1')
        .modal-dialog
            .modal-content
                .modal-header
                    h5.modal-title#adjustModalTitle Add Adjustment
                    button.close(type='button' data-dismiss='modal' aria-label='Close')
                        span(aria-hidden='true') &times;
                .modal-body
                    .mb-3
                        label.form-label Reason:
                        input#adjustDescription.form-control(type='text' placeholder='e.g. Goodwill credit')
                    .mb-3
                        label.form-label Amount (negative = discount, positive = extra charge):
                        input#adjustAmount.form-control(type='number' step='0.01')
                .modal-footer
                    button.btn.btn-secondary(type='button' data-dismiss='modal') Cancel
                    button.btn.btn-primary#btnSaveAdjustment(type='button') Save

    script.
        function applyFilter() {
            const from = document.getElementById('fromPeriod').value;
            const to   = document.getElementById('toPeriod').value;
            const loc  = document.getElementById('filterLocation').value;
            const pay  = document.getElementById('filterPaymentStatus').value;
            window.location.href = '/platform-billing?fromPeriod=' + from + '&toPeriod=' + to + '&locationCode=' + loc + '&paymentStatus=' + pay;
        }

        let adjustInvoiceId = null;
        $('.btn-adjust').on('click', function() {
            adjustInvoiceId = $(this).data('invoice-id');
            $('#adjustModalTitle').text('Add Adjustment — ' + $(this).data('invoice-number'));
            $('#adjustDescription').val('');
            $('#adjustAmount').val('');
            $('#adjustModal').modal('show');
        });

        $('#btnSaveAdjustment').on('click', function() {
            const description = $('#adjustDescription').val();
            const amount = parseFloat($('#adjustAmount').val());
            if (!description || isNaN(amount)) { alert('Reason and amount are required.'); return; }
            $.ajax({
                url: '/platform-billing/' + adjustInvoiceId + '/adjustment',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ description, amount }),
                success: function() { window.location.reload(); },
                error: function(xhr) { alert('Failed: ' + (xhr.responseJSON && xhr.responseJSON.error || 'Unknown error')); }
            });
        });

        $('#btnOpenGenerate').on('click', function() {
            $('#genModeDue').prop('checked', true);
            $('#genMonthBlock').hide();
            $('#genPeriodMonth').val('');
            $('#genLocation').val('');
            $('#generateModal').modal('show');
        });

        $('input[name="genMode"]').on('change', function() {
            $('#genMonthBlock').toggle($('#genModeMonth').is(':checked'));
        });

        $('#btnGenerate').on('click', function() {
            const payload = { locationCode: $('#genLocation').val() || null };
            if ($('#genModeMonth').is(':checked')) {
                const month = $('#genPeriodMonth').val(); // YYYY-MM
                if (!month) { alert('Please select a service month.'); return; }
                payload.periodStartDate = month + '-01';
            } else {
                payload.mode = 'DUE';
            }
            $(this).prop('disabled', true).text('Generating...');
            $.ajax({
                url: '/platform-billing/generate',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function(res) {
                    let msg = 'Generated: ' + res.generated.length;
                    if (res.generated.length) msg += '\n  ' + res.generated.join('\n  ');
                    if (res.skipped.length) {
                        msg += '\n\nSkipped: ' + res.skipped.length + '\n  ' +
                            res.skipped.map(function(s) { return s.location_code + ' — ' + s.reason; }).join('\n  ');
                    }
                    alert(msg);
                    window.location.reload();
                },
                error: function(xhr) {
                    alert('Invoice generation failed' + (xhr.responseJSON && xhr.responseJSON.error ? ': ' + xhr.responseJSON.error : '.'));
                    $('#btnGenerate').prop('disabled', false).text('Generate');
                }
            });
        });

        $('#btnOpenPayment').on('click', function() {
            $('#payLocation').val('');
            $('#payAmount').val('');
            $('#payReference').val('');
            $('#outstandingBlock').hide();
            $('#outstandingList').empty();
            $('#paymentModal').modal('show');
        });

        $('#payLocation').on('change', function() {
            const loc = $(this).val();
            if (!loc) { $('#outstandingBlock').hide(); return; }
            $.get('/platform-billing/outstanding/' + loc, function(res) {
                const list = $('#outstandingList').empty();
                if (!res.invoices.length) {
                    list.append('<div class="text-muted">No outstanding invoices.</div>');
                } else {
                    res.invoices.forEach(function(inv) {
                        list.append(
                            '<div class="form-check">' +
                            '<input class="form-check-input alloc-check" type="checkbox" value="' + inv.invoice_id + '" data-net="' + inv.net_amount + '">' +
                            '<label class="form-check-label">' + inv.invoice_number + ' — ₹' + Number(inv.net_amount).toLocaleString('en-IN') + '</label>' +
                            '</div>'
                        );
                    });
                }
                $('#outstandingBlock').show();
            });
        });

        $('#btnSavePayment').on('click', function() {
            const location_code = $('#payLocation').val();
            const amount = parseFloat($('#payAmount').val());
            if (!location_code || !amount) { alert('Location and amount are required.'); return; }

            const allocations = [];
            $('.alloc-check:checked').each(function() {
                allocations.push({ invoice_id: parseInt($(this).val(), 10), allocated_amount: parseFloat($(this).data('net')) });
            });

            $(this).prop('disabled', true).text('Saving...');
            $.ajax({
                url: '/platform-billing/payments',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    location_code: location_code,
                    payment_date: $('#payDate').val(),
                    amount: amount,
                    payment_mode: $('#payMode').val(),
                    reference_number: $('#payReference').val(),
                    allocations: allocations
                }),
                success: function() {
                    window.location.reload();
                },
                error: function(xhr) {
                    alert('Failed to save payment: ' + (xhr.responseJSON && xhr.responseJSON.error || 'Unknown error'));
                    $('#btnSavePayment').prop('disabled', false).text('Save Payment');
                }
            });
        });
