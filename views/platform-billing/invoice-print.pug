doctype html
html(lang='en')
    head
        meta(charset='UTF-8')
        title Invoice #{invoice.invoice_number}
        style.
            * { margin: 0; padding: 0; box-sizing: border-box; }
            body { font-family: Arial, sans-serif; font-size: 12px; color: #222; padding: 10px; }
            .header { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #333; padding-bottom: 12px; margin-bottom: 16px; }
            .biller-name { font-size: 20px; font-weight: bold; }
            .invoice-title { font-size: 24px; font-weight: bold; text-align: right; color: #444; }
            .invoice-meta { text-align: right; font-size: 12px; margin-top: 4px; }
            .parties { display: flex; justify-content: space-between; margin-bottom: 20px; }
            .party-block { width: 48%; }
            .party-label { font-size: 10px; text-transform: uppercase; color: #888; margin-bottom: 4px; }
            .party-name { font-weight: bold; font-size: 14px; margin-bottom: 2px; }
            table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
            th, td { border: 1px solid #ccc; padding: 8px; font-size: 12px; }
            th { background: #f5f5f5; text-align: left; }
            td.amount, th.amount { text-align: right; }
            tfoot td { font-weight: bold; background: #f9f9f9; }
            .status-badge { display: inline-block; padding: 3px 10px; border-radius: 3px; font-size: 11px; font-weight: bold; color: white; }
            .status-PAID { background: #198754; }
            .status-UNPAID { background: #dc3545; }
            .status-PARTIAL { background: #fd7e14; }
            .status-CANCELLED { background: #6c757d; }
            .footer-note { margin-top: 30px; font-size: 10px; color: #888; text-align: center; }
    body
        .header
            div
                .biller-name PetroMath
                div Platform Subscription Billing
            div
                .invoice-title INVOICE
                .invoice-meta
                    div #{invoice.invoice_number}
                    div Status:
                        span.status-badge(class=`status-${invoice.status}`)= invoice.status

        .parties
            .party-block
                .party-label Billed To
                .party-name= invoice.location_name + ' (' + invoice.location_code + ')'
                if invoice.address
                    div= invoice.address
                if invoice.gst_number
                    div GSTIN: #{invoice.gst_number}
                if invoice.phone
                    div Phone: #{invoice.phone}
            .party-block
                .party-label Invoice Details
                div: strong Period:
                    | #{new Date(invoice.period_start_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})} – #{new Date(invoice.period_end_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})}
                div: strong Generated:
                    | #{new Date(invoice.generated_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})}
                div: strong Due Date:
                    | #{new Date(invoice.due_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})}

        table
            thead
                tr
                    th Description
                    th.amount Amount (₹)
            tbody
                each it in invoice.items
                    tr
                        td= it.description
                        td.amount= Number(it.amount).toLocaleString('en-IN', {minimumFractionDigits: 2})
            tfoot
                tr
                    td Net Amount
                    td.amount ₹#{Number(invoice.net_amount).toLocaleString('en-IN', {minimumFractionDigits: 2})}

        .footer-note Generated by PetroMath on #{new Date().toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})}
