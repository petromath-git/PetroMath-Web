extends ../layout

block content
    .card.mb-3
        .card-header(style='background-color: #f8f9fa;')
            .d-flex.justify-content-between.align-items-center
                h6.mb-0
                    i.bi.bi-journal-text.me-2
                    | Distributor Ledger
                a.btn.btn-outline-secondary.btn-sm(href='/distributors')
                    i.bi.bi-arrow-left.me-1
                    | Back to Distributors
        .card-body
            .row.g-3
                .col-md-4.col-6
                    label.form-label Distributor:
                    select#filterDistributor.form-control
                        option(value='') -- Select a distributor --
                        each d in distributors
                            option(value=d.distributor_id selected=(distributorId == d.distributor_id))= d.distributor_name
                .col-md-2.d-flex.align-items-end
                    button.btn.btn-primary.w-100(type='button' onclick='applyFilter()')
                        i.bi.bi-search.me-2
                        | Go

    div.container-fluid
        if distributorId
            if ledger && ledger.length
                .table-responsive
                    table.table.table-desktop(style='width:100% !important;')
                        thead.thead-light
                            tr
                                th Date
                                th Type
                                th Reference
                                th.text-right Owed
                                th.text-right Paid Out
                                th.text-right Balance Owed
                        tbody
                            each e in ledger
                                tr
                                    td= new Date(e.entry_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'})
                                    td= e.entry_type
                                    td= e.reference
                                    td.text-right= e.entry_type === 'COMMISSION' ? '₹' + Number(e.amount).toLocaleString('en-IN', {minimumFractionDigits: 2}) : '-'
                                    td.text-right= e.entry_type === 'PAYOUT' ? '₹' + Number(e.amount).toLocaleString('en-IN', {minimumFractionDigits: 2}) : '-'
                                    td.text-right ₹#{Number(e.balance).toLocaleString('en-IN', {minimumFractionDigits: 2})}
            else
                .alert.alert-info No activity for this distributor yet.
        else
            .alert.alert-info Select a distributor to view their ledger.

    script.
        function applyFilter() {
            const id = document.getElementById('filterDistributor').value;
            window.location.href = '/distributors/ledger?distributorId=' + id;
        }
