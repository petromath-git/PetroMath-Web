extends ../layout

block content
    - const money = n => '₹' + Number(n).toLocaleString('en-IN', {minimumFractionDigits: 2, maximumFractionDigits: 2})
    style.
        .pbr-narration { max-width: 420px; word-break: break-word; font-size: 0.85rem; }
        .pbr-pay-row { display: block; padding: 4px 0; font-weight: normal; margin: 0; }
        .pbr-tick-label { font-weight: normal; margin: 0; }
        @media screen and (max-width: 767px) {
            .pbr-narration { max-width: none; }
            body.mobile-ready table.m-stack > tbody > tr > td.pbr-tick-cell { order: 1; }
            body.mobile-ready table.m-stack > tbody > tr > td.m-actions { order: 2; }
            .pbr-tick-label { display: block; padding: 4px 0; }
            .pbr-pay-row { padding: 8px 0; }
            #tagModal .form-control, #filterStatus, #filterLocation { font-size: 16px; }
        }

    .card.mb-3
        .card-header(style='background-color: #f8f9fa;')
            .d-flex.flex-wrap.justify-content-between.align-items-center
                h6.mb-0
                    i.bi.bi-bank.me-2
                    | Bank Receipts — PetroMath IOB Account
                a.btn.btn-outline-secondary.btn-sm(href='/platform-billing/payments')
                    i.bi.bi-arrow-left.me-1
                    | Back to Payments
        .card-body
            .row
                .col-md-5.mb-2
                    label.form-label Upload IOB statement (Excel):
                    .d-flex
                        input#statementFile.form-control.mr-2(type='file' accept='.xls,.xlsx')
                        button#btnUpload.btn.btn-primary(type='button') Upload
                    small.text-muted Only credits are kept. Re-uploading an overlapping statement is safe. No payment is created until a line is tagged.
                .col-md-2.col-6.mb-2
                    label.form-label Show:
                    select#filterStatus.form-control(onchange='applyFilter()')
                        each s in [['UNTAGGED', 'Untagged'], ['TAGGED', 'Tagged'], ['IGNORED', 'Ignored'], ['ALL', 'All']]
                            option(value=s[0] selected=(status === s[0]))= s[1]
                .col-md-3.col-6.mb-2
                    label.form-label Location:
                    select#filterLocation.form-control(onchange='applyFilter()')
                        option(value='') All Locations
                        each loc in locations
                            option(value=loc.location_code selected=(locationCode === loc.location_code))= loc.location_name + ' (' + loc.location_code + ')'
            .small.mt-2
                | Untagged: #[strong= summary.UNTAGGED.n] (#{money(summary.UNTAGGED.amount)})
                |  · Tagged: #[strong= summary.TAGGED.n] (#{money(summary.TAGGED.amount)})
                |  · Ignored: #[strong= summary.IGNORED.n]
                |  · Payments not yet on the statement: #[strong= unlinkedCount]

    div.container-fluid
        if rows.some(r => r.suggestion && !r.suggestion.review)
            .mb-2
                button#btnApply.btn.btn-success.btn-sm(type='button')
                    i.bi.bi-check2-all.me-1
                    | Apply ticked suggestions
        if rows.length
            .table-responsive
                table.table.m-stack(style='width:100% !important;')
                    thead.thead-light
                        tr
                            th
                            th Date
                            th Narration
                            th.text-right Amount
                            th Location
                            th
                    tbody
                        each r in rows
                            tr
                                - const canApply = r.suggestion && !r.suggestion.review
                                td.m-wide.pbr-tick-cell(class=(canApply ? '' : 'm-hide'))
                                    if canApply
                                        label.pbr-tick-label
                                            input.pbr-tick(type='checkbox' value=r.bank_txn_id checked)
                                            span.d-md-none.ml-2 Include in Apply
                                td.m-title(style='white-space:nowrap;')
                                    = r.date_label
                                    span.float-right.d-md-none= money(r.credit_amount)
                                td.pbr-narration.m-wide(data-label='Narration')= r.description
                                td.text-right.m-hide(style='white-space:nowrap;')= money(r.credit_amount)
                                td.m-wide(data-label='Location')
                                    if r.status === 'TAGGED'
                                        div= (r.location_name || r.location_code) + ' (' + r.location_code + ')'
                                        small.text-muted= (r.has_created_payment ? 'New payment ' : 'Linked to ') + (r.payment_refs || '') + (r.pays_for ? ', pays ' + r.pays_for : ', not applied to an invoice')
                                    else if r.status === 'IGNORED'
                                        span.text-muted Ignored
                                    else if r.suggestion
                                        div= r.suggestion.location_name + ' (' + r.suggestion.location_code + ')'
                                        if r.suggestion.review
                                            small.text-danger= 'Check before tagging: ' + r.suggestion.review_reason
                                        else if r.suggestion.payment_id
                                            small.text-muted= 'Link to payment ' + r.suggestion.payment_label + (r.suggestion.pays_for ? ', pays ' + r.suggestion.pays_for : '')
                                        else
                                            small.text-muted= 'New payment, pays ' + r.suggestion.pays_for
                                            if r.suggestion.advance > 0
                                                small.text-danger= ' · ' + money(r.suggestion.advance) + ' left as an advance'
                                    else
                                        span.text-muted -
                                td.m-actions(style='white-space:nowrap;')
                                    if r.status === 'UNTAGGED'
                                        button.btn.btn-outline-primary.btn-sm.mr-1.pbr-tag(
                                            type='button'
                                            data-id=r.bank_txn_id
                                            data-amount=r.credit_amount
                                            data-date=r.date_iso
                                            data-invoices=(r.suggestion ? r.suggestion.invoice_ids.join(',') : '')
                                            data-narration=r.description
                                            data-payer=r.payer_name
                                            data-location=(r.suggestion ? r.suggestion.location_code : '')
                                            data-payment=(r.suggestion ? r.suggestion.payment_id : '')) Tag
                                        button.btn.btn-outline-secondary.btn-sm.pbr-action(type='button' data-action='ignore' data-id=r.bank_txn_id title='Not a subscription receipt') Ignore
                                    else
                                        button.btn.btn-outline-secondary.btn-sm.pbr-action(type='button' data-action='undo' data-id=r.bank_txn_id
                                            data-confirm=(r.has_created_payment ? 'Undo this tag? The payment it created is removed and its invoices go back to unpaid.' : '')) Undo
        else
            .alert.alert-info No statement lines to show.

        if uploads.length
            h6.mt-4 Recent uploads
            .table-responsive
                table.table.table-sm.m-stack(style='width:100% !important;')
                    thead.thead-light
                        tr
                            th File
                            th Period
                            th.text-right New
                            th.text-right Already uploaded
                            th By
                            th
                    tbody
                        each u in uploads
                            tr
                                td.m-title= u.file_name
                                td.m-wide(data-label='Period')= u.range_label
                                td.text-right(data-label='New')= u.lines_added
                                td.text-right(data-label='Already uploaded')= u.lines_skipped
                                td.m-wide(data-label='By')= u.created_by
                                td.m-actions(class=(u.untagged_count > 0 ? '' : 'm-hide'))
                                    if u.untagged_count > 0
                                        button.btn.btn-link.btn-sm.p-0.pbr-remove-upload(type='button' data-id=u.upload_id data-count=u.untagged_count) Remove #{u.untagged_count} untagged

    #tagModal.modal.fade(tabindex='-1')
        .modal-dialog
            .modal-content
                .modal-header
                    h5.modal-title Tag receipt
                    button.close(type='button' data-dismiss='modal') &times;
                .modal-body
                    p.mb-1
                        strong#tagAmount
                    p.small.text-muted#tagNarration(style='word-break:break-word;')
                    .form-group
                        label Location that paid
                        select#tagLocation.form-control
                            option(value='') Select...
                            each loc in locations
                                option(value=loc.location_code)= loc.location_name + ' (' + loc.location_code + ')'
                    p.small.text-muted#tagTiming
                    #tagModeWrap.form-group
                        .form-check
                            input#tagModeNew.form-check-input(type='radio' name='tagMode' value='new')
                            label.form-check-label(for='tagModeNew') Create new payment
                        .form-check
                            input#tagModeLink.form-check-input(type='radio' name='tagMode' value='link')
                            label.form-check-label(for='tagModeLink') Connect to existing payment
                    #tagPaymentsWrap.form-group(style='display:none')
                        label Payment already entered:
                        #tagPayments
                        button#tagShowAll.btn.btn-link.btn-sm.p-0(type='button' style='display:none')
                    #tagInvoicesWrap.form-group(style='display:none')
                        label Pays for:
                        #tagInvoices
                    p.small#tagOutcome
                    .form-group.mb-0
                        label.mb-1(for='tagRemember') Remember this payer for this location (blank = don't):
                        input#tagRemember.form-control(type='text' maxlength='150')
                .modal-footer
                    button.btn.btn-secondary(type='button' data-dismiss='modal') Cancel
                    button#btnTagSave.btn.btn-primary(type='button') Save

    script.
        const UNLINKED_PAYMENTS = !{JSON.stringify(unlinkedPayments).replace(/</g, '\\u003c')};
        const OUTSTANDING_INVOICES = !{JSON.stringify(outstandingInvoices).replace(/</g, '\\u003c')};
        const BILLING_TIMING = !{JSON.stringify(billingTiming).replace(/</g, '\\u003c')};
        // Further apart than this, a payment is hidden until asked for. Hand-entered
        // dates are only approximate, but not by months.
        const CONNECT_WINDOW_DAYS = 45;
        let tagLineId = null;
        let tagLineAmount = 0;
        let tagLineDate = '';
        let tagShowAllPayments = false;

        function applyFilter() {
            window.location.href = '/platform-billing/bank-receipts?status=' + $('#filterStatus').val()
                + '&locationCode=' + encodeURIComponent($('#filterLocation').val());
        }

        function inr(n) {
            return '₹' + Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function postJson(url, body) {
            return $.ajax({ url: url, method: 'POST', contentType: 'application/json', data: JSON.stringify(body || {}) });
        }

        function showError(xhr) {
            alert((xhr.responseJSON && xhr.responseJSON.error) || 'Something went wrong');
        }

        function daysBetween(a, b) {
            return Math.abs(new Date(a + 'T00:00:00Z') - new Date(b + 'T00:00:00Z')) / 86400000;
        }

        function amountLeftForNewPayment() {
            let left = tagLineAmount;
            if ($('#tagModeLink').prop('checked')) {
                $('.pbr-pay:checked').each(function () {
                    left = Math.round((left - Math.min(left, Number($(this).attr('data-remaining')))) * 100) / 100;
                });
            }
            return left;
        }

        function updateOutcome() {
            const connecting = $('#tagModeLink').prop('checked');
            const left = amountLeftForNewPayment();
            const outcome = $('#tagOutcome').empty().removeClass('text-danger');
            $('#tagPaymentsWrap').toggle(connecting);
            $('#tagInvoicesWrap').toggle(left > 0 && $('.pbr-inv').length > 0);

            const text = [];
            if (connecting) {
                const ids = $('.pbr-pay:checked').map(function () { return '#' + this.value; }).get();
                if (ids.length) text.push('Connects to payment ' + ids.join(', ') + '. Its invoices stay as they are.');
            }
            if (left > 0 && (!connecting || $('.pbr-pay:checked').length)) {
                let toApply = left;
                const paid = [];
                $('.pbr-inv:checked').each(function () {
                    if (toApply <= 0) return;
                    const balance = Number($(this).attr('data-balance'));
                    const used = Math.min(toApply, balance);
                    toApply = Math.round((toApply - used) * 100) / 100;
                    paid.push($(this).attr('data-label') + ' ' + inr(used) + (used < balance ? ' (' + inr(balance - used) + ' still due)' : ''));
                });
                text.push('New payment of ' + inr(left) + (paid.length ? ' pays ' + paid.join(', ') + '.' : '.'));
                if (toApply > 0) {
                    text.push(inr(toApply) + ' is not applied to any invoice and stays as an advance. A later invoice will not pick it up by itself.');
                    outcome.addClass('text-danger');
                }
            }
            outcome.text(text.join(' '));
        }

        function renderInvoices(preselectIds) {
            const location = $('#tagLocation').val();
            const box = $('#tagInvoices').empty();
            let toCover = amountLeftForNewPayment();
            OUTSTANDING_INVOICES
                .filter(function (i) { return i.location_code === location; })
                .forEach(function (i) {
                    const afterReceipt = i.period_start > tagLineDate;
                    let tick;
                    if (preselectIds) {
                        tick = preselectIds.indexOf(i.invoice_id) !== -1;
                    } else {
                        tick = toCover > 0 && !afterReceipt;
                        if (tick) toCover -= i.balance;
                    }
                    const label = $('<label class="pbr-pay-row"></label>');
                    $('<input type="checkbox" class="pbr-inv mr-2">')
                        .val(i.invoice_id)
                        .attr('data-balance', i.balance)
                        .attr('data-label', i.period_label)
                        .prop('checked', tick)
                        .appendTo(label);
                    label.append(document.createTextNode(i.period_label + ' · ' + inr(i.balance) + ' due'
                        + (afterReceipt ? ' · starts after this receipt' : '')));
                    box.append(label);
                });
        }

        function renderPayments(preselectId) {
            const location = $('#tagLocation').val();
            const all = UNLINKED_PAYMENTS.filter(function (p) { return p.location_code === location; });
            const near = all.filter(function (p) {
                return p.payment_id === preselectId || daysBetween(p.date_iso, tagLineDate) <= CONNECT_WINDOW_DAYS;
            });
            const shown = tagShowAllPayments ? all : near;
            const box = $('#tagPayments').empty();
            shown.forEach(function (p) {
                const label = $('<label class="pbr-pay-row"></label>');
                $('<input type="checkbox" class="pbr-pay mr-2">')
                    .val(p.payment_id)
                    .attr('data-remaining', p.remaining)
                    .prop('checked', p.payment_id === preselectId)
                    .appendTo(label);
                let text = '#' + p.payment_id + ' · ' + p.date_label + ' · ' + inr(p.amount);
                if (p.remaining !== p.amount) text += ' (' + inr(p.remaining) + ' left)';
                text += ' · ' + p.mode + (p.reference ? ' · ' + p.reference : '');
                text += ' · ' + (p.pays_for ? 'paid ' + p.pays_for : 'no invoice');
                label.append(document.createTextNode(text));
                box.append(label);
            });
            if (!shown.length) box.append($('<div class="small text-muted"></div>').text('None near this date.'));
            const hidden = all.length - near.length;
            $('#tagShowAll').toggle(hidden > 0)
                .text(tagShowAllPayments ? 'Show only payments near this date' : 'Show ' + hidden + ' more, further from this date');
            $('#tagModeWrap').toggle(all.length > 0);
            if (!all.length) $('#tagModeNew').prop('checked', true);
        }

        function renderForLocation(preselectPaymentId, preselectInvoiceIds) {
            const timing = BILLING_TIMING[$('#tagLocation').val()];
            $('#tagTiming').text(timing === 'ARREARS' ? 'Billed in arrears: a receipt normally pays the month before.'
                : timing === 'ADVANCE' ? 'Billed in advance: a receipt normally pays the same month.' : '');
            renderPayments(preselectPaymentId);
            renderInvoices(preselectInvoiceIds);
            updateOutcome();
        }

        $(function () {
            $('#btnUpload').on('click', function () {
                const file = document.getElementById('statementFile').files[0];
                if (!file) { alert('Please choose the statement file.'); return; }
                const form = new FormData();
                form.append('statementFile', file);
                const btn = $(this).prop('disabled', true).text('Uploading...');
                $.ajax({ url: '/platform-billing/bank-receipts/upload', method: 'POST', data: form, processData: false, contentType: false })
                    .done(function (r) {
                        alert(r.added + ' new credit line(s) added, ' + r.skipped + ' already uploaded.');
                        window.location.href = '/platform-billing/bank-receipts';
                    })
                    .fail(function (xhr) { showError(xhr); btn.prop('disabled', false).text('Upload'); });
            });

            $('#btnApply').on('click', function () {
                const ids = $('.pbr-tick:checked').map(function () { return Number(this.value); }).get();
                if (!ids.length) { alert('No lines ticked.'); return; }
                if (!confirm('Apply the suggestion on ' + ids.length + ' line(s)?')) return;
                const btn = $(this).prop('disabled', true);
                postJson('/platform-billing/bank-receipts/apply-suggestions', { ids: ids })
                    .done(function (r) {
                        let msg = r.linked + ' linked to existing payments, ' + r.created + ' new payment(s) created.';
                        if (r.failed.length) msg += '\n\nNot applied:\n' + r.failed.join('\n');
                        alert(msg);
                        window.location.reload();
                    })
                    .fail(function (xhr) { showError(xhr); btn.prop('disabled', false); });
            });

            $('.pbr-tag').on('click', function () {
                const b = $(this);
                tagLineId = b.data('id');
                tagLineAmount = Number(b.attr('data-amount'));
                tagLineDate = b.attr('data-date');
                tagShowAllPayments = false;
                $('#tagAmount').text(inr(tagLineAmount));
                $('#tagNarration').text(b.attr('data-narration') || '');
                $('#tagLocation').val(b.attr('data-location') || '');
                $('#tagRemember').val(b.attr('data-payer') || '');
                const paymentId = Number(b.attr('data-payment')) || null;
                $(paymentId ? '#tagModeLink' : '#tagModeNew').prop('checked', true);
                const invoiceIds = (b.attr('data-invoices') || '').split(',').filter(Boolean).map(Number);
                renderForLocation(paymentId, invoiceIds.length ? invoiceIds : null);
                $('#tagModal').modal('show');
            });

            $('#tagLocation').on('change', function () { renderForLocation(null, null); });
            $('input[name=tagMode]').on('change', function () { renderInvoices(null); updateOutcome(); });
            $('#tagPayments').on('change', '.pbr-pay', function () { renderInvoices(null); updateOutcome(); });
            $('#tagInvoices').on('change', '.pbr-inv', updateOutcome);
            $('#tagShowAll').on('click', function () {
                const ticked = $('.pbr-pay:checked').map(function () { return Number(this.value); }).get();
                tagShowAllPayments = !tagShowAllPayments;
                renderPayments(null);
                $('.pbr-pay').each(function () { $(this).prop('checked', ticked.indexOf(Number(this.value)) !== -1); });
                renderInvoices(null);
                updateOutcome();
            });

            $('#btnTagSave').on('click', function () {
                const locationCode = $('#tagLocation').val();
                if (!locationCode) { alert('Please choose the location that paid.'); return; }
                const connecting = $('#tagModeLink').prop('checked');
                const paymentIds = connecting ? $('.pbr-pay:checked').map(function () { return Number(this.value); }).get() : [];
                if (connecting && !paymentIds.length) { alert('Tick the payment to connect to, or choose Create new payment.'); return; }
                const invoiceIds = amountLeftForNewPayment() > 0 ? $('.pbr-inv:checked').map(function () { return Number(this.value); }).get() : [];
                const btn = $(this).prop('disabled', true);
                postJson('/platform-billing/bank-receipts/' + tagLineId + '/tag', {
                    locationCode: locationCode,
                    paymentIds: paymentIds,
                    invoiceIds: invoiceIds,
                    rememberText: $('#tagRemember').val()
                })
                    .done(function () { window.location.reload(); })
                    .fail(function (xhr) { showError(xhr); btn.prop('disabled', false); });
            });

            $('.pbr-action').on('click', function () {
                const b = $(this);
                const message = b.attr('data-confirm');
                if (message && !confirm(message)) return;
                postJson('/platform-billing/bank-receipts/' + b.data('id') + '/' + b.data('action'))
                    .done(function () { window.location.reload(); })
                    .fail(showError);
            });

            $('.pbr-remove-upload').on('click', function () {
                const b = $(this);
                if (!confirm('Remove the ' + b.data('count') + ' untagged line(s) from this upload? Tagged lines stay.')) return;
                postJson('/platform-billing/bank-receipts/uploads/' + b.data('id') + '/remove')
                    .done(function () { window.location.reload(); })
                    .fail(showError);
            });
        });
