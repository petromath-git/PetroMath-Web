extends ../layout
include ../mixins/card-toggle-mobile

//- Administration > IOCL Mail Import (tkt #484, menu OIL_INVOICE_MAILBOXES, SuperUser): the Gmail
//- mailboxes IOCL's invoice mails are forwarded to, their Google script, and every PDF read.
//- Bunk users see only their own PDFs on IOCL Invoices > Email Import.

block content
    style.
        .num { text-align: right; white-space: nowrap; }

    div#messageAlert.alert.alert-dismissible.fade(role="alert" style="display: none;")
        span#messageText
        button.close(type="button" data-dismiss="alert" aria-label="Close")
            span(aria-hidden="true") &times;

    .container-fluid.py-3
        .mb-2
            h4.mb-0.text-primary IOCL Mail Import
            small.text-muted Gmail mailboxes that IOCL's invoice mails (from B2BPRD@indianoil.in) are forwarded to
        p.small.text-muted.mb-2
            | A small Google script in each Gmail sends the PDFs to PetroMath every hour — no Gmail password is given to PetroMath.
            |  Charge invoices (LFR, E-Lock, XtraPower, merchant consent …) are saved at the bunk whose GSTIN is on the invoice; other PDFs are only logged. Sent mails get the Gmail label <b>PetroMath-Read</b>; nothing is deleted.
            |  Each bunk sees its own PDFs in IOCL Invoices &gt; Email Import.
        .card.mb-3
            .card-body.py-2
                .d-flex.align-items-center.mb-2
                    .font-weight-bold.mr-auto
                        i.bi.bi-envelope-at.mr-1
                        | Mailboxes
                    if tickable.length
                        button.btn.btn-outline-primary.btn-sm#addMailboxBtn(type="button")
                            i.bi.bi-plus-lg.mr-1
                            | Add mailbox
                if !mailboxes.length
                    .small.text-muted No mailbox is set up yet.
                each m in mailboxes
                    .border.rounded.p-2.mb-2
                        .d-flex.flex-wrap.align-items-center
                            strong.mr-2= m.email_address
                            if m.active_flag !== 'Y'
                                span.badge.badge-secondary.mr-2 Off
                            else if m.last_status === 'LOGIN_FAILED'
                                span.badge.badge-danger.mr-2 Login failed
                            else if m.last_status === 'ERROR'
                                span.badge.badge-warning.mr-2 Last check failed
                            else if m.last_status === 'OK'
                                span.badge.badge-success.mr-2 OK
                            span.small.text-muted.mr-auto #{m.access_mode === 'SCRIPT' ? 'Google script' : 'App Password'} · bunks: #{m.locations.join(', ')} · last #{m.lookback_days} days
                            if m.access_mode === 'SCRIPT'
                                if m.canManage
                                    button.btn.btn-outline-primary.btn-sm.mr-1.mb-1.new-script-btn(type="button" data-id=m.mailbox_id data-email=m.email_address title="Make the script again (the old one stops working)")
                                        i.bi.bi-code-slash.mr-1
                                        | Script
                            else
                                button.btn.btn-primary.btn-sm.mr-1.mb-1.run-mailbox-btn(type="button" data-id=m.mailbox_id)
                                    i.bi.bi-arrow-repeat.mr-1
                                    | Check now
                            if m.canManage
                                button.btn.btn-outline-secondary.btn-sm.mr-1.mb-1.edit-mailbox-btn(type="button" data-id=m.mailbox_id data-email=m.email_address data-mode=m.access_mode
                                    data-locations=m.locations.join(',') data-lookback=m.lookback_days data-active=m.active_flag)
                                    i.bi.bi-pencil
                                button.btn.btn-outline-danger.btn-sm.mb-1.delete-mailbox-btn(type="button" data-id=m.mailbox_id data-email=m.email_address)
                                    i.bi.bi-trash
                        if m.last_run_at
                            .small(class=(m.last_status === 'OK' ? 'text-muted' : 'text-danger')) #{fmtDateTime(m.last_run_at)}: #{m.last_message}

        form.d-flex.flex-wrap.align-items-center.mb-1(method="get" action="/oil-invoices/mailboxes")
            .font-weight-bold.mr-auto PDFs read from email
            select.form-control.form-control-sm.mr-2.mb-1(name="mailbox" style="max-width:260px" onchange="this.form.submit()")
                option(value="") All mailboxes
                each m in mailboxes
                    option(value=m.mailbox_id selected=(mailboxId === m.mailbox_id))= m.email_address
            .custom-control.custom-checkbox.mb-1
                input.custom-control-input#otherChk(type="checkbox" name="other" value="1" checked=showOther onchange="this.form.submit()")
                label.custom-control-label.small(for="otherChk") Show other PDFs too (fuel invoices, receipts …)
        if !log.length
            .small.text-muted Nothing read yet.
        else
            table.table.table-sm.table-hover.m-stack.m-collapse
                thead.thead-light
                    tr
                        th Read on
                        th Bunk
                        th Mail
                        th PDF
                        th Result
                tbody
                    each g in log
                        tr(class=(g.status === 'BLOCKED' || g.status === 'ERROR' ? 'table-warning' : (g.status === 'NOT_INVOICE' ? 'text-muted' : '')))
                            td.m-title.text-nowrap #{fmtDateTime(g.creation_date)}#{(g.created_by === 'AUTO' || g.created_by === 'SCRIPT') ? '' : ' · ' + g.created_by}
                            td(data-label="Bunk")= g.location_code || '—'
                            td.small(data-label="Mail")
                                div= g.subject
                                .text-muted #{fmtDateTime(g.mail_date)} · #{g.email_address}
                            td.small(data-label="PDF")= g.file_name
                            td.small.m-summary(data-label="Result")
                                if g.status === 'IMPORTED'
                                    span.badge.badge-success.mr-1 Imported
                                else if g.status === 'EXISTS'
                                    span.badge.badge-secondary.mr-1 Already in
                                else if g.status === 'BLOCKED'
                                    span.badge.badge-danger.mr-1 Not saved
                                else if g.status === 'ERROR'
                                    span.badge.badge-danger.mr-1 Not read
                                else
                                    span.badge.badge-light.border.mr-1 Other PDF
                                if g.invoice_no
                                    span.mr-1= g.invoice_no
                                if g.status !== 'IMPORTED' && g.status !== 'EXISTS'
                                    div= g.detail
            p.small.text-muted A PDF marked "Not saved" or "Not read": once the problem is fixed, take the PetroMath-Read label off its mail and it is tried again, or upload it at the bunk (IOCL Invoices &gt; Invoices). "—" under Bunk: no bunk's GSTIN was found on the PDF.

        //- Add / edit a mailbox
        .modal.fade#mailboxModal(tabindex="-1")
            .modal-dialog
                .modal-content
                    .modal-header
                        h5.modal-title#mailboxTitle Add mailbox
                        button.close(type="button" data-dismiss="modal") &times;
                    .modal-body
                        .form-group
                            label.small.mb-1 Gmail address
                            input.form-control.form-control-sm#mbEmail(type="email" autocomplete="off" placeholder="name@gmail.com")
                        .form-group#mbModeGroup
                            label.small.mb-1 How PetroMath gets the mails
                            select.form-control.form-control-sm#mbMode
                                option(value="SCRIPT") Google script in the Gmail (no password — recommended)
                                if keyConfigured
                                    option(value="IMAP") App Password (PetroMath logs in to Gmail)
                        .form-group#mbPasswordGroup
                            label.small.mb-1#mbPasswordLabel App Password
                            input.form-control.form-control-sm#mbPassword(type="password" autocomplete="new-password" placeholder="16 letters")
                            small.form-text.text-muted
                                | Not the Gmail password. In that Google account: turn on 2-Step Verification, then Security &gt; App passwords &gt; create one named "PetroMath". It is stored encrypted and never shown again.
                        .form-group
                            label.small.mb-1 Bunks this mailbox gets invoices for
                            .d-flex.flex-wrap
                                each l in tickable
                                    .custom-control.custom-checkbox.mr-3
                                        input.custom-control-input.mb-loc(type="checkbox" id=`mbLoc_${l}` value=l)
                                        label.custom-control-label(for=`mbLoc_${l}`)= l
                        .form-row
                            .form-group.col-6
                                label.small.mb-1 Read mails of the last (days)
                                input.form-control.form-control-sm#mbLookback(type="number" min="1" max="365" value="30")
                            .form-group.col-6#mbActiveGroup
                                label.small.mb-1 Status
                                select.form-control.form-control-sm#mbActive
                                    option(value="Y") On
                                    option(value="N") Off
                    .modal-footer
                        button.btn.btn-secondary.btn-sm(type="button" data-dismiss="modal") Cancel
                        button.btn.btn-primary.btn-sm#mbSaveBtn(type="button") Save

        //- The Google script to paste
        .modal.fade#scriptModal(tabindex="-1" data-backdrop="static")
            .modal-dialog.modal-lg
                .modal-content
                    .modal-header
                        h5.modal-title Google script for
                            span#scriptEmail
                        button.close(type="button" data-dismiss="modal") &times;
                    .modal-body
                        ol.small.pl-3.mb-2
                            li
                                | On the computer, sign in to Gmail as
                                b#scriptEmail2
                                | , then open
                                a(href="https://script.google.com/home/projects/create" target="_blank" rel="noopener") script.google.com → New project
                                | .
                            li Delete what is in the editor, click <b>Copy script</b> below and paste it there. Name the project "PetroMath" and press Save (the disk icon).
                            li In the toolbar, choose <b>setup</b> in the function list and press <b>Run</b>.
                            li Google asks for permission: <b>Review permissions</b> → choose the account → <b>Advanced</b> → <b>Go to PetroMath (unsafe)</b> → <b>Allow</b>. ("Unsafe" only means Google has not reviewed your own script.)
                            li Done. It sends the PDFs now and every hour after. Come back here and refresh: the mails appear below.
                        .alert.alert-warning.small.py-1 This is shown only now. It contains the mailbox's key — don't share it. If it is lost, press "Script" again for a new one (the old one then stops working).
                        textarea.form-control.text-monospace#scriptText(rows="10" readonly style="font-size:11px")
                    .modal-footer
                        button.btn.btn-primary.btn-sm#copyScriptBtn(type="button")
                            i.bi.bi-clipboard.mr-1
                            | Copy script
                        button.btn.btn-secondary.btn-sm#scriptDoneBtn(type="button") Done

    +cardToggleMobile('table.m-collapse > tbody > tr:not(.m-static)')

    script.
        (function () {
        function showMessage(text, ok) {
            var el = document.getElementById('messageAlert');
            el.className = 'alert alert-dismissible fade show ' + (ok ? 'alert-success' : 'alert-danger');
            document.getElementById('messageText').textContent = text;
            el.style.display = 'block';
            window.scrollTo(0, 0);
        }
        async function call(method, url, body, isForm) {
            var r = await fetch(url, isForm ? { method: method, body: body } : {
                method: method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined
            });
            var data = {};
            try { data = await r.json(); } catch (e) { /* non-JSON error page */ }
            if (!r.ok || !data.success) throw new Error(data.error || ('Request failed (' + r.status + ')'));
            return data;
        }
        function fmt(n) { return Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function esc(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        // ── Email import: mailboxes ──
        var editMailboxId = null;
        function showPasswordField() {
            var mode = document.getElementById('mbMode');
            if (mode) document.getElementById('mbPasswordGroup').style.display = mode.value === 'IMAP' ? '' : 'none';
        }
        var mbMode = document.getElementById('mbMode');
        if (mbMode) mbMode.addEventListener('change', showPasswordField);
        function showScript(email, script) {
            document.getElementById('scriptEmail').textContent = email;
            document.getElementById('scriptEmail2').textContent = email;
            document.getElementById('scriptText').value = script;
            $('#scriptModal').modal('show');
        }
        var copyScriptBtn = document.getElementById('copyScriptBtn');
        if (copyScriptBtn) copyScriptBtn.addEventListener('click', async function () {
            var t = document.getElementById('scriptText');
            try { await navigator.clipboard.writeText(t.value); } catch (e) { t.select(); document.execCommand('copy'); }
            copyScriptBtn.innerHTML = '<i class="bi bi-check2 mr-1"></i>Copied';
        });
        var scriptDoneBtn = document.getElementById('scriptDoneBtn');
        if (scriptDoneBtn) scriptDoneBtn.addEventListener('click', function () { window.location.reload(); });
        $('#scriptModal').on('hidden.bs.modal', function () { window.location.reload(); });
        document.querySelectorAll('.new-script-btn').forEach(function (b) {
            b.addEventListener('click', async function () {
                if (!confirm('Make a new script for ' + b.dataset.email + '? The script now in that Gmail stops working until you paste the new one.')) return;
                try {
                    var d = await call('POST', '/oil-invoices/api/mailboxes/' + b.dataset.id + '/script');
                    showScript(d.email, d.script);
                } catch (e) { showMessage(e.message, false); }
            });
        });
        function openMailbox(btn) {
            editMailboxId = btn ? btn.dataset.id : null;
            var locs = btn ? btn.dataset.locations.split(',') : [!{JSON.stringify(String(user.location_code)).replace(/</g, '\\u003c')}];
            document.getElementById('mailboxTitle').textContent = btn ? 'Edit ' + btn.dataset.email : 'Add mailbox';
            var email = document.getElementById('mbEmail');
            email.value = btn ? btn.dataset.email : '';
            email.disabled = !!btn;
            document.getElementById('mbPassword').value = '';
            document.getElementById('mbPasswordLabel').textContent = btn ? 'New App Password (leave blank to keep the saved one)' : 'App Password';
            document.getElementById('mbMode').value = btn ? btn.dataset.mode : 'SCRIPT';
            document.getElementById('mbModeGroup').style.display = btn ? 'none' : '';
            showPasswordField();
            document.querySelectorAll('.mb-loc').forEach(function (c) { c.checked = locs.indexOf(c.value) >= 0; });
            document.getElementById('mbLookback').value = btn ? btn.dataset.lookback : 30;
            document.getElementById('mbActive').value = btn ? btn.dataset.active : 'Y';
            document.getElementById('mbActiveGroup').style.display = btn ? '' : 'none';
            $('#mailboxModal').modal('show');
        }
        var addMailboxBtn = document.getElementById('addMailboxBtn');
        if (addMailboxBtn) addMailboxBtn.addEventListener('click', function () { openMailbox(null); });
        document.querySelectorAll('.edit-mailbox-btn').forEach(function (b) { b.addEventListener('click', function () { openMailbox(b); }); });
        var mbSaveBtn = document.getElementById('mbSaveBtn');
        if (mbSaveBtn) mbSaveBtn.addEventListener('click', async function () {
            var body = {
                email: document.getElementById('mbEmail').value,
                mode: document.getElementById('mbMode').value,
                password: document.getElementById('mbPassword').value,
                locations: Array.prototype.filter.call(document.querySelectorAll('.mb-loc'), function (c) { return c.checked; }).map(function (c) { return c.value; }),
                lookback_days: document.getElementById('mbLookback').value,
                active: document.getElementById('mbActive').value
            };
            mbSaveBtn.disabled = true;
            mbSaveBtn.textContent = body.mode === 'IMAP' && body.password ? 'Checking login…' : 'Saving…';
            try {
                var d = await call('POST', '/oil-invoices/api/mailboxes' + (editMailboxId ? '/' + editMailboxId : ''), body);
                if (d.script) {
                    $('#mailboxModal').modal('hide');
                    showScript(d.email, d.script);
                    return;
                }
                sessionStorage.setItem('oilMailMessage', 'Mailbox saved.');
                window.location.reload();
            } catch (e) {
                $('#mailboxModal').modal('hide');
                showMessage(e.message, false);
            } finally { mbSaveBtn.disabled = false; mbSaveBtn.textContent = 'Save'; }
        });
        document.querySelectorAll('.delete-mailbox-btn').forEach(function (b) {
            b.addEventListener('click', async function () {
                if (!confirm('Stop reading ' + b.dataset.email + '? Its saved password and read log are removed; invoices already imported stay.')) return;
                try {
                    await call('POST', '/oil-invoices/api/mailboxes/' + b.dataset.id + '/delete');
                    sessionStorage.setItem('oilMailMessage', b.dataset.email + ' removed.');
                    window.location.reload();
                } catch (e) { showMessage(e.message, false); }
            });
        });
        document.querySelectorAll('.run-mailbox-btn').forEach(function (b) {
            b.addEventListener('click', async function () {
                b.disabled = true;
                var label = b.innerHTML;
                b.innerHTML = '<span class="spinner-border spinner-border-sm mr-1"></span>Reading…';
                try {
                    var d = await call('POST', '/oil-invoices/api/mailboxes/' + b.dataset.id + '/run');
                    sessionStorage.setItem('oilMailMessage', d.message);
                    window.location.reload();
                } catch (e) { showMessage(e.message, false); b.disabled = false; b.innerHTML = label; }
            });
        });
        })();
