extends layout
include mixins/mixins

block content
    .container-fluid.pt-3

        .d-flex.justify-content-between.align-items-center.mb-3
            h4.mb-0 Accounting Setup Check
            a.btn.btn-sm.btn-outline-secondary(href="/gl/control") GL Control &rarr;

        if allPass
            .alert.alert-success.py-2
                i.bi.bi-check-circle-fill.mr-1
                | All setup checks passed for #{user.location_code}. GL accounting is ready to use.
        else
            .alert.alert-warning.py-2
                i.bi.bi-exclamation-triangle-fill.mr-1
                | #{checks.filter(c => !c.pass).length} of #{checks.length} check(s) need attention for #{user.location_code} before accounting can be relied on.

        each c, idx in checks
            - var hasDetail = (c.items && c.items.some(function(i){ return i.rows.length > 0; })) || (c.rows && c.rows.length > 0);
            .card.mb-3(class=c.pass ? "border-success" : "border-danger")
                .card-header.py-2.d-flex.justify-content-between.align-items-center.bg-light(class=hasDetail ? "cursor-pointer" : "" data-toggle=hasDetail ? "collapse" : undefined data-target=hasDetail ? "#detail-" + idx : undefined style=hasDetail ? "cursor:pointer" : "")
                    span
                        i.bi.mr-2(class=c.pass ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger")
                        strong= c.label
                    span.d-flex.align-items-center
                        span.small.mr-2(class=c.pass ? "text-muted" : "text-danger")= c.detail
                        span.badge.mr-2(class=c.pass ? "badge-success" : "badge-danger")= c.pass ? "PASS" : "ATTENTION"
                        if hasDetail
                            i.bi.bi-chevron-down.small.text-muted

                if hasDetail
                    div.collapse(id="detail-" + idx)
                        .card-body.py-2

                            //- Product Ledger Mapping — grouped breakdown by map type
                            if c.items
                                - var failingItems = c.items.filter(function(i){ return i.rows.length > 0; })
                                .table-responsive
                                    table.table.table-sm.table-bordered.mb-0
                                        thead.thead-light
                                            tr
                                                th Ledger Type
                                                th(style="width:100px") Missing
                                                th Products
                                        tbody
                                            each i in failingItems
                                                tr
                                                    td.small= i.label
                                                    td.small.text-center= i.rows.length
                                                    td.small= i.rows.map(function(r){ return r.product_name; }).join(', ')

                            //- Flat list checks (static map / credit / supplier / bank)
                            if c.rows && c.rows.length
                                .table-responsive
                                    table.table.table-sm.table-bordered.mb-0
                                        thead.thead-light
                                            tr
                                                th Name
                                        tbody
                                            each r in c.rows
                                                tr
                                                    td.small= r.name

    script.
        document.querySelectorAll('[data-toggle="collapse"]').forEach(function(header) {
            var targetSel = header.getAttribute('data-target');
            var target = document.querySelector(targetSel);
            var chevron = header.querySelector('.bi-chevron-down, .bi-chevron-up');
            if (!target) return;
            $(target).on('show.bs.collapse', function() { if (chevron) chevron.className = chevron.className.replace('bi-chevron-down', 'bi-chevron-up'); });
            $(target).on('hide.bs.collapse', function() { if (chevron) chevron.className = chevron.className.replace('bi-chevron-up', 'bi-chevron-down'); });
        });
