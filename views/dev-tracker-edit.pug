extends layout

block content
    include mixins/dev-tracker-style
    - var typeLabel = { Bug: 'Issue', Feature: 'Feature request', Enhancement: 'Enhancement', Task: 'Task' }
    - var dueDateValue = tracker.due_date ? String(tracker.due_date).slice(0, 10) : ''
    .container-fluid.ticket-page
        .d-flex.align-items-center.mb-3
            a.btn.btn-outline-secondary.mr-3(href=`/dev-tracker/${tracker.tracker_id}`)
                i.bi.bi-arrow-left
            h2.mb-0 Edit Ticket ##{tracker.tracker_id}

        .row.justify-content-center
            .col-12.col-lg-8
                form.card.card-body(method="POST" action=`/dev-tracker/${tracker.tracker_id}?_method=PUT`)
                    .row.g-3
                        .col-12
                            label Title *
                            input.form-control(type="text" name="title" required maxlength="255" value=tracker.title)

                        .col-6.col-md-3
                            label Status
                            select.form-control(name="status")
                                each st in statuses
                                    option(value=st selected=(tracker.status === st))= st
                        .col-6.col-md-3
                            label Priority
                            select.form-control(name="priority")
                                each p in priorities
                                    option(value=p selected=(tracker.priority === p))= p
                        .col-6.col-md-3
                            label Type
                            select.form-control(name="type")
                                each t in types
                                    option(value=t selected=(tracker.type === t))= typeLabel[t]
                        .col-6.col-md-3
                            label Station
                            select.form-control(name="location_code")
                                option(value="" selected=!tracker.location_code) Platform
                                each loc in locations
                                    option(value=loc.location_code selected=(tracker.location_code === loc.location_code))= loc.location_code
                        .col-12.col-md-6
                            label Scope
                            select.form-control(name="scope")
                                option(value="LOCATION" selected=(tracker.scope === 'LOCATION')) Station request
                                option(value="ALL" selected=(tracker.scope === 'ALL')) All locations
                            .form-text.text-muted The requesting station keeps seeing it when moved to "All locations"
                        .col-12.col-md-6
                            label Assigned To
                            input.form-control(type="text" name="assigned_to" maxlength="100" value=tracker.assigned_to)

                        .col-12
                            label Details
                            textarea.form-control(name="description" rows="6")= tracker.description

                        .col-6.col-md-4
                            label Due Date
                            input.form-control(type="date" name="due_date" value=dueDateValue)
                        .col-6.col-md-4
                            label Estimated Hours
                            input.form-control(type="number" name="estimated_hours" step="0.5" min="0" value=tracker.estimated_hours)
                        .col-12.col-md-4
                            label Tags
                            input.form-control(type="text" name="tags" maxlength="255" value=tracker.tags)
                        .col-12
                            .form-text.text-muted Hours spent come from the Work Log on the ticket page.

                    .d-flex.gap-2.mt-4
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-check-circle.mr-1
                            | Save
                        a.btn.btn-outline-secondary(href=`/dev-tracker/${tracker.tracker_id}`) Cancel
