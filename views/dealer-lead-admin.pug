extends layout

block content
    .container-fluid.mt-3
        .row
            .col-12
                .card
                    .card-header.d-flex.justify-content-between.align-items-center
                        h4.mb-0 Dealer Convention Leads (#{leads.length})
                        a.btn.btn-primary(href='/dealer-leads/admin/export')
                            i.fas.fa-download
                            |  Export CSV

                    .card-body
                        .table-responsive
                            table.table.table-striped.table-bordered.table-hover.table-sm
                                thead.thead-dark
                                    tr
                                        th #
                                        th Bunk Name
                                        th Place
                                        th District
                                        th Phone
                                        th Oil Company
                                        th Contact
                                        th Role
                                        th Lead Mode
                                        th Event
                                        th Generated By
                                        th Notes
                                        th Needs Verification
                                        th Collected On
                                tbody
                                    if leads.length === 0
                                        tr
                                            td.text-center.text-muted(colspan='14') No leads collected yet.
                                    each lead, i in leads
                                        tr
                                            td.text-nowrap
                                                | #{i + 1}
                                                if lead.is_priority === 'Y'
                                                    span.text-warning.ml-1(title='Priority') ★
                                            td= lead.bunk_name
                                            td= lead.place
                                            td= lead.district
                                            td.text-nowrap= lead.phone_number
                                            td= lead.oil_company
                                            td= lead.contact_person_name || '-'
                                            td= lead.contact_role
                                            td= lead.lead_mode
                                            td= lead.event_name || '-'
                                            td= lead.generated_by || '-'
                                            td= lead.notes || '-'
                                            td(class=lead.needs_verification ? 'text-danger' : '')= lead.needs_verification || '-'
                                            td.text-nowrap= moment(lead.creation_date).format('DD-MMM-YYYY HH:mm')
