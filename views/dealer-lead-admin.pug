extends layout

block content
    style.
        .lead-tile { display: block; border-radius: 8px; padding: 10px 12px; color: #fff; text-decoration: none; }
        .lead-tile:hover { color: #fff; text-decoration: none; opacity: .9; }
        .lead-tile .num { font-size: 1.5rem; font-weight: 600; line-height: 1.1; }
        .lead-tile .lbl { font-size: .8rem; opacity: .9; }
        .lead-tile.active { box-shadow: 0 0 0 3px rgba(0,0,0,.35); }
        .lead-table td { vertical-align: middle; }
        .lead-table tr.overdue td:first-child { border-left: 4px solid #dc3545; }
        .lead-table tr.due-today td:first-child { border-left: 4px solid #fd7e14; }
        .lead-table tr.closed { opacity: .6; }

    - var statusOf = {}
    each s in statuses
        - statusOf[s.code] = s
    - var tileLink = function (params) { var q = new URLSearchParams(params).toString(); return '/dealer-leads/admin' + (q ? '?' + q : ''); }
    - var isTile = function (key, value) { return filters[key] === value && Object.keys(filters).length === 1; }

    .container-fluid.mt-3
        //- ── Summary tiles ──
        .row.mb-2
            .col-6.col-md-2.mb-2
                a.lead-tile.bg-danger(href=tileLink({ due: 'overdue' }) class=isTile('due', 'overdue') ? 'active' : '')
                    .num= summary.overdue || 0
                    .lbl Overdue
            .col-6.col-md-2.mb-2
                a.lead-tile(style='background:#fd7e14' href=tileLink({ due: 'today' }) class=isTile('due', 'today') ? 'active' : '')
                    .num= summary.due_today || 0
                    .lbl Due today
            .col-6.col-md-2.mb-2
                a.lead-tile.bg-secondary(href=tileLink({ status: 'NEW' }) class=isTile('status', 'NEW') ? 'active' : '')
                    .num= summary.new_count || 0
                    .lbl New
            .col-6.col-md-2.mb-2
                a.lead-tile.bg-primary(href=tileLink({ status: 'INTERESTED' }) class=isTile('status', 'INTERESTED') ? 'active' : '')
                    .num= summary.interested || 0
                    .lbl Interested
            .col-6.col-md-2.mb-2
                a.lead-tile.bg-info(href=tileLink({ status: 'DEMO' }) class=isTile('status', 'DEMO') ? 'active' : '')
                    .num= summary.demo || 0
                    .lbl Demo / Onboarding
            .col-6.col-md-2.mb-2
                a.lead-tile.bg-success(href=tileLink({ status: 'WON' }) class=isTile('status', 'WON') ? 'active' : '')
                    .num= summary.won || 0
                    .lbl Won
        .small.text-muted.mb-3
            | #{summary.total || 0} leads in total · #{summary.contacted || 0} contacted · #{summary.lost || 0} not interested / invalid

        .card
            .card-header.d-flex.justify-content-between.align-items-center.flex-wrap
                h5.mb-0 Dealer Leads (#{leads.length})
                div
                    a.btn.btn-sm.btn-outline-primary.mr-2(href=tileLink({ owner: 'me', status: 'OPEN' }))
                        i.bi.bi-person-check
                        |  My open leads
                    a.btn.btn-sm.btn-primary(href='/dealer-leads/admin/export' + (queryString ? '?' + queryString : ''))
                        i.bi.bi-download
                        |  Export CSV

            .card-body
                //- ── Filters ──
                form.mb-3(method='GET' action='/dealer-leads/admin')
                    .form-row
                        .col-12.col-md-3.mb-2
                            input.form-control.form-control-sm(type='search' name='q' value=filters.q || '' placeholder='Search name, phone, bunk, place, notes')
                        .col-6.col-md-2.mb-2
                            select.form-control.form-control-sm(name='status')
                                option(value='') All statuses
                                option(value='OPEN' selected=filters.status === 'OPEN') Open (not closed)
                                option(value='CLOSED' selected=filters.status === 'CLOSED') Closed
                                each s in statuses
                                    option(value=s.code selected=filters.status === s.code)= s.label
                        .col-6.col-md-2.mb-2
                            select.form-control.form-control-sm(name='due')
                                option(value='') Any follow-up date
                                option(value='overdue' selected=filters.due === 'overdue') Overdue
                                option(value='today' selected=filters.due === 'today') Due today
                                option(value='week' selected=filters.due === 'week') Next 7 days
                                option(value='none' selected=filters.due === 'none') No date set
                        .col-6.col-md-2.mb-2
                            select.form-control.form-control-sm(name='owner')
                                option(value='') Any owner
                                option(value='me' selected=filters.owner === 'me') Me
                                option(value='none' selected=filters.owner === 'none') Unassigned
                                each a in assignees
                                    option(value=a.Person_id selected=filters.owner === String(a.Person_id))= a.Person_Name
                        .col-6.col-md-3.mb-2
                            select.form-control.form-control-sm(name='event')
                                option(value='') All events
                                each e in options.events
                                    option(value=e selected=filters.event === e)= e
                        .col-6.col-md-3.mb-2
                            select.form-control.form-control-sm(name='district')
                                option(value='') All districts
                                each d in options.districts
                                    option(value=d selected=filters.district === d)= d
                        .col-6.col-md-2.mb-2
                            select.form-control.form-control-sm(name='oil_company')
                                option(value='') All oil companies
                                each o in options.oilCompanies
                                    option(value=o selected=filters.oil_company === o)= o
                        .col-6.col-md-2.mb-2
                            .custom-control.custom-checkbox.mt-1
                                input#fPriority.custom-control-input(type='checkbox' name='priority' value='Y' checked=filters.priority === 'Y')
                                label.custom-control-label(for='fPriority') ★ Priority only
                        .col-6.col-md-3.mb-2
                            button.btn.btn-sm.btn-info.mr-2(type='submit')
                                i.bi.bi-funnel
                                |  Filter
                            a.btn.btn-sm.btn-secondary(href='/dealer-leads/admin') Reset

                //- ── Lead list ──
                .table-responsive
                    table.table.table-sm.table-bordered.table-hover.lead-table.mb-0
                        thead.thead-dark
                            tr
                                th Lead
                                th Phone
                                th Place
                                th OMC
                                th Status
                                th Owner
                                th Next follow-up
                                th Last contact
                                th Notes
                        tbody
                            if leads.length === 0
                                tr
                                    td.text-center.text-muted(colspan='9') No leads match these filters.
                            each lead in leads
                                - var st = statusOf[lead.status] || { label: lead.status, badge: 'light' }
                                tr(class=lead.is_overdue ? 'overdue' : (lead.is_due_today ? 'due-today' : (!lead.is_open ? 'closed' : '')))
                                    td
                                        a(href='/dealer-leads/admin/' + lead.lead_id + (queryString ? '?back=' + encodeURIComponent(queryString) : ''))
                                            if lead.is_priority === 'Y'
                                                span.text-warning(title='Priority') ★
                                            strong= lead.contact_person_name || lead.bunk_name
                                        if lead.contact_person_name && lead.bunk_name !== 'Not noted'
                                            .small.text-muted= lead.bunk_name
                                        if lead.needs_verification
                                            .small.text-danger(title=lead.needs_verification)
                                                i.bi.bi-exclamation-triangle
                                                |  verify
                                    td.text-nowrap
                                        if lead.phone_number
                                            a(href='tel:' + lead.phone_number)= lead.phone_number
                                            if lead.wa_number
                                                a.ml-2.text-success(href='https://wa.me/' + lead.wa_number target='_blank' rel='noopener' title='WhatsApp')
                                                    i.bi.bi-whatsapp
                                        else
                                            span.text-muted -
                                    td
                                        = lead.place
                                        if lead.district && lead.district !== lead.place && lead.district !== 'Not noted'
                                            .small.text-muted= lead.district
                                    td= lead.oil_company
                                    td
                                        span.badge(class='badge-' + st.badge)= st.label
                                    td= lead.assigned_to_name || '-'
                                    td.text-nowrap
                                        if lead.is_open && lead.next_followup_date
                                            span(class=lead.is_overdue ? 'text-danger font-weight-bold' : (lead.is_due_today ? 'font-weight-bold' : ''))
                                                = moment(lead.next_followup_date).format('DD-MMM-YYYY')
                                        else
                                            span.text-muted -
                                    td.text-nowrap
                                        if lead.last_contacted_at
                                            = moment(lead.last_contacted_at).format('DD-MMM-YYYY')
                                            .small.text-muted #{lead.activity_count} logged
                                        else
                                            span.text-muted Not yet
                                    td.small= lead.notes || ''
