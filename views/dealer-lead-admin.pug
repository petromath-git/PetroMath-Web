doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Dealer Convention Leads · PetroMath
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css')
  body
    style.
        body { background: #f0f2f5; padding: 20px; }
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px; }
        table { background: white; font-size: 13px; }
        th { white-space: nowrap; background: #1a73e8; color: white; }
        td { vertical-align: middle; }
        .table-wrap { background: white; border-radius: 10px; overflow-x: auto; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }

    .page-header
        h4.mb-0 Dealer Convention Leads (#{leads.length})
        a.btn.btn-primary(href='/dealer-leads/admin/export') Export CSV

    .table-wrap
        table.table.table-striped.mb-0
            thead
                tr
                    th #
                    th Bunk Name
                    th Place
                    th District
                    th Phone
                    th Oil Company
                    th Contact
                    th Role
                    th Lead Mode
                    th Generated By
                    th Notes
                    th Collected On
            tbody
                if leads.length === 0
                    tr
                        td.text-center.text-muted(colspan='12') No leads collected yet.
                each lead, i in leads
                    tr
                        td= i + 1
                        td= lead.bunk_name
                        td= lead.place
                        td= lead.district
                        td= lead.phone_number
                        td= lead.oil_company
                        td= lead.contact_person_name || '-'
                        td= lead.contact_role
                        td= lead.lead_mode
                        td= lead.generated_by || '-'
                        td= lead.notes || '-'
                        td= moment(lead.creation_date).format('DD-MMM-YYYY HH:mm')
