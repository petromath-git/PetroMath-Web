//- Phone reminders (Web Push): turn on / off for THIS device. Only admin-type
//- users get deadline reminders (see services/deadline-reminder-scheduler.js),
//- so only render this for user.isAdmin. Works in Chrome / Android, and on
//- iPhone only inside the installed app (Add to Home Screen, iOS 16.4+).
//-   compact - true on the phone home: a one-line nudge, hidden once reminders
//-             are on or after "Not now" (for 30 days)
mixin pushRemindersCard(compact)
  .pm-push(hidden data-compact=(compact ? '1' : '0'))
    .pm-push-icon
      i.bi.bi-bell(aria-hidden="true")
    .pm-push-text
      strong.pm-push-title Deadline reminders
      span.pm-push-msg
    .pm-push-btns
      button.btn.btn-sm.btn-primary.pm-push-on(type="button" hidden) Turn on
      button.btn.btn-sm.btn-outline-secondary.pm-push-test(type="button" hidden) Send test
      button.btn.btn-sm.btn-outline-secondary.pm-push-off(type="button" hidden) Turn off
      if compact
        button.btn.btn-sm.btn-link.pm-push-later(type="button" hidden) Not now
  style.
    .pm-push { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 12px 14px; border: 1px solid #dee2e6; border-radius: 0.5rem; background: #fff; margin-bottom: 1rem; }
    .pm-push[hidden] { display: none; }
    .pm-push [hidden] { display: none !important; }
    .pm-push-icon { width: 38px; height: 38px; border-radius: 10px; background: #fff4e5; color: #b45309; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
    .pm-push-text { flex: 1 1 200px; min-width: 0; display: flex; flex-direction: column; }
    .pm-push-title { font-size: 15px; color: #1f2328; }
    .pm-push-msg { font-size: 13px; color: #4b5563; }
    .pm-push-btns { display: flex; gap: 6px; flex-wrap: wrap; }
  script.
    (function () {
      var box = document.currentScript.previousElementSibling.previousElementSibling;
      var compact = box.getAttribute('data-compact') === '1';
      var msg = box.querySelector('.pm-push-msg');
      var btnOn = box.querySelector('.pm-push-on'), btnOff = box.querySelector('.pm-push-off');
      var btnTest = box.querySelector('.pm-push-test'), btnLater = box.querySelector('.pm-push-later');
      var LATER_KEY = 'pmPushLaterUntil';
      var ua = navigator.userAgent || '';
      var isIOS = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      var standalone = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone === true;

      function laterActive() {
        try { return Number(localStorage.getItem(LATER_KEY) || 0) > Date.now(); } catch (e) { return false; }
      }
      function show(text, on, off, test) {
        msg.textContent = text;
        btnOn.hidden = !on; btnOff.hidden = !off; btnTest.hidden = !test;
        if (btnLater) btnLater.hidden = !on;
        box.hidden = false;
      }
      function post(url, body) {
        return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) })
          .then(function (r) { return r.json(); });
      }
      function keyBytes(base64) {
        var pad = '='.repeat((4 - base64.length % 4) % 4);
        var raw = atob((base64 + pad).replace(/-/g, '+').replace(/_/g, '/'));
        var out = new Uint8Array(raw.length);
        for (var i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
        return out;
      }

      var supported = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
      if (!supported) {
        if (compact) return;
        if (isIOS && !standalone) return show('On iPhone: tap Share → Add to Home Screen, open PetroMath from the home screen, then turn reminders on here.', false, false, false);
        return show('This browser can\'t show reminders. Use Chrome on Android, or the installed app on iPhone.', false, false, false);
      }

      var reg = null;
      function refresh() {
        return navigator.serviceWorker.ready.then(function (r) {
          reg = r;
          return r.pushManager.getSubscription();
        }).then(function (sub) {
          if (!sub) return null;
          return post('/push/status', { endpoint: sub.endpoint }).then(function (d) { return d.subscribed ? sub : null; });
        }).then(function (sub) {
          if (sub) {
            if (compact) { box.hidden = true; return; }
            return show('On for this phone. You\'ll get a reminder at 9 AM when something is due or overdue.', false, true, true);
          }
          if (Notification.permission === 'denied') {
            if (compact) return;
            return show('Notifications are blocked for PetroMath. Allow them in the phone\'s settings for this app / site, then reload.', false, false, false);
          }
          if (compact && laterActive()) return;
          show(compact ? 'Get a 9 AM alert on this phone when a licence, certificate or bill is due.'
                       : 'Off for this device. Turn on to get a 9 AM alert when something is due or overdue.', true, false, false);
        }).catch(function () {
          if (!compact) show('Could not check reminders on this device.', false, false, false);
        });
      }

      btnOn.addEventListener('click', function () {
        btnOn.disabled = true;
        fetch('/push/key', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (d) {
          if (!d.success) throw new Error(d.error || 'Reminders are not set up on this server.');
          return Notification.requestPermission().then(function (perm) {
            if (perm !== 'granted') throw new Error('Notifications were not allowed.');
            return reg.pushManager.getSubscription();
          }).then(function (old) {
            return old || reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: keyBytes(d.publicKey) });
          });
        }).then(function (sub) {
          return post('/push/subscribe', { subscription: sub.toJSON() });
        }).then(function (d) {
          if (!d.success) throw new Error(d.error || 'Could not turn on reminders.');
          if (compact) { box.hidden = true; return; }
          return refresh();
        }).catch(function (e) {
          alert(e.message);
        }).then(function () { btnOn.disabled = false; });
      });

      btnOff.addEventListener('click', function () {
        btnOff.disabled = true;
        reg.pushManager.getSubscription().then(function (sub) {
          if (!sub) return;
          return post('/push/unsubscribe', { endpoint: sub.endpoint }).then(function () { return sub.unsubscribe(); });
        }).catch(function () {}).then(function () { btnOff.disabled = false; refresh(); });
      });

      btnTest.addEventListener('click', function () {
        btnTest.disabled = true;
        reg.pushManager.getSubscription().then(function (sub) {
          if (!sub) throw new Error('Reminders are not on for this device.');
          return post('/push/test', { endpoint: sub.endpoint });
        }).then(function (d) {
          if (!d.success) throw new Error(d.error || 'Send failed.');
        }).catch(function (e) { alert(e.message); }).then(function () { btnTest.disabled = false; });
      });

      if (btnLater) btnLater.addEventListener('click', function () {
        try { localStorage.setItem(LATER_KEY, String(Date.now() + 30 * 24 * 3600 * 1000)); } catch (e) {}
        box.hidden = true;
      });

      refresh();
    })();
