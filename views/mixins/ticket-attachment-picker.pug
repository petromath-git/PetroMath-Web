//- File picker for support ticket attachments (photos / screenshots / PDF).
//- Checks the count and size before upload and shrinks large photos in the
//- browser (phone photos are often 3-6 MB). The server checks everything again.
//-   remaining - how many more files this ticket can take
//-   maxMb     - per-file limit
mixin ticketAttachmentPicker(remaining, maxMb)
    input.form-control-file#ticketFiles(type="file" name="attachments" multiple=(remaining > 1)
        accept="image/jpeg,image/png,image/webp,application/pdf")
    .form-text.text-muted
        | Up to #{remaining} #{remaining === 1 ? 'file' : 'files'}: photo, screenshot or PDF, #{maxMb} MB each
    ul.list-unstyled.small.mb-0.mt-1#ticketFilesList
    script.
        (function () {
            var input = document.getElementById('ticketFiles');
            var list = document.getElementById('ticketFilesList');
            var maxFiles = !{JSON.stringify(remaining)};
            var maxBytes = !{JSON.stringify(maxMb)} * 1024 * 1024;
            var types = ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
            var submitBtn = input.form && input.form.querySelector('[type="submit"]');

            function sizeText(b) { return b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB'; }

            function reset(msg) {
                if (msg) alert(msg);
                input.value = '';
                list.innerHTML = '';
            }

            // Photos over 1.5 MB: scale to 1920 px and re-encode as JPEG
            function shrink(file) {
                if (file.type === 'application/pdf' || file.size <= 1.5 * 1048576) return Promise.resolve(file);
                return new Promise(function (resolve) {
                    var img = new Image();
                    var url = URL.createObjectURL(file);
                    img.onload = function () {
                        var scale = Math.min(1, 1920 / Math.max(img.width, img.height));
                        var c = document.createElement('canvas');
                        c.width = Math.round(img.width * scale);
                        c.height = Math.round(img.height * scale);
                        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
                        URL.revokeObjectURL(url);
                        c.toBlob(function (blob) {
                            if (!blob || blob.size >= file.size) return resolve(file);
                            var name = file.name.replace(/\.[^.]*$/, '') + '.jpg';
                            resolve(new File([blob], name, { type: 'image/jpeg' }));
                        }, 'image/jpeg', 0.8);
                    };
                    img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
                    img.src = url;
                });
            }

            input.addEventListener('change', function () {
                var files = Array.prototype.slice.call(input.files);
                list.innerHTML = '';
                if (!files.length) return;
                if (files.length > maxFiles) return reset('You can attach ' + maxFiles + (maxFiles === 1 ? ' file' : ' files') + ' only');
                for (var i = 0; i < files.length; i++) {
                    if (types.indexOf(files[i].type) < 0) return reset(files[i].name + ': only photos (JPEG, PNG, WebP) and PDF files can be attached');
                }
                if (submitBtn) submitBtn.disabled = true;
                Promise.all(files.map(shrink)).then(function (out) {
                    if (submitBtn) submitBtn.disabled = false;
                    for (var j = 0; j < out.length; j++) {
                        if (out[j].size > maxBytes) return reset(out[j].name + ' is ' + sizeText(out[j].size) + '. Each file must be ' + (maxBytes / 1048576) + ' MB or smaller');
                    }
                    if (window.DataTransfer && out.some(function (f, k) { return f !== files[k]; })) {
                        var dt = new DataTransfer();
                        out.forEach(function (f) { dt.items.add(f); });
                        input.files = dt.files;
                    }
                    out.forEach(function (f) {
                        var li = document.createElement('li');
                        li.innerHTML = '<i class="bi bi-paperclip mr-1"></i>';
                        li.appendChild(document.createTextNode(f.name + ' (' + sizeText(f.size) + ')'));
                        list.appendChild(li);
                    });
                });
            });
        })();
