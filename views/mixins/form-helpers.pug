//- App-wide form helpers. Goes inside `head` of every layout (layout,
//- layout-customer, dsm-entry).

//- Number boxes pre-filled with 0: entering one selects the 0, so typing "5"
//- replaces it (5, not 05). The value itself is never changed, so totals,
//- autosave (which can save while a box is focused) and validation see
//- exactly what they did before.
//- Applies to type=number and inputmode=decimal/numeric boxes that aren't
//- read-only or disabled; opt out with data-keep-zero.
mixin formHelpers()
  script.
    (function () {
      var ZERO = /^\s*[-+]?0*(\.0*)?\s*$/; // 0, 0.0, 0.00, 00 ...
      function zeroBox(el) {
        if (!el || el.tagName !== 'INPUT' || el.readOnly || el.disabled) return false;
        if (el.hasAttribute('data-keep-zero')) return false;
        if (!(el.type === 'number' || /^(decimal|numeric)$/.test(el.getAttribute('inputmode') || ''))) return false;
        return el.value !== '' && ZERO.test(el.value);
      }
      // A click's mouseup would drop the selection again; swallow that one
      function keepSelection(e) { e.preventDefault(); }

      document.addEventListener('focusin', function (e) {
        var el = e.target;
        if (!zeroBox(el)) return;
        el.addEventListener('mouseup', keepSelection, { once: true });
        setTimeout(function () {
          if (document.activeElement === el) { try { el.select(); } catch (err) {} }
        }, 0);
      });
      document.addEventListener('focusout', function (e) {
        if (e.target && e.target.removeEventListener) e.target.removeEventListener('mouseup', keepSelection);
      });
    })();
