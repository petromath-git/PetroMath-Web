extends layout

block content
    include mixins/dev-tracker-style
    - var typeBadge = { Bug: 'danger', Feature: 'primary', Enhancement: 'info', Task: 'secondary' }
    - var statusBadge = { 'Open': 'warning', 'In Progress': 'info', 'Testing': 'primary', 'Complete': 'success', 'Closed': 'secondary' }
    - var priorityBadge = { Critical: 'danger', High: 'warning', Medium: 'info', Low: 'secondary' }
    - var typeLabel = { Bug: 'Issue', Feature: 'Feature request', Enhancement: 'Enhancement', Task: 'Task' }
    .container-fluid.ticket-page
        .d-flex.justify-content-between.align-items-start.flex-wrap.gap-2.mb-3
            .d-flex.align-items-start
                a.btn.btn-outline-secondary.mr-3(href="/dev-tracker")
                    i.bi.bi-arrow-left
                div
                    h3.mb-1
                        span.text-muted ##{tracker.tracker_id}
                        |  #{tracker.title}
                    .d-flex.flex-wrap.gap-1
                        span.badge(class=`badge-${typeBadge[tracker.type] || 'secondary'}`)= typeLabel[tracker.type] || tracker.type
                        span.badge(class=`badge-${statusBadge[tracker.status] || 'secondary'}`)= tracker.status
                        span.badge(class=`badge-${priorityBadge[tracker.priority]}`)= tracker.priority
                        span.badge.badge-light.border
                            i.bi.bi-geo-alt.mr-1
                            = tracker.location_code || 'Platform'
                        if tracker.scope === 'ALL'
                            span.badge.badge-dark All locations
            if canManage
                .d-flex.gap-2
                    a.btn.btn-primary(href=`/dev-tracker/${tracker.tracker_id}/edit`)
                        i.bi.bi-pencil.mr-1
                        | Edit
                    button.btn.btn-outline-danger(type="button" onclick=`deleteTicket(${tracker.tracker_id})`)
                        i.bi.bi-trash

        .row.g-3
            .col-12.col-lg-8
                .card.mb-3
                    .card-body
                        .small.text-muted.mb-2
                            | Raised by #{tracker.created_by || 'unknown'} on #{fmtDateTime(tracker.creation_date)}
                        if tracker.description
                            .ticket-text= tracker.description
                        else
                            span.text-muted No details given

                // Conversation
                .card.mb-3#comments
                    .card-header
                        i.bi.bi-chat-left-text.mr-2
                        | Updates
                    .card-body
                        if tracker.comments && tracker.comments.length
                            each c in tracker.comments
                                .comment.mb-3(class=c.is_internal ? 'comment-internal' : '')
                                    .small.text-muted.mb-1
                                        strong= c.created_by
                                        |  · #{fmtDateTime(c.creation_date)}
                                        if c.is_internal
                                            span.badge.badge-secondary.ml-2 Internal
                                    .ticket-text= c.comment_text
                        else
                            p.text-muted.small No updates yet

                        form(method="POST" action=`/dev-tracker/${tracker.tracker_id}/comments`)
                            textarea.form-control.mb-2(name="comment_text" rows="3" required placeholder="Add an update or reply...")
                            .d-flex.justify-content-between.align-items-center
                                if canManage
                                    .form-check
                                        input.form-check-input#isInternal(type="checkbox" name="is_internal")
                                        label.form-check-label.small(for="isInternal") Internal note (only support team sees it)
                                else
                                    span
                                button.btn.btn-sm.btn-primary(type="submit")
                                    i.bi.bi-send.mr-1
                                    | Post

                if canManage
                    // Internal tasks
                    .card.mb-3#tasks
                        .card-header.d-flex.justify-content-between.align-items-center
                            span
                                i.bi.bi-list-check.mr-2
                                | Tasks
                            button.btn.btn-sm.btn-outline-primary(type="button" data-toggle="collapse" data-target="#addTaskForm")
                                i.bi.bi-plus
                        .collapse#addTaskForm
                            form.card-body.border-bottom(method="POST" action=`/dev-tracker/${tracker.tracker_id}/tasks`)
                                .row.g-2
                                    .col-12.col-md-6
                                        input.form-control.form-control-sm(type="text" name="task_title" required maxlength="255" placeholder="Task")
                                    .col-6.col-md-3
                                        select.form-control.form-control-sm(name="task_priority")
                                            option(value="Low") Low
                                            option(value="Medium" selected) Medium
                                            option(value="High") High
                                    .col-6.col-md-3
                                        button.btn.btn-sm.btn-primary.w-100(type="submit") Add Task
                        if tracker.tasks && tracker.tasks.length
                            ul.list-group.list-group-flush
                                each task in tracker.tasks
                                    li.list-group-item.d-flex.flex-wrap.justify-content-between.align-items-center.gap-2
                                        span(class=task.task_status === 'Done' ? 'task-done text-muted' : '')= task.task_title
                                        .d-flex.gap-1
                                            select.form-control.form-control-sm(style="width:auto" onchange=`setTaskStatus(${task.task_id}, this.value)`)
                                                each st in ['To Do', 'In Progress', 'Done', 'Blocked']
                                                    option(value=st selected=(task.task_status === st))= st
                                            button.btn.btn-sm.btn-outline-danger(type="button" onclick=`deleteTask(${task.task_id})`)
                                                i.bi.bi-x
                        else
                            .card-body.small.text-muted No tasks

            .col-12.col-lg-4
                if canManage
                    .card.mb-3
                        .card-body.small
                            .d-flex.justify-content-between.mb-1
                                span.text-muted Assigned to
                                span= tracker.assigned_to || 'Unassigned'
                            .d-flex.justify-content-between.mb-1
                                span.text-muted Due
                                span= tracker.due_date ? fmtDate(tracker.due_date) : '-'
                            .d-flex.justify-content-between.mb-1
                                span.text-muted Estimated
                                span= tracker.estimated_hours ? Number(tracker.estimated_hours) + ' h' : '-'
                            .d-flex.justify-content-between.mb-1
                                span.text-muted Spent
                                strong= tracker.actual_hours ? Number(tracker.actual_hours) + ' h' : '0 h'
                            if tracker.tags
                                .mt-2
                                    each tag in tracker.tags.split(',')
                                        span.badge.badge-light.border.mr-1= tag.trim()
                            if tracker.updated_by
                                .text-muted.mt-2 Last updated by #{tracker.updated_by}

                    // Work log
                    .card.mb-3#worklog
                        .card-header
                            i.bi.bi-stopwatch.mr-2
                            | Work Log
                        form.card-body.border-bottom(method="POST" action=`/dev-tracker/${tracker.tracker_id}/worklog`)
                            .row.g-2
                                .col-7
                                    input.form-control.form-control-sm(type="date" name="work_date" value=today required)
                                .col-5
                                    input.form-control.form-control-sm(type="number" name="hours" step="0.25" min="0.25" max="24" required placeholder="Hours")
                                .col-12
                                    input.form-control.form-control-sm(type="text" name="note" maxlength="500" placeholder="What was done")
                                .col-12
                                    button.btn.btn-sm.btn-primary.w-100(type="submit") Log Hours
                        if tracker.worklog && tracker.worklog.length
                            ul.list-group.list-group-flush.small
                                each w in tracker.worklog
                                    li.list-group-item.d-flex.justify-content-between.gap-2
                                        div
                                            strong #{Number(w.hours)} h
                                            span.text-muted  · #{fmtDate(w.work_date)} · #{w.created_by}
                                            if w.source === 'Claude'
                                                span.badge.badge-light.border.ml-1 Claude
                                            if w.note
                                                div= w.note
                                        button.btn.btn-sm.btn-link.text-danger.p-0(type="button" onclick=`deleteWorklog(${w.worklog_id})` title="Remove")
                                            i.bi.bi-x-lg

    if canManage
        script.
            function send(url, method, body) {
                return fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: body ? JSON.stringify(body) : undefined
                }).then(r => r.json()).then(d => {
                    if (!d.success) throw new Error(d.error || 'Failed');
                    return d;
                }).catch(e => { alert(e.message); throw e; });
            }
            function deleteTicket(id) {
                if (!confirm('Delete this ticket?')) return;
                send('/dev-tracker/' + id, 'DELETE').then(() => { window.location.href = '/dev-tracker'; });
            }
            function setTaskStatus(taskId, status) {
                send('/dev-tracker/tasks/' + taskId, 'PUT', { task_status: status }).then(() => location.reload());
            }
            function deleteTask(taskId) {
                if (!confirm('Remove this task?')) return;
                send('/dev-tracker/tasks/' + taskId, 'DELETE').then(() => location.reload());
            }
            function deleteWorklog(id) {
                if (!confirm('Remove this work log entry?')) return;
                send('/dev-tracker/worklog/' + id, 'DELETE').then(() => location.reload());
            }
