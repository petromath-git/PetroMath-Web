extends layout

block content
    include mixins/dev-tracker-style
    - var typeLabel = { Bug: 'Issue (something is wrong)', Feature: 'Feature request (something new)', Enhancement: 'Enhancement (improve something existing)', Task: 'Task (internal)' }
    .container-fluid.ticket-page
        .d-flex.align-items-center.mb-3
            a.btn.btn-outline-secondary.mr-3(href="/dev-tracker")
                i.bi.bi-arrow-left
            h2.mb-0 New Ticket

        .row.justify-content-center
            .col-12.col-lg-8
                form.card.card-body(method="POST" action="/dev-tracker")
                    .row.g-3
                        .col-12.col-md-6
                            label Station *
                            select.form-control(name="location_code" required=!canManage)
                                if canManage
                                    option(value="") Platform: no specific station
                                else if locations.length > 1
                                    option(value="") Choose station...
                                each loc in locations
                                    option(value=loc.location_code selected=(loc.location_code === currentLocation && !canManage))= loc.location_code + ' - ' + loc.location_name
                            .form-text.text-muted Which station is this for?
                        .col-12.col-md-6
                            label Type *
                            select.form-control(name="type" required)
                                each t in types
                                    option(value=t)= typeLabel[t]

                        if canManage
                            .col-12.col-md-6
                                label Scope
                                select.form-control(name="scope")
                                    option(value="LOCATION") Station request: only this station asked for it
                                    option(value="ALL") All locations: building it for everyone
                                .form-text.text-muted A platform ticket (no station) is always "All locations"

                        .col-12
                            label Title *
                            input.form-control(type="text" name="title" required maxlength="255" placeholder="Short summary, e.g. Day close shows wrong cash total")

                        .col-12
                            label Details
                            textarea.form-control(name="description" rows="6" placeholder="What happened? Which screen, which date/shift, what did you expect? For a feature: what should it do and why?")

                        .col-12.col-md-6
                            label Priority
                            select.form-control(name="priority")
                                option(value="Low") Low: can wait
                                option(value="Medium" selected) Medium
                                option(value="High") High: affecting daily work
                                option(value="Critical") Critical: station cannot operate

                        if canManage
                            .col-12.col-md-6
                                label Assigned To
                                input.form-control(type="text" name="assigned_to" maxlength="100")
                            .col-6.col-md-4
                                label Due Date
                                input.form-control(type="date" name="due_date")
                            .col-6.col-md-4
                                label Estimated Hours
                                input.form-control(type="number" name="estimated_hours" step="0.5" min="0")
                            .col-12.col-md-4
                                label Tags
                                input.form-control(type="text" name="tags" maxlength="255" placeholder="closing, gst, ...")

                    .d-flex.gap-2.mt-4
                        button.btn.btn-primary(type="submit")
                            i.bi.bi-send.mr-1
                            | Submit Ticket
                        a.btn.btn-outline-secondary(href="/dev-tracker") Cancel
