td.rf-gap &nbsp;
td.rf-gap 
    input(type="hidden" name="caller" value="notpdf")             
td.rf-gap
td.rf-btn.rf-go
    button.btn.btn-primary.mr-2(type='submit', id='goButton')
        span.rf-label-desktop Go
        span.rf-label-mobile Show report
td.rf-btn                    
    button.btn.btn-success.mr-2(
        type='button'
        onClick='generatePDF(window.location.href,"N")'
        title='Download PDF'
        data-toggle='tooltip'
        data-placement='top'
    )
        i.bi.bi-cloud-download
        span.rf-label-mobile  PDF
td.rf-btn                    
    button.btn.btn-info(
        type='button'
        onClick='generatePDF(window.location.href,"Y")'
        title='Print'
        data-toggle='tooltip'
        data-placement='top'
    )
        i.bi.bi-printer
        span.rf-label-mobile  Print