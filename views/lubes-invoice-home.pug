extends layout
include mixins/card-toggle-mobile

block content
    style.
        .purchase-filters label { font-size: .8rem; margin-bottom: .15rem; color: #495057; }
        .purchase-table .pi-sum-amt { font-family: 'Courier New', monospace; font-weight: 700; white-space: nowrap; display: block; }
        .purchase-table .pi-sum-sub { font-size: .75em; color: #6c757d; display: block; }
        @media (max-width: 767px) {
            /* open card: drop the summary copy of amount/date */
            .purchase-table tr.card-open > td.m-summary { display: none !important; }
            /* the line-details row is only a card while its lines are showing */
            .purchase-table tr.collapse-row:not(:has(.collapse.show)) { display: none !important; }
            .purchase-table tr.collapse-row > td.line-details > .collapse > div { padding: .25rem 0 !important; overflow-x: auto; }
            .purchase-filters .btn { width: 100%; }
            /* lines inside an open invoice: compact cards on a light background */
            .purchase-table .nested-table > tbody > tr { background: #f8f9fa !important; margin-bottom: .4rem; }
            .purchase-table .nested-table > tbody > tr.table-info { display: flex; justify-content: space-between; background: #d1ecf1 !important; }
        }
        .toggle-icon {
            transition: transform 0.2s ease-in-out;
        }
        [aria-expanded="true"] .toggle-icon {
            transform: rotate(90deg);
        }
        .nested-table {
            background-color: #f8f9fa;
            margin: 0;
        }
        .nested-table th {
            background-color: #e9ecef;
        }
        .loading-spinner {
            text-align: center;
            padding: 20px;
        }
        .collapse-row {
            background-color: #f8f9fa;
        }
        .line-details {
            padding: 0 !important;
        }

    script.
        function deleteInvoice(invoiceId, status) {
            // Existing delete function remains the same
            if (status !== 'DRAFT') {
                alert('Only draft invoices can be deleted.');
                return;
            }
            if (confirm('Are you sure you want to delete this invoice?')) {
                fetch(`/lubes-invoice/delete?id=${invoiceId}`, {
                    method: 'GET'
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success || result.message) {
                        alert(result.message || 'Invoice deleted successfully');
                        window.location.reload();
                    } else {
                        alert('Failed to delete invoice');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while deleting the invoice');
                });
            }
        }

        function toggleFuelCategoryFilter() {
            const fuelCategorySelect = document.getElementById('fuel_category');
            if (!fuelCategorySelect) return; // location has no CNG product; filter isn't rendered
            const show = document.getElementById('invoice_type').value === 'FUEL';
            document.getElementById('fuelCategoryField').style.display = show ? '' : 'none';
            if (!show) fuelCategorySelect.value = '';
        }

        function toggleInvoiceLines(invoiceId, button) {
            const lineContainer = document.getElementById(`invoice-lines-${invoiceId}`);
            const isExpanded = button.getAttribute('aria-expanded') === 'true';
            
            // Toggle aria-expanded
            button.setAttribute('aria-expanded', !isExpanded);
            
            // Toggle the collapse
            if (!isExpanded) {
                lineContainer.classList.add('show');
                if (!lineContainer.hasAttribute('data-loaded')) {
                    lineContainer.innerHTML = '<div class="loading-spinner">Loading invoice details...</div>';
                    
                    fetch(`/lubes-invoice/lines?id=${invoiceId}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.success && data.lines) {
                                const linesTable = createLinesTable(data.lines);
                                lineContainer.innerHTML = linesTable;
                                lineContainer.setAttribute('data-loaded', 'true');
                            } else {
                                lineContainer.innerHTML = '<div class="p-3">No lines found</div>';
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            lineContainer.innerHTML = '<div class="p-3 text-danger">Error loading invoice lines</div>';
                        });
                }
            } else {
                lineContainer.classList.remove('show');
            }
        }

        function createLinesTable(lines) {
            if (!lines || lines.length === 0) return '<div class="p-3">No lines found</div>';
            
            const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const n2 = v => (parseFloat(v) || 0).toFixed(2);
            let html = `
                <div class="p-3">
                    <table class="table table-sm nested-table m-stack">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Rate</th>
                                <th class="text-right">Discount</th>
                                <th class="text-right">Taxable</th>
                                <th class="text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody>`;

            let totalAmount = 0;

            lines.forEach(line => {
                totalAmount += parseFloat(line.amount) || 0;
                const disc = (parseFloat(line.discount_amount) || 0) + (parseFloat(line.cash_discount_amount) || 0);
                html += `
                    <tr>
                        <td class="m-title">${esc(line.product_name || 'Unknown Product')}${line.notes ? `<div class="small text-muted">${esc(line.notes)}</div>` : ''}</td>
                        <td class="text-right" data-label="Quantity">${n2(line.qty)}</td>
                        <td class="text-right" data-label="Rate">${n2(line.net_rate)}</td>
                        <td class="text-right" data-label="Discount">${disc ? n2(disc) : '-'}</td>
                        <td class="text-right" data-label="Taxable">${line.taxable_value != null ? n2(line.taxable_value) : '-'}</td>
                        <td class="text-right" data-label="Amount">${n2(line.amount)}</td>
                    </tr>`;
            });

            html += `
                    <tr class="table-info">
                        <td colspan="5" class="text-right"><strong>Total:</strong></td>
                        <td class="text-right"><strong>${totalAmount.toFixed(2)}</strong></td>
                    </tr>
                </tbody>
            </table>
            </div>`;
            
            return html;
        }

    //- Filters: one row on desktop, stacked on phones
    form.purchase-filters.mb-3(method='GET' action='/lubes-invoice-home' id='lubesinvoicehome')
        div.form-row.align-items-end
            div.form-group.col-12.col-md-auto
                label(for='dateRange') Date Range
                select#dateRange.form-control.form-control-sm(onchange="updateInvoiceDateRange()")
                    option(value='this_month') This Month
                    option(value='last_month') Last Month
                    option(value='this_financial_year') This Financial Year
                    option(value='last_financial_year') Last Financial Year
                    option(value='custom', selected=true) Custom Date
            div.form-group.col-6.col-md-auto.custom-date-field
                label#fromDateLabel(for='invoice_fromDate') From Date
                input#invoice_fromDate.form-control.form-control-sm(type='date' name='invoice_fromDate' value=fromDate required onChange="copyToHidden(this);")
            div.form-group.col-6.col-md-auto.custom-date-field
                label#toDateLabel(for='invoice_toDate') To Date
                input#invoice_toDate.form-control.form-control-sm(type='date' name='invoice_toDate' value=toDate required onChange="copyToHidden(this);")
            div.form-group.col-12.col-md-auto
                label(for='supplier_id') Supplier
                select#supplier_id.form-control.form-control-sm(name='supplier_id')
                    option(value='') All Suppliers
                    each supplier in suppliers
                        option(value=supplier.supplier_id selected=selectedSupplierId == supplier.supplier_id)= supplier.supplier_name
            div.form-group.col-6.col-md-auto
                label(for='invoice_type') Type
                select#invoice_type.form-control.form-control-sm(name='invoice_type' onchange='toggleFuelCategoryFilter()')
                    option(value='' selected=selectedType == '') All Types
                    option(value='FUEL' selected=selectedType == 'FUEL') Fuel
                    option(value='LUBE' selected=selectedType == 'LUBE') Lube
            if hasCngProduct
                div.form-group.col-6.col-md-auto#fuelCategoryField(style=selectedType == 'FUEL' ? '' : 'display:none')
                    label(for='fuel_category') Fuel Category
                    select#fuel_category.form-control.form-control-sm(name='fuel_category')
                        option(value='' selected=selectedFuelCategory == '') All Fuel
                        option(value='CNG' selected=selectedFuelCategory == 'CNG') CNG
                        option(value='MS_HSD' selected=selectedFuelCategory == 'MS_HSD') MS / HSD
            div.form-group.col-6.col-md-auto
                button.btn.btn-sm.btn-primary(type='submit') Go
            div.form-group.col-6.col-md-auto
                div.dropdown
                    button.btn.btn-sm.btn-primary.dropdown-toggle(type='button' data-toggle='dropdown') New Purchase
                    div.dropdown-menu
                        a.dropdown-item(href='/purchases/fuel-invoice/new') Fuel Invoice
                        a.dropdown-item(href='/lubes-invoice/new') Lube Invoice (Manual)

        input(type='hidden' id='invoice_fromDate_hiddenValue' name='invoice_fromDate_hiddenValue' value=fromDate)
        input(type='hidden' id='invoice_toDate_hiddenValue' name='invoice_toDate_hiddenValue' value=toDate)

    div
        if invoiceValues && invoiceValues.length > 0
            //- Phones: each invoice is a card, collapsed to supplier + amount/date; tap to open
            table.table.purchase-table.m-stack.m-collapse
                thead.thead-light
                    tr
                        th(style="width: 30px")
                        th Invoice Number
                        th Supplier
                        th Date
                        th Type
                        th.text-right Amount
                        th.text-center Lines / Qty
                        th Status
                        th Actions
                tbody
                    each val in invoiceValues
                        - const amountText = val.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        tr(class=val.closing_status.toLowerCase())
                            td.m-summary.d-md-none
                                span.pi-sum-amt ₹#{amountText}
                                span.pi-sum-sub= val.date
                            td.m-hide
                                if val.type === 'LUBE'
                                    button.btn.btn-sm.btn-link.p-0(
                                        type='button'
                                        onclick=`toggleInvoiceLines(${val.lubes_hdr_id}, this)`
                                        aria-expanded='false'
                                    )
                                        i.oi.oi-chevron-right.toggle-icon
                            td(data-label='Invoice No')= val.invoice_number
                            td.m-title= val.supplier_name
                            td(data-label='Date')= val.date
                            td(data-label='Type')
                                if val.type === 'FUEL'
                                    span.badge.badge-warning= val.fuel_category === 'CNG' ? 'CNG' : 'Fuel (MS/HSD)'
                                else
                                    span.badge.badge-info Lube
                            td.text-right(data-label='Amount')= amountText
                            td.text-center(data-label='Lines / Qty')
                                if val.type === 'FUEL'
                                    = val.qty_kl ? val.qty_kl + ' ' + (val.qty_unit || 'KL') : val.total_lines + ' lines'
                                else
                                    span.badge.badge-info= val.total_lines
                            td(data-label='Status')
                                if val.type === 'FUEL'
                                    span.badge.badge-secondary= val.closing_status
                                else
                                    span(class=val.closing_status === 'DRAFT' ? 'badge badge-warning' : 'badge badge-success')
                                        = val.closing_status
                            td.m-actions
                                if val.type === 'LUBE'
                                    //- phones: the chevron column is hidden, so lines open from here
                                    button.btn.btn-sm.btn-outline-secondary.mr-2.d-md-none(
                                        type='button'
                                        onclick=`toggleInvoiceLines(${val.lubes_hdr_id}, this)`
                                        aria-expanded='false'
                                    ) Lines
                                if val.type === 'FUEL'
                                    a.btn.btn-sm.btn-info.mr-1(href='/purchases/fuel-invoice/' + val.fuel_id)
                                        span.oi.oi-envelope-open
                                    a.btn.btn-sm.btn-danger(href='/purchases/fuel-invoice/' + val.fuel_id + '/pdf' target='_blank' title='View PDF')
                                        span.oi.oi-document
                                else if val.closing_status === 'DRAFT'
                                    a.btn.btn-sm.btn-info.mr-2(href='/lubes-invoice?id=' + val.lubes_hdr_id)
                                        span.oi.oi-pencil
                                    a.btn.btn-sm.btn-danger(onClick=`deleteInvoice(${val.lubes_hdr_id}, '${val.closing_status}')`)
                                        span.oi.oi-trash
                                else
                                    a.btn.btn-sm.btn-info(href='/lubes-invoice?id=' + val.lubes_hdr_id)
                                        span.oi.oi-envelope-open
                        if val.type === 'LUBE'
                            tr.collapse-row.m-static
                                td.line-details.m-wide(colspan='9')
                                    div.collapse(id=`invoice-lines-${val.lubes_hdr_id}`)
        else
            div.text-center.text-muted.py-4 No purchase invoices for these filters.

    +cardToggleMobile('table.m-collapse > tbody > tr:not(.m-static)')
