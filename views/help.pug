extends layout

//- Each video can have a Tamil / Hindi copy (<name>.ta.mp4, <name>.hi.mp4: voice + captions); the language switch picks it.
//- The page text is in views/help/body-<lang>.pug; `lang` is the language of the text around this video.
mixin howVideo(name, label, phone, lang)
  - const ui = { en: ['Watch how', 'English only', 'Share on WhatsApp'], ta: ['எப்படின்னு பாருங்க', 'English-ல மட்டும்', 'WhatsApp-ல share பண்ணுங்க'], hi: ['देखें कैसे', 'सिर्फ़ English में', 'WhatsApp पर share करें'] }[lang || 'en'];
  - const src = (l) => { const f = name + (l === 'en' ? '' : '.' + l); return { mp4: `/videos/${f}.mp4?v=${videoV[f + '.mp4'] || ''}`, jpg: `/videos/${f}.jpg?v=${videoV[f + '.jpg'] || ''}`, share: 'https://wa.me/?text=' + encodeURIComponent('PetroMath: ' + label + ' ' + origin + '/videos/' + f + '.mp4') }; }
  - const en = src('en'), ta = videoV[name + '.ta.mp4'] ? src('ta') : null, hi = videoV[name + '.hi.mp4'] ? src('hi') : null;
  - const first = (lang === 'ta' && ta) || (lang === 'hi' && hi) || en;
  figure.help-video(class=phone ? 'phone' : undefined data-en=JSON.stringify(en) data-ta=ta ? JSON.stringify(ta) : undefined data-hi=hi ? JSON.stringify(hi) : undefined)
    video(src=first.mp4 poster=first.jpg controls playsinline preload="none")
    figcaption
      span
        strong #{ui[0]}: #{label}
        span.badge.badge-light.border.ml-2.help-en-only(hidden) #{ui[1]}
      a.help-share(href=first.share target='_blank' rel='noopener')
        i.bi.bi-whatsapp.me-1
        | #{ui[2]}

block content
  style.
    .help-page { max-width: 980px; }
    .help-page .help-toc ol { margin-bottom: 0; }
    .help-page section { margin-bottom: 2rem; }
    .help-page h2 { font-size: 1.35rem; margin-bottom: .75rem; }
    .help-page h3 { font-size: 1.05rem; margin-top: 1.25rem; }
    .help-video { margin: 0 0 1.25rem; }
    .help-video video { width: 100%; max-width: 960px; aspect-ratio: 16 / 9; background: #111; border-radius: 6px; display: block; }
    .help-video.phone { max-width: 360px; }
    .help-video.phone video { aspect-ratio: 720 / 1504; }
    .help-video figcaption { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 8px 2px; font-size: .95rem; }
    .help-steps > li { margin-bottom: .6rem; }
    .help-page h2.help-part { font-size: 1.1rem; text-transform: uppercase; letter-spacing: .06em; color: #6c757d; border-bottom: 2px solid #f4c430; padding-bottom: .35rem; margin: 2.2rem 0 1.2rem; }
    .help-who { display: inline-block; font-size: .85rem; background: #fff7d6; border: 1px solid #f4c430; border-radius: 999px; padding: 1px 10px; margin: -.35rem 0 .75rem; }
    .help-toc-part { font-weight: 600; margin-top: .5rem; }
    .help-steps dt { font-weight: 600; }
    .help-steps dd { margin-left: 1.25rem; }
    /* One language shown at a time (html[data-help-lang], set before the page draws). No script: English. */
    [data-l] { display: none; }
    html[data-help-lang="en"] [data-l="en"], html[data-help-lang="ta"] [data-l="ta"], html[data-help-lang="hi"] [data-l="hi"],
    html:not([data-help-lang]) [data-l="en"] { display: revert; }

  .container-fluid.help-page
    if !user
      .d-flex.justify-content-end.mb-2
        a.btn.btn-sm.btn-outline-secondary.mr-2(href='/') PetroMath website
        a.btn.btn-sm.btn-warning(href='/login')
          i.bi.bi-box-arrow-in-right.me-1
          |  Sign in
    script.
      // Page language before anything draws: ?lang=, else the last choice, else Tamil (owner, 2026-11-12).
      (function () {
        var L = ['en', 'ta', 'hi'], l = new URLSearchParams(location.search).get('lang');
        if (L.indexOf(l) < 0) { try { l = localStorage.getItem('helpVideoLang'); } catch (e) { l = null; } }
        document.documentElement.setAttribute('data-help-lang', L.indexOf(l) >= 0 ? l : 'ta');
      })();
    h3.mb-1
      i.bi.bi-question-circle.me-2
      span(data-l='en') Help
      span(data-l='ta') உதவி
      span(data-l='hi') मदद
    p.text-muted(data-l='en') How to use PetroMath, step by step. Each topic has a short video.
    p.text-muted(data-l='ta') PetroMath-ஐ எப்படி use பண்றதுன்னு, step by step. ஒவ்வொரு topic-க்கும் ஒரு சின்ன video இருக்கு.
    p.text-muted(data-l='hi') PetroMath कैसे इस्तेमाल करें, step by step। हर topic का एक छोटा video है।
    .d-flex.align-items-center.flex-wrap.mb-3.help-lang
      span.mr-2(data-l='en') Language:
      span.mr-2(data-l='ta') மொழி:
      span.mr-2(data-l='hi') भाषा:
      .btn-group.btn-group-sm(role='group' aria-label='Video language')
        button.btn.btn-outline-primary(type='button' data-lang='en') English
        button.btn.btn-outline-primary(type='button' data-lang='ta') தமிழ்
        button.btn.btn-outline-primary(type='button' data-lang='hi') हिन्दी

    div(data-l='en')
      include help/body-en.pug
    div(data-l='ta')
      include help/body-ta.pug
    div(data-l='hi')
      include help/body-hi.pug


  script.
    // Language switch: page text and videos together. Tamil by default (owner, 2026-11-12), English / Hindi if
    // chosen. Remembered per browser; ?lang=en / ?lang=ta / ?lang=hi in a link sets it (the script at the top of
    // the page already set html[data-help-lang]). A video without a copy in that language plays in English.
    (function () {
      var KEY = 'helpVideoLang';
      var lang = document.documentElement.getAttribute('data-help-lang') || 'ta';
      // Topic links (/help#shift) name the English section; Tamil and Hindi copies are #ta-shift / #hi-shift.
      function goToHash(l) {
        var id = decodeURIComponent(location.hash.slice(1)).replace(/^(ta|hi)-/, '');
        if (!id) return;
        var el = document.getElementById(l === 'en' ? id : l + '-' + id);
        if (el) el.scrollIntoView();
      }
      function apply(l) {
        document.documentElement.setAttribute('data-help-lang', l);
        document.querySelectorAll('.help-lang button').forEach(function (b) {
          var on = b.getAttribute('data-lang') === l;
          b.classList.toggle('active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        document.querySelectorAll('figure.help-video').forEach(function (fig) {
          var copy = l === 'en' ? null : fig.getAttribute('data-' + l);
          var s = JSON.parse(copy || fig.getAttribute('data-en'));
          var v = fig.querySelector('video');
          if (v.getAttribute('src') !== s.mp4) {
            v.pause();
            v.setAttribute('src', s.mp4);
            v.setAttribute('poster', s.jpg);
            v.load();
          }
          fig.querySelector('.help-share').setAttribute('href', s.share);
          fig.querySelector('.help-en-only').hidden = !(l !== 'en' && !copy);
        });
      }
      document.querySelectorAll('.help-lang button').forEach(function (b) {
        b.addEventListener('click', function () {
          lang = b.getAttribute('data-lang');
          try { localStorage.setItem(KEY, lang); } catch (e) { /* storage blocked */ }
          apply(lang);
        });
      });
      apply(lang);
      goToHash(lang);
      window.addEventListener('hashchange', function () { goToHash(lang); });
      // One video at a time: starting a video pauses any other that is playing.
      // 'play' doesn't bubble, so listen in the capture phase.
      document.addEventListener('play', function (e) {
        if (e.target.tagName !== 'VIDEO') return;
        document.querySelectorAll('figure.help-video video').forEach(function (v) {
          if (v !== e.target && !v.paused) v.pause();
        });
      }, true);

      // Phones: a desktop (landscape) video goes full screen and turns sideways when it starts, and the
      // screen turns back upright when full screen ends. The installed app is locked to portrait
      // (manifest), so without the lock the video stays small and upright. Phone-screen videos
      // (figure.phone) stay upright. iPhone can't lock orientation; its own full-screen player turns
      // with the phone.
      var isPhone = window.matchMedia && window.matchMedia('(pointer: coarse)').matches &&
        Math.min(screen.width, screen.height) < 600;
      if (!isPhone) return;
      function fsElement() { return document.fullscreenElement || document.webkitFullscreenElement || null; }
      function isWideVideo(el) {
        return el && el.tagName === 'VIDEO' && el.closest('figure.help-video') && !el.closest('figure.help-video.phone');
      }
      // iPhone: a page can't go full screen from the 'play' event (not counted as the tap), but a
      // video without playsinline opens in the iPhone's own player on tap, which turns with the phone.
      // (Detect iPhone by name: newer iPhones may list requestFullscreen yet refuse it for a video.)
      var isIPhone = /iPhone|iPod/.test(navigator.userAgent);
      if (isIPhone) {
        document.querySelectorAll('figure.help-video video').forEach(function (v) {
          if (isWideVideo(v)) { v.removeAttribute('playsinline'); v.playsInline = false; }
        });
      }
      document.addEventListener('play', function (e) {
        var v = e.target;
        if (!isWideVideo(v) || fsElement()) return;
        if (isIPhone) {
          // Without playsinline the iPhone player normally opens by itself; this is a fallback
          if (!v.webkitDisplayingFullscreen && v.webkitEnterFullscreen) {
            try { v.webkitEnterFullscreen(); } catch (err) { /* stays in the page */ }
          }
        } else if (v.requestFullscreen) {
          v.requestFullscreen({ navigationUI: 'hide' }).catch(function () { /* no tap to go on: stays in the page */ });
        } else if (v.webkitEnterFullscreen) {
          try { v.webkitEnterFullscreen(); } catch (err) { /* stays in the page */ }
        }
      }, true);
      function onFullscreenChange() {
        if (!screen.orientation || !screen.orientation.lock) return;
        if (isWideVideo(fsElement())) {
          screen.orientation.lock('landscape').catch(function () { /* not allowed here: user can rotate */ });
        } else {
          try { screen.orientation.unlock(); } catch (err) { /* nothing locked */ }
        }
      }
      document.addEventListener('fullscreenchange', onFullscreenChange);
      document.addEventListener('webkitfullscreenchange', onFullscreenChange);
      // Video finished: leave full screen so the page (and the next topic) is back upright
      document.addEventListener('ended', function (e) {
        if (isWideVideo(e.target) && fsElement() === e.target && document.exitFullscreen) {
          document.exitFullscreen().catch(function () {});
        }
      }, true);
    })();