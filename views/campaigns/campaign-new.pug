extends ../layout

//- Used for both Create (campaign = null) and Edit (campaign = existing row)
block content
    - const isEdit = !!campaign
    .container-fluid.mt-3
        .row
            .col-12
                .card
                    .card-header
                        .d-flex.justify-content-between.align-items-center
                            h4.mb-0= isEdit ? 'Edit Campaign' : 'Create New Campaign'
                            a.btn.btn-secondary(href='/campaigns')
                                i.fas.fa-arrow-left
                                |  Back to List

                    .card-body
                        form#campaignForm
                            .row
                                .col-md-6
                                    .form-group
                                        label Location
                                        input.form-control(type='text' value=location ? location.location_name : '' readonly)
                                        if !isEdit
                                            small.form-text.text-muted Campaigns are created for your current location

                                .col-md-6
                                    .form-group
                                        label(for='name') Campaign Name *
                                        input#name.form-control(type='text' name='name' required maxlength='255' placeholder='e.g., Diwali Quiz 2025' value=isEdit ? campaign.name : '')

                            .row
                                .col-md-4
                                    .form-group
                                        label(for='start_date') Start Date *
                                        input#start_date.form-control(type='date' name='start_date' required value=isEdit ? campaign.start_date_ymd : '')

                                .col-md-4
                                    .form-group
                                        label(for='end_date') End Date *
                                        input#end_date.form-control(type='date' name='end_date' required value=isEdit ? campaign.end_date_ymd : '')

                                if isEdit
                                    .col-md-4
                                        .form-group
                                            label(for='status') Status *
                                            select#status.form-control(name='status' required)
                                                each s in ['draft', 'active', 'completed', 'cancelled']
                                                    option(value=s selected=campaign.status === s)= s.charAt(0).toUpperCase() + s.slice(1)
                                            small.form-text.text-muted Only Active campaigns are visible to customers

                            .row
                                .col-md-12
                                    .form-group
                                        label(for='description') Description
                                        textarea#description.form-control(name='description' rows='3' placeholder='Brief description of the campaign')= isEdit ? campaign.description : ''

                            .row
                                .col-md-12
                                    .form-group
                                        label(for='prize_description') Prize Description
                                        input#prize_description.form-control(type='text' name='prize_description' maxlength='255' placeholder='e.g., Free oil change, Rs. 500 voucher' value=isEdit ? campaign.prize_description : '')

                            .row
                                .col-md-12
                                    hr
                                    button#btnSubmit.btn.btn-primary(type='submit')
                                        i.fas.fa-save
                                        |  #{isEdit ? 'Save Changes' : 'Create Campaign'}
                                    |
                                    a.btn.btn-secondary(href='/campaigns') Cancel

    script.
        $(document).ready(function() {

            const isEdit = #{isEdit};
            const campaignId = #{isEdit ? campaign.id : 'null'};
            const submitLabel = isEdit ? 'Save Changes' : 'Create Campaign';

            // New campaigns can't start in the past
            if (!isEdit) {
                const today = new Date().toISOString().split('T')[0];
                $('#start_date').attr('min', today);
            }

            // End date can't be before start date
            $('#start_date').on('change', function() {
                const startDate = $(this).val();
                if (startDate) {
                    $('#end_date').attr('min', startDate);
                }
            }).trigger('change');

            // Form submission
            $('#campaignForm').on('submit', function(e) {
                e.preventDefault();

                // Disable submit button
                $('#btnSubmit').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                // Get form data
                const formData = {
                    name: $('#name').val(),
                    description: $('#description').val(),
                    start_date: $('#start_date').val(),
                    end_date: $('#end_date').val(),
                    prize_description: $('#prize_description').val()
                };
                if (isEdit) {
                    formData.status = $('#status').val();
                }

                // Submit via AJAX
                $.ajax({
                    url: isEdit ? '/campaigns/' + campaignId : '/campaigns',
                    method: isEdit ? 'PUT' : 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(response) {
                        if (response.success) {
                            if (isEdit) {
                                alert('Campaign updated successfully!');
                                window.location.href = '/campaigns';
                            } else {
                                alert('Campaign created successfully! Campaign Code: ' + response.campaignCode + '\n\nIt starts as Draft - add questions, then activate it from the campaign list.');

                                // Redirect to add questions page
                                window.location.href = '/campaigns/' + response.campaignId + '/questions';
                            }
                        } else {
                            alert('Error: ' + (response.error || 'Failed to save campaign'));
                            $('#btnSubmit').prop('disabled', false).html('<i class="fas fa-save"></i> ' + submitLabel);
                        }
                    },
                    error: function(xhr) {
                        let errorMsg = 'Failed to save campaign';
                        if (xhr.responseJSON && xhr.responseJSON.error) {
                            errorMsg = xhr.responseJSON.error;
                        }
                        alert('Error: ' + errorMsg);
                        $('#btnSubmit').prop('disabled', false).html('<i class="fas fa-save"></i> ' + submitLabel);
                    }
                });
            });

        });
