extends layout

block content
  style.
    .mhome { max-width: 560px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; padding-bottom: 24px; }
    .mhome-search { position: relative; }
    .mhome-search .bi { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #5b6470; font-size: 18px; pointer-events: none; }
    .mhome-search input { width: 100%; height: 50px; border: 1px solid #d5d9df; border-radius: 14px; padding: 0 14px 0 44px; font-size: 16px; background: #fff; }
    .mhome-search input:focus { outline: none; border: 2px solid #1d4ed8; padding-left: 43px; }
    .mhome-section { display: flex; flex-direction: column; gap: 10px; }
    .mhome-section-title { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #4b5563; }
    .mhome-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
    .mhome-tile { min-height: 92px; padding: 10px 4px 8px; border-radius: 14px; border: 1px solid #e3e6ea; background: #fff; display: flex; flex-direction: column; align-items: center; gap: 7px; color: #1f2328; text-decoration: none; cursor: pointer; }
    .mhome-tile:hover, .mhome-tile:focus { text-decoration: none; color: #1f2328; border-color: #b8bfc8; }
    .mhome-tile:active { background: #f4f5f7; }
    .mhome-chip { width: 42px; height: 42px; flex-shrink: 0; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
    .mhome-label { font-size: 12px; font-weight: 600; line-height: 1.25; text-align: center; word-break: break-word; }
    .mhome-section:not(.expanded) .mhome-extra { display: none; }
    .mhome-section.expanded .mhome-more { display: none; }
    .mhome-more { border-style: dashed; border-color: #b8bfc8; background: #fafbfc; justify-content: center; font-family: inherit; }
    .mhome-more .count { font-size: 18px; font-weight: 800; }
    .mhome-shift { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 16px; background: #212529; color: #fff; text-decoration: none; }
    .mhome-shift:hover, .mhome-shift:focus { color: #fff; text-decoration: none; background: #343a40; }
    .mhome-shift .mhome-chip { background: #f4d03f; color: #212529; }
    .mhome-shift-text { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; }
    .mhome-shift-text strong { font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mhome-shift-text small { color: #c9ced4; font-size: 13px; }
    .mhome-shift-cta { flex-shrink: 0; background: #f4d03f; color: #212529; font-weight: 800; font-size: 14px; padding: 8px 12px; border-radius: 10px; }
    .mhome-noshift { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px; border-radius: 16px; border: 1px solid #e3e6ea; background: #fff; color: #4b5563; font-size: 14px; }
    .mhome-noshift a { flex-shrink: 0; font-weight: 700; padding: 8px 12px; border-radius: 10px; background: #f4d03f; color: #212529; text-decoration: none; }
    .mhome-results { display: flex; flex-direction: column; border-radius: 14px; border: 1px solid #e3e6ea; background: #fff; overflow: hidden; }
    .mhome-result { min-height: 60px; padding: 8px 14px; border-bottom: 1px solid #eef0f3; display: flex; align-items: center; gap: 12px; color: #1f2328; text-decoration: none; }
    .mhome-result:hover, .mhome-result:focus { color: #1f2328; text-decoration: none; background: #f8f9fa; }
    .mhome-result .mhome-chip { width: 36px; height: 36px; font-size: 17px; border-radius: 10px; }
    .mhome-result-text { display: flex; flex-direction: column; min-width: 0; }
    .mhome-result-text strong { font-size: 15px; }
    .mhome-result-text small { font-size: 12px; color: #5b6470; }
    .mhome-empty { padding: 16px; color: #4b5563; font-size: 14px; }
    .mhome [hidden] { display: none !important; }
    @media (max-width: 360px) {
      .mhome-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

  .mhome
    .mhome-search
      i.bi.bi-search(aria-hidden="true")
      input#mhomeSearch(type="search" placeholder="Search screens…" aria-label="Search screens" autocomplete="off")

    //- Search results: one flat list of every screen, filtered as you type
    #mhomeResults.mhome-results(hidden)
      each g in menuGroups
        each it in g.items
          a.mhome-result(href=it.url data-search=(it.name + ' ' + g.name).toLowerCase())
            span.mhome-chip(style=`background:${g.bg};color:${g.fg}`)
              i.bi(class=it.icon aria-hidden="true")
            span.mhome-result-text
              strong= it.name
              small= g.name
      .mhome-empty#mhomeEmpty(hidden) No screen matches.

    #mhomeBrowse.mhome
      if canOpenShifts
        section.mhome-section
          .mhome-section-title Open shifts
          if openShifts.length
            each s in openShifts
              a.mhome-shift(href=`/edit-draft-closing?closingId=${s.closingId}`)
                span.mhome-chip
                  i.bi.bi-fuel-pump(aria-hidden="true")
                span.mhome-shift-text
                  strong= s.cashierName
                  small Draft · #{s.closingDate}
                span.mhome-shift-cta Continue
          else
            .mhome-noshift
              span No open shift right now.
              if canCreateShift
                a(href="/new-closing") Start shift
              else
                a(href="/home") View shifts

      each g in menuGroups
        - var many = g.items.length > 4
        section.mhome-section
          .mhome-section-title= g.name
          .mhome-grid
            each it, idx in g.items
              a.mhome-tile(href=it.url class=(many && idx >= 3 ? 'mhome-extra' : undefined))
                span.mhome-chip(style=`background:${g.bg};color:${g.fg}`)
                  i.bi(class=it.icon aria-hidden="true")
                span.mhome-label= it.name
            if many
              button.mhome-tile.mhome-more(type="button" aria-label=`Show all ${g.items.length} in ${g.name}`)
                span.count +#{g.items.length - 3}
                span.mhome-label more

  script.
    (function () {
      document.querySelectorAll('.mhome-more').forEach(function (btn) {
        btn.addEventListener('click', function () {
          btn.closest('.mhome-section').classList.add('expanded');
        });
      });

      var input = document.getElementById('mhomeSearch');
      var results = document.getElementById('mhomeResults');
      var browse = document.getElementById('mhomeBrowse');
      var empty = document.getElementById('mhomeEmpty');
      var rows = results.querySelectorAll('.mhome-result');
      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        if (!q) { results.hidden = true; browse.hidden = false; return; }
        var shown = 0;
        rows.forEach(function (r) {
          var hit = r.getAttribute('data-search').indexOf(q) !== -1;
          r.hidden = !hit;
          if (hit) shown++;
        });
        empty.hidden = shown > 0;
        results.hidden = false;
        browse.hidden = true;
      });
    })();
