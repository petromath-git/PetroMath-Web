extends layout

block content
    - const closed = invoiceStatus == 'CLOSED';
    - const inv = invoice || {};
    - const savedTaxType = inv.tax_type || 'CGST_SGST';
    - const savedDiscMode = inv.discount_mode || 'LINE';
    - const fmtNum = (v) => (v === null || v === undefined || v === '') ? '' : parseFloat(v).toFixed(2);

    style.
        #lubesInvoiceForm .pi-mark { display:inline-block; min-width:1.35em; height:1.35em; line-height:1.35em; border-radius:50%;
            background:#0d6efd; color:#fff; font-size:.75rem; font-weight:600; text-align:center; margin-right:.25rem; }
        #lubesInvoiceForm .pi-hint { display:block; font-size:.72rem; color:#6c757d; font-weight:400; line-height:1.15; margin-top:.15rem; }
        #invoice-items-table td, #invoice-items-table th { vertical-align: top; }
        #invoice-items-table th { white-space: nowrap; }
        #invoice-items-table .pi-qty-wrap { display:flex; gap:.25rem; }
        #invoice-items-table .pi-qty-wrap input { min-width:70px; }
        #invoice-items-table .pi-qty-wrap select { width:auto; }
        #invoice-items-table .pi-calc { font-size:.75rem; margin-top:.2rem; }
        #invoice-items-table .pi-warn { font-size:.75rem; color:#b45309; margin-top:.2rem; }
        #invoice-items-table .pi-free { font-size:.72rem; color:#198754; margin-top:.2rem; }
        #invoice-items-table .pi-ro { background:#f8f9fa; text-align:right; }
        #invoice-items-table input[type=number] { text-align:right; }
        #pi-help table { font-size:.78rem; background:#fff; }
        #pi-help td.pi-marked { background:#fff3cd; font-weight:600; }
        #pi-help ol { padding-left:0; list-style:none; }
        #pi-help ol li { margin-bottom:.35rem; }
        .pi-total-status.ok { color:#198754; font-weight:600; }
        .pi-total-status.bad { color:#dc3545; font-weight:600; }
        #pi-attachments .pi-att { display:flex; align-items:center; gap:.5rem; padding:.35rem 0; border-bottom:1px solid #eee; }
        #pi-attachments .pi-att img { width:56px; height:56px; object-fit:cover; border-radius:4px; border:1px solid #ddd; }
        /* Phones: each invoice line is an m-stack card (style.css STACKED TABLES);
           read-only figures stay plain text, not grey boxes */
        @media screen and (max-width: 767px) {
            #invoice-items-table td.pi-ro { background:transparent; text-align:left; }
            #invoice-items-table .pi-qty-wrap input { min-width:0; }
            #pi-help .card-header .form-inline { width:100%; }
            #pi-help #pi-format { flex:1; }
            body.mobile-ready #pi-totals td { font-size:.9rem !important; } /* beats the global .table-sm td 11px phone rule */
            body.mobile-ready #pi-totals .form-control { font-size:16px; }   /* stops iOS zooming on focus */
        }

    form#lubesInvoiceForm(onsubmit='return false;')
        if !isNew
            input(type='hidden' id='lubes_hdr_id' name='lubes_hdr_id' value=inv.lubes_hdr_id)

        if closed
            div.alert.alert-secondary.mb-3
                i.bi.bi-lock-fill.mr-1
                | This invoice is closed. It is shown exactly as saved.
                if isLegacy
                    |  It was entered before the new purchase screen.
        else if isLegacy && !isNew
            div.alert.alert-info.mb-3
                i.bi.bi-info-circle.mr-1
                | This draft was entered on the old screen. Check each line against the invoice — enter the printed total — then save.

        //- ── Header ──────────────────────────────────────────────────────
        div.card
            div.card-header.text-white.bg-dark.d-flex.justify-content-between.align-items-center
                h4.mb-0 Purchase Invoice
                if !closed
                    button#pi-help-toggle.btn.btn-sm.btn-outline-light(type='button')
                        i.bi.bi-question-circle.mr-1
                        | How to read my invoice
            div.card-body
                div.row
                    div.col-md-3.col-6
                        div.form-group
                            label(for='invoice_number') Invoice Number
                            input#invoice_number.form-control(type='text' name='invoice_number' required disabled=closed value=inv.invoice_number || '')
                    div.col-md-3.col-6
                        div.form-group
                            label(for='invoice_date') Invoice Date
                            input#invoice_date.form-control(type='date' name='invoice_date' required disabled=closed
                                value=invoice ? dateFormat(invoice.invoice_date, 'yyyy-mm-dd') : dateFormat(new Date(), 'yyyy-mm-dd'))
                    div.col-md-3.col-12
                        div.form-group
                            label(for='supplier_id') Supplier
                            select#supplier_id.form-control(name='supplier_id' required disabled=closed)
                                option(value='') Select Supplier
                                each supplier in suppliers
                                    option(value=supplier.supplier_id selected=inv.supplier_id == supplier.supplier_id)= supplier.supplier_name
                    div.col-md-3.col-12
                        div.form-group
                            label
                                span.pi-mark 7
                                | Tax on the invoice
                                span.pi-hint(data-hint='tax_type')
                            div.btn-group.btn-group-toggle.d-flex(data-toggle='buttons')
                                label.btn.btn-outline-secondary.btn-sm.flex-fill(class=[savedTaxType == 'CGST_SGST' ? 'active' : '', closed ? 'disabled' : ''])
                                    input(type='radio' name='tax_type' value='CGST_SGST' checked=savedTaxType == 'CGST_SGST' disabled=closed)
                                    | CGST + SGST
                                label.btn.btn-outline-secondary.btn-sm.flex-fill(class=[savedTaxType == 'IGST' ? 'active' : '', closed ? 'disabled' : ''])
                                    input(type='radio' name='tax_type' value='IGST' checked=savedTaxType == 'IGST' disabled=closed)
                                    | IGST
                    input(type='hidden' name='location_code' value=user.location_code)

        //- ── How to read your invoice (per oil company) ─────────────────
        if !closed
            div#pi-help.card.mt-3.border-primary(style='display:none')
                div.card-header.bg-light.d-flex.flex-wrap.justify-content-between.align-items-center
                    div
                        strong#pi-help-title
                        div.small.text-muted#pi-help-subtitle
                    div.form-inline.mt-2.mt-md-0
                        label.small.mr-2(for='pi-format') Invoice type
                        select#pi-format.form-control.form-control-sm
                            option(value='IOCL') IndianOil (SERVO)
                            option(value='BPCL') BPCL (MAK)
                            option(value='HPCL') HPCL (HP Lubes)
                            option(value='GENERIC') Other supplier
                        button#pi-help-close.btn.btn-sm.btn-link(type='button') Hide
                div.card-body
                    div.table-responsive
                        table.table.table-sm.table-bordered.mb-2#pi-help-sample
                    div.d-flex.flex-wrap.justify-content-end.small.mb-3#pi-help-footer
                    ol.mb-0#pi-help-steps

        //- ── Lines ───────────────────────────────────────────────────────
        div.card.mt-3
            div.card-header.text-white.bg-dark.d-flex.flex-wrap.justify-content-between.align-items-center
                h4.mb-0 Invoice Items
                if !closed
                    div.form-inline.small.mt-2.mt-md-0
                        span.mr-2 Discount:
                        div.custom-control.custom-radio.custom-control-inline
                            input#disc-mode-line.custom-control-input(type='radio' name='discount_mode' value='LINE' checked=savedDiscMode != 'TOTAL')
                            label.custom-control-label(for='disc-mode-line') per product
                        div.custom-control.custom-radio.custom-control-inline
                            input#disc-mode-total.custom-control-input(type='radio' name='discount_mode' value='TOTAL' checked=savedDiscMode == 'TOTAL')
                            label.custom-control-label(for='disc-mode-total') one total
                        input#total_line_discount.form-control.form-control-sm.ml-1(type='number' step='0.01' min='0' placeholder='Total discount'
                            style='width:130px' value=fmtNum(inv.total_line_discount))
            div.card-body.p-2.p-md-3
                div#pi-disc-total-note.alert.alert-warning.py-1.px-2.small(style='display:none')
                    | One total is split across products by value. Per-product cost will be estimated — use "per product" when the invoice shows each discount.
                div.table-responsive
                    table.table.table-bordered.table-sm.m-stack#invoice-items-table
                        thead.bg-light
                            tr
                                th #
                                th(style='min-width:220px') Product
                                th(style='min-width:170px')
                                    span.pi-mark 2
                                    | Quantity
                                    span.pi-hint(data-hint='qty')
                                th(style='min-width:110px')
                                    span.pi-mark 3
                                    | Amount
                                    span.pi-hint(data-hint='gross')
                                th.pi-col-disc(style='min-width:100px')
                                    span.pi-mark 4
                                    | Discount
                                    span.pi-hint(data-hint='discount')
                                th(style='min-width:80px') GST %
                                th.pi-col-optional Taxable
                                th.pi-col-optional GST
                                th Total
                                if !closed
                                    th
                        tbody
                if !closed
                    button#add-row-btn.btn.btn-secondary.btn-sm(type='button')
                        i.bi.bi-plus-lg.mr-1
                        | Add product

        //- ── Totals ──────────────────────────────────────────────────────
        div.row
            div.col-md-6
                div.card.mt-3
                    div.card-body
                        div.form-group
                            label(for='notes') Notes
                            textarea#notes.form-control(name='notes' rows='2' disabled=closed)= inv.notes || ''
                div#pi-attachments.card.mt-3
                    div.card-header.bg-light
                        strong
                            i.bi.bi-paperclip.mr-1
                            | Invoice copy
                        span.small.text-muted.ml-2 Photo or PDF for reference — up to #{maxAttachments} files, PDF max #{maxUploadMb} MB
                    div.card-body
                        div#pi-att-list
                        if isNew
                            div.small.text-muted Save the invoice first, then attach a photo or PDF of it.
                        else
                            div.mt-2#pi-att-actions
                                input#pi-att-file(type='file' accept='image/jpeg,image/png,application/pdf' style='display:none')
                                input#pi-att-camera(type='file' accept='image/*' capture='environment' style='display:none')
                                button#pi-att-upload-btn.btn.btn-outline-primary.btn-sm.mr-2(type='button')
                                    i.bi.bi-upload.mr-1
                                    | Upload file
                                button#pi-att-camera-btn.btn.btn-outline-primary.btn-sm(type='button')
                                    i.bi.bi-camera.mr-1
                                    | Take photo
                                div.small.mt-1#pi-att-status
            div.col-md-6
                div.card.mt-3
                    div.card-body
                        table.table.table-sm.mb-0#pi-totals
                            tbody
                                tr
                                    td Amount before discount
                                    td.text-right#t-gross 0.00
                                tr
                                    td Product discounts
                                    td.text-right#t-disc 0.00
                                tr
                                    td
                                        span.pi-mark 5
                                        | Cash discount
                                        span.pi-hint(data-hint='cash_discount')
                                    td.text-right
                                        input#cash_discount.form-control.form-control-sm.text-right.ml-auto(type='number' step='0.01' min='0' style='max-width:140px'
                                            name='cash_discount' disabled=closed value=fmtNum(inv.cash_discount) || '')
                                tr
                                    td Taxable value
                                    td.text-right#t-taxable 0.00
                                tr
                                    td#t-gst-label GST
                                    td.text-right#t-gst 0.00
                                tr.font-weight-bold
                                    td Total (calculated)
                                    td.text-right#t-lines 0.00
                                tr
                                    td
                                        span.pi-mark 6
                                        strong Total printed on invoice
                                        span.pi-hint(data-hint='printed_total')
                                    td.text-right
                                        input#printed_total.form-control.form-control-sm.text-right.ml-auto.font-weight-bold(type='number' step='0.01' min='0' style='max-width:140px'
                                            name='printed_total' disabled=closed value=fmtNum(inv.printed_total))
                                tr
                                    td(colspan='2')
                                        div.pi-total-status.text-right#t-status

        div#pi-errors.alert.alert-danger.mt-3(style='display:none')

        div.row.mt-3.mb-4
            div.col-12.text-center
                if !closed
                    button.btn.btn-primary.mr-2#save-btn(type='button')
                        i.bi.bi-save.mr-1
                        | Save Draft
                    button.btn.btn-dark.mr-2#close-btn(type='button' disabled)
                        i.bi.bi-lock.mr-1
                        | Save &amp; Close Invoice
                a.btn.btn-secondary(href='/lubes-invoice-home') Back to List

    //- Data for the screen script — JSON-encoded, with "<" escaped so no value can end the script tag
    - const pageData = { closed: closed, isNew: isNew, isLegacy: isLegacy, products: products, lines: invoiceLines, invoice: invoice ? { lubes_hdr_id: inv.lubes_hdr_id, printed_total: inv.printed_total, round_off: inv.round_off, invoice_amount: inv.invoice_amount } : null, locationOmc: locationOmc, supplierFormats: supplierFormats, formatHelp: formatHelp, gstRates: gstRates, attachments: attachments, maxAttachments: maxAttachments, maxUploadMb: maxUploadMb };
    script.
        window.PI_DATA = !{JSON.stringify(pageData).replace(/</g, '\\u003c')};

    script(src=`/javascripts/lube-invoice-calc.js?v=${CACHE_BUST}`)
    script(src=`/javascripts/lubes-invoice.js?v=${CACHE_BUST}`)
