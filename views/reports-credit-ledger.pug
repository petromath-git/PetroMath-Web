extends layout
include mixins/report-filters-mobile

block content
    form.report-filters(method='POST' action='/reports-credit-ledger')
        +reportFiltersMobile({ hasRange: true, hasResults: typeof creditstmt !== 'undefined' })
        script.
            function exportLedgerExcel() {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/reports-credit-ledger/excel';

                const fields = {
                    fromClosingDate: document.getElementById('fromclosingDate').value,
                    toClosingDate: document.getElementById('toclosingDate').value,
                    company_id: document.getElementById('company_id').value
                };

                Object.keys(fields).forEach(function(name) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = fields[name];
                    form.appendChild(input);
                });

                document.body.appendChild(form);
                form.submit();
                document.body.removeChild(form);
            }
        table.center
            tr
                td.rf-label.rf-range Date Range:
                td.rf-field.rf-range
                    select#dateRange.form-control(onchange="updateDateRange()")
                        option(value='this_month') This Month
                        option(value='last_month') Last Month
                        option(value='this_financial_year') This Financial Year
                        option(value='last_financial_year') Last Financial Year
                        option(value='custom', selected=true) Custom Date
                td.rf-gap &nbsp;                   
                td.rf-label.rf-from#fromDateLabel From Date:
                td.rf-field.rf-from
                    input#fromclosingDate.form-control(type='date', name='fromClosingDate', value=fromClosingDate, max=currentDate, format="dd/mm/yyyy", required)
                td.rf-gap &nbsp;                   
                td.rf-label.rf-to#toDateLabel To Date:
                td.rf-field.rf-to
                    input#toclosingDate.form-control(type='date', name='toClosingDate', value=toClosingDate, max=currentDate, format="dd/mm/yyyy", required)
                td.rf-gap &nbsp;
                td.rf-label Company Name:
                td.rf-field
                    select#company_id.form-control(name='company_id')
                        if credits
                            option(value=-1, selected=company_id === -1 ? true : undefined) All
                            each val in credits
                                option(value=`${val.id}`, selected=company_id == val.id ? true : undefined)= val.name
                include report-print-download.pug
                if enableCreditExcelDownload
                    td.rf-btn
                        button.btn.btn-success.mr-2(type='button', onClick='exportLedgerExcel()', title='Export Excel', data-toggle='tooltip', data-placement='top')
                            i.bi.bi-file-earmark-spreadsheet
                            span.rf-label-mobile  Excel
    div &nbsp;
    div
        if creditstmt && creditstmt.length > 0
            - var companyName = creditstmt[0].companyName
            - var cidparam = creditstmt[0].cidparam
            - function displayBalance(bal) { var fmt = new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); if (balanceCrDr) { var a = Math.abs(bal); var f = fmt.format(a); if (bal > 0) return f + ' DR'; if (bal < 0) return f + ' CR'; return '0.00'; } return fmt.format(bal); }
            div.row &nbsp;
            h6.font-weight-bold.text-center= "Credit Ledger"
            if(cidparam == -1)
                h5.font-weight-bold.text-center.text-uppercase= 'All Companies'
            else
                h5.font-weight-bold.text-center.text-uppercase= companyName                 
                h6.text-center.text-muted= `${formattedFromDate}   to   ${formattedToDate}`
            h4.font-weight-bold.text-success.text-center
            if statementNumber
                h6.text-center.text-muted= `Statement No: ${statementNumber}`
            .container
                .row.justify-content-center
                    .col-12
                        if(cidparam != -1 && showPeriodSummary && typeof totalDebits !== 'undefined' && typeof totalCredits !== 'undefined')
                            .alert.mb-4.period-summary(style="background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 8px; padding: 20px;")
                                div(style="font-size: 1.1em; color: #495057; line-height: 1.6;")
                                    div(style="text-align: center; margin-bottom: 15px;")
                                        strong(style="font-size: 1.2em; color: #212529;") Period Summary
                                    div(style="text-align: right; margin-bottom: 4px;")
                                        span(style="display: inline-block; width: 80px; text-align: right; padding-right: 10px;") Opening:
                                        span(style="font-weight: 600;")= displayBalance(openingbalance)
                                    div(style="text-align: right; margin-bottom: 4px;")
                                        span(style="display: inline-block; width: 80px; text-align: right; padding-right: 10px;") Invoices:
                                        span(style="font-weight: 600;") #{new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(totalDebits)}
                                    div(style="text-align: right; margin-bottom: 4px;")
                                        span(style="display: inline-block; width: 80px; text-align: right; padding-right: 10px;") Payments:
                                        span(style="font-weight: 600;") #{new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(totalCredits)}
                                    div(style="text-align: right; margin-bottom: 4px;")
                                        span(style="display: inline-block; width: 80px; text-align: right; padding-right: 10px;") Closing:
                                        span(style="color: #495057;font-weight: 600;")= displayBalance(closingbalance)
                        table.table.table-bordered.border.table-sm.credit-stmt-table
                            thead(class="thead-light")
                                tr
                                    th.text-center Date                        
                                    th.text-center Particulars                                              
                                    th.text-center Debit (Rs.)
                                    th.text-center Credit (Rs.)
                                    if showBalance
                                        th.text-center Balance (Rs.)
                                    th.text-center Narration
                            tbody
                                if(cidparam != -1)
                                    tr.stmt-balance-row
                                        td &nbsp;
                                        td.text-left.font-weight-bold Opening Balance
                                        td &nbsp;
                                        td &nbsp;
                                        td.text-right.font-weight-bold= displayBalance(openingbalance)
                                        if showBalance
                                            td &nbsp;
                                each val in creditstmt
                                    tr(class=(val.price === null ? 'font-weight-bold text-success' : ''))
                                        td.text-center(scope="row" data-label='Date')= val.Date                            
                                        td.text-left(scope="row" data-label='Particulars')= val.Particulars                                                        
                                        td.text-right(scope="row" data-label='Debit') #{val.Debit !== null ? new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(val.Debit) : ''}
                                        td.text-right(scope="row" data-label='Credit') #{val.Credit !== null ? new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(val.Credit) : ''}
                                        if showBalance
                                            td.text-right(scope="row" data-label='Balance')= val.Balance !== null ? displayBalance(val.Balance) : ''
                                        td.stmt-wide(scope="row" data-label='Narration')= val.Narration                                                        
                                if(totalDebits > 0 || totalCredits > 0)
                                    tr.bg-light.font-weight-bold.stmt-total-row
                                        td &nbsp;
                                        td.text-left Total
                                        td.text-right(data-label='Debit') #{new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(totalDebits)}
                                        td.text-right(data-label='Credit') #{new Intl.NumberFormat('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(totalCredits)}
                                        if showBalance
                                            td &nbsp;
                                        td &nbsp;
                                if(cidparam != -1)
                                    tr.stmt-balance-row
                                        td &nbsp;
                                        td.text-left.font-weight-bold Closing Balance
                                        td &nbsp;
                                        td &nbsp;
                                        td.text-right.font-weight-bold= displayBalance(closingbalance)
                                        if showBalance
                                            td &nbsp;
                        div.col-12.text-right E &amp; OE
                        div.col-12.text-center Any discrepencies in this report should be reported to the management within 2 days of the report being generated.                
        else
            div.row &nbsp;
            div.row.bg-light.report-empty(class=(typeof creditstmt === 'undefined' ? 'report-not-run' : undefined)) No Transactions.  

        // Include the overlay
        include overlay.pug

