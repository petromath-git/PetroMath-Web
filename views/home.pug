extends layout
include mixins/exshort-breakdown-mixin

block content
    //- Dev Environment Banner - shows if backup info exists
    if devBackupInfo
        .alert.alert-warning.alert-dismissible.fade.show.mb-3(role='alert' style='border-left: 4px solid #ff9800;')
            .d-flex.align-items-center
                i.bi.bi-exclamation-triangle-fill.me-2(style='font-size: 1.2rem;')
                div
                    strong 🔧 Development Environment
                    br
                    small.text-muted 
                        | Data snapshot from production: 
                        strong= new Date(devBackupInfo.backup_taken_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
            button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')


    style.
        /* Sticky header styling for home page */
        .table-responsive {
            max-height: calc(100vh - 350px);
            overflow-y: auto;
        }

        .action-btn.btn-reopen {
                background-color: #ffc107;
                color: #000;
            }

            .action-btn.btn-reopen:hover {
                background-color: #e0a800;
                color: #000;
            }
        
        .sticky-top {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #f8f9fa;
        }
        
        /* Ensure table header stays on top when scrolling */
        .table-desktop thead.thead-light {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #f8f9fa;
        }
        
        /* Day close header styling */
        .day-close-header td {
            padding: 8px 12px !important;
            font-weight: 500;
        }

        /* ---- Phone layout (sl- = shift list). Desktop keeps the table. ---- */
        .sl-phone-top, .sl-range { display: none; }
        @media (max-width: 768px) {
            .sl-phone-top { display: block; margin-bottom: 12px; }
            .sl-desktop-only { display: none; }
            .sl-new-btn {
                width: 100%; height: 50px; border: 0; border-radius: 12px;
                background: #f4d03f; color: #212529; font-size: 16px; font-weight: 700;
                display: flex; align-items: center; justify-content: center; gap: 8px;
            }
            .sl-new-btn:active { background: #e6c12f; }
            .sl-note {
                padding: 12px 14px; border-radius: 12px; background: #fff4e5;
                color: #8a4b00; font-size: 14px; font-weight: 600;
            }

            /* Filter: collapsed by default (script below), header shows the period */
            .sl-filter-title { display: none; }
            .sl-range { display: inline; font-weight: 600; }
            .filter-header { border-radius: 12px; }
            .card.mb-3 { border-radius: 12px; overflow: hidden; margin-bottom: 12px !important; }

            .sl-list { padding: 0; }
            .sl-cards .sl-card {
                background: #fff; border: 1px solid #e3e6ea; border-left: 4px solid #9aa3ad;
                border-radius: 12px; box-shadow: none; padding: 0; margin-bottom: 10px; transform: none;
            }
            .sl-cards .sl-card:hover { transform: none; box-shadow: none; }
            .sl-cards .sl-card.draft { border-left-color: #f4b400; }
            .sl-cards .sl-card.closed { border-left-color: #2e9d5b; }
            .sl-card-main { display: block; padding: 12px 14px 10px; color: #1f2328; text-decoration: none; }
            .sl-card-main:hover, .sl-card-main:focus { color: #1f2328; text-decoration: none; }
            .sl-card-main:active { background: #f6f7f9; }
            .sl-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
            .sl-cashier { font-size: 16px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
            .sl-status { flex-shrink: 0; font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 6px; background: #eef0f3; color: #3f4652; }
            .sl-status-draft { background: #fef3c7; color: #8a4b00; }
            .sl-status-closed { background: #dcfce7; color: #166534; }
            .sl-meta { display: flex; justify-content: space-between; align-items: center; margin-top: 2px; font-size: 13px; color: #5b6470; }
            .sl-open { font-weight: 700; color: #1d4ed8; display: inline-flex; align-items: center; gap: 2px; }
            .sl-qty { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
            .sl-chip { font-size: 13px; font-weight: 700; color: #1f2328; background: #f1f3f5; border-radius: 8px; padding: 4px 8px; white-space: nowrap; }
            .sl-chip-label { font-weight: 600; color: #5b6470; margin-right: 4px; }
            .sl-card-foot {
                display: flex; align-items: center; gap: 8px; padding: 8px 14px;
                border-top: 1px solid #eef0f3; font-size: 14px;
            }
            .sl-exshort { flex-grow: 1; font-weight: 700; }
            .sl-exshort a { color: inherit; }
            .sl-action { flex-shrink: 0; height: 36px; padding: 0 14px; border-radius: 8px; border: 1px solid #d5d9df; background: #fff; font-size: 14px; font-weight: 600; }
            .sl-action-delete { color: #b42318; }
            .sl-action-reopen { color: #8a4b00; }
            .sl-empty { margin: 0; padding: 24px 14px; border-radius: 12px; justify-content: center; color: #5b6470; }
        }

    - var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
    - var fmtDate = function (s) { var p = String(s || '').split('-'); return p.length === 3 ? p[2] + '-' + MONTHS[parseInt(p[1], 10) - 1] + '-' + p[0] : (s || ''); }
    - var fmtQty = function (n) { return parseFloat(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
    - var canAddNew = canCreateShiftClosing && draftsCnt < maxAllowedDrafts && draftDaysCnt <= 0

    //- Old drafts usually fall outside the default date range, so name them here
    mixin staleDraftList
        ul.mb-0.mt-1
            each d in (staleDrafts || [])
                li
                    a(href=`/edit-draft-closing?closingId=${d.closing_id}`) Shift ##{d.closing_id}
                    |  — #{d.closing_date_fmt}#{d.cashier_name ? ' (' + d.cashier_name + ')' : ''}
                    if user.isAdmin
                        |  ·
                        a.text-danger(href='#' onclick=`deleteClosing(${d.closing_id}); return false;`) Delete

    //- Phones only: the main action sits at the top instead of below the list
    if canCreateShiftClosing
        .sl-phone-top
            if canAddNew
                button.sl-new-btn(type='button' onclick='getNewClosingPage()')
                    i.bi.bi-plus-lg
                    | New shift closing
            else if draftDaysCnt > 0
                .sl-note
                    | Drafts have been open too long. Close or delete them to add a new shift.
                    +staleDraftList
            else
                .sl-note Max #{maxAllowedDrafts} drafts reached. Close one to add a new shift.

    // Collapsible Filter Section - Desktop & Mobile
    .card.mb-3
        .card-header.filter-header(style='cursor: pointer; background-color: #f8f9fa;' onclick='toggleFilters()')
            .d-flex.justify-content-between.align-items-center
                h6.mb-0
                    i.bi.bi-funnel.me-2
                    span.sl-filter-title Cashier Shift Filters
                    //- Phones: the filter starts collapsed, so show the period instead
                    span.sl-range #{fmtDate(fromClosingDate)} to #{fmtDate(toClosingDate)}
                i#filter-toggle-icon.bi.bi-chevron-down
        .filter-content.collapse.show#filterContent
            .card-body
                form#closingFilterForm(method='GET' action='/home')
                    .row.g-3
                        // Period Dropdown
                        .col-md-2.col-12
                            label.form-label(for='dateRange') Date Range:
                            select#dateRange.form-control(onchange='updateDateRange()')
                                option(value='today') Today
                                option(value='yesterday') Yesterday
                                option(value='this_week') This Week
                                option(value='this_month') This Month
                                option(value='last_month') Last Month
                                option(value='this_financial_year') This Financial Year
                                option(value='last_financial_year') Last Financial Year
                                option(value='custom' selected) Custom Date
                        
                        // From Date
                        .col-md-2.col-6
                            label.form-label(for='fromclosingDate') From Date:
                            input#fromclosingDate.form-control(
                                type='date' 
                                name='fromClosingDate' 
                                value=fromClosingDate 
                                max=currentDate
                                required
                            )
                        
                        // To Date
                        .col-md-2.col-6
                            label.form-label(for='toclosingDate') To Date:
                            input#toclosingDate.form-control(
                                type='date' 
                                name='toClosingDate' 
                                value=toClosingDate 
                                max=currentDate
                                required
                            )
                        
                        // Live Search
                        if canSearchClosings
                            .col-md-4.col-12
                                label.form-label(for='searchInput') Search:
                                input#searchInput.form-control(
                                    type='text' 
                                    placeholder='Search closings...' 
                                    oninput='searchClosingsTable()'
                                )
                            
                            // Go Button
                            .col-md-2.col-12.d-flex.align-items-end
                                button.btn.btn-primary.w-100(type='submit')
                                    i.bi.bi-search.me-2
                                    | Go
                        else
                            // For users without search permission
                            .col-md-2.col-12.d-flex.align-items-end
                                button.btn.btn-primary.w-100(type='submit')
                                    i.bi.bi-search.me-2
                                    | Go

    div.sl-desktop-only &nbsp;

    div.container-fluid.sl-list
        if closingValues && closingValues.length > 0
            // Reverted back to simple table.table (like original)
            .table-responsive
                table.table.table-desktop(style="width:100% !important;")
                    thead.thead-light.sticky-top
                        tr
                            th Date
                            th Closing ID
                            th Cashier
                            if productColumns && productColumns.length > 0
                                each column in productColumns
                                    th= column.label
                                    if showTestingSummary === 'Y' && column.type === 'pump'
                                        th= column.label + ' (T)'
                            else
                                th MS
                                th HSD
                                th XMS
                                th 2T Loose
                            th Shortage/Excess
                            th Status
                            th Edit/View
                            th Delete
                    tbody
                        - var currentDayClose = null
                        - var colorIndex = 0
                        - var dayCloseColors = ['#f0f8ff', '#fff5f0', '#f0fff0', '#fff0f5', '#f5f5dc']
                        each val in closingValues
                            - var canReopenShift = !val.cashflowId || val.cashflowStatus === 'DRAFT'
                            - var dayCloseChanged = showDayCloseGrouping === 'Y' ? (val.dayCloseDate !== currentDayClose) : false
                            - if (dayCloseChanged) { currentDayClose = val.dayCloseDate; if (val.dayCloseDate) colorIndex = (colorIndex + 1) % dayCloseColors.length; }
                            - var rowBgColor = showDayCloseGrouping === 'Y' && val.dayCloseDate ? dayCloseColors[colorIndex] : (showDayCloseGrouping && !val.dayCloseDate ? '#f5f5f5' : '')
                            
                            if showDayCloseGrouping === 'Y' && dayCloseChanged && val.dayCloseDate
                                tr.day-close-header(style=`background-color: ${rowBgColor}; border-top: 2px solid #dee2e6;`)
                                    td(colspan="100%")
                                        small.text-muted
                                            i.bi.bi-calendar-check.me-1
                                            strong Day Close: #{val.dayCloseDate}
                            
                            tr(id=`closing-record-${val.closingId}` style=rowBgColor ? `background-color: ${rowBgColor};` : '' data-original-bg=rowBgColor)
                                td
                                    span= val.closingDate
                                td
                                    span= val.closingId
                                td
                                    span= val.cashierName
                                if productColumns && productColumns.length > 0
                                    each column in productColumns
                                        td
                                            span= parseFloat(val[column.key] || 0).toFixed(2)
                                        if showTestingSummary === 'Y' && column.type === 'pump'
                                            td
                                                span= parseFloat(val['test_' + column.key] || 0).toFixed(2)
                                else
                                    td
                                        span= val.msData || '0.00'
                                    td
                                        span= val.hsdData || '0.00'
                                    td
                                        span= val.xmsData || '0.00'
                                    td
                                        span= val.l2tData || '0.00'
                                td
                                    +exShortBreakdownLink(`showExShortBreakdown(${val.closingId});`)
                                        if val.expenseData && val.expenseData != 0
                                            if val.expenseData > 0
                                                strong.text-success= '+' + parseFloat(val.expenseData).toFixed(2)
                                            else
                                                strong.text-danger= parseFloat(val.expenseData).toFixed(2)
                                        else
                                            strong.text-muted 0.00
                                td
                                    if val.closingStatus === 'CLOSED'
                                        span.badge.badge-success Closed
                                    else if val.closingStatus === 'DRAFT'
                                        span.badge.badge-warning Draft
                                    else
                                        span.badge.badge-info= val.closingStatus
                                if (val.closingStatus === 'DRAFT')
                                    td
                                        a.btn.btn-info(href='/edit-draft-closing?closingId='+val.closingId)
                                            span.oi.oi-pencil
                                    if user.isAdmin
                                        td
                                            a.btn.btn-danger(onClick=`deleteClosing(${val.closingId})`)
                                                span.oi.oi-trash
                                if (val.closingStatus === 'CLOSED')
                                    td
                                        a.btn.btn-info(href='/edit-draft-closing?closingId='+val.closingId)
                                            span.oi.oi-book
                                    td
                                        // Reopen button - SuperUser/PowerUser always have access, Admin needs config permission
                                        - var canReopen = (user.Role === 'SuperUser') || (user.Role === 'PowerUser') || (user.Role === 'Admin' && allowShiftReopen === 'Y')
                                        if canReopen && canReopenShift
                                            button.btn.btn-warning(onClick=`reopenShift(${val.closingId})`)
                                                span.oi.oi-action-undo
                                        else
                                            span &nbsp;                                            
                        if closingValues.length > 1
                            tr.table-info
                                td.strong Total
                                td -
                                td -
                                if productColumns && productColumns.length > 0
                                    each column in productColumns
                                        td
                                            - var total = 0
                                            each val in closingValues
                                                - total += parseFloat(val[column.key] || 0)
                                            strong= total.toFixed(2)
                                        if showTestingSummary === 'Y' && column.type === 'pump'
                                            td
                                                - var testTotal = 0
                                                each val in closingValues
                                                    - testTotal += parseFloat(val['test_' + column.key] || 0)
                                                strong= testTotal.toFixed(2)
                                else
                                    td
                                        - var msTotal = 0
                                        each val in closingValues
                                            - msTotal += parseFloat(val.msData || 0)
                                        strong= msTotal.toFixed(2)
                                    td
                                        - var hsdTotal = 0
                                        each val in closingValues
                                            - hsdTotal += parseFloat(val.hsdData || 0)
                                        strong= hsdTotal.toFixed(2)
                                    td
                                        - var xmsTotal = 0
                                        each val in closingValues
                                            - xmsTotal += parseFloat(val.xmsData || 0)
                                        strong= xmsTotal.toFixed(2)
                                    td
                                        - var l2tTotal = 0
                                        each val in closingValues
                                            - l2tTotal += parseFloat(val.l2tData || 0)
                                        strong= l2tTotal.toFixed(2)
                                td -
                                td -
                                td -
                                td -

            // Mobile cards layout - ONLY visible on mobile
            //- Phones only (CSS): one compact card per shift; tap the card to open it
            .mobile-cards-container.sl-cards(style="display: none;")
                each val in closingValues
                    - var canReopenShift = !val.cashflowId || val.cashflowStatus === 'DRAFT'
                    - var isDraft = val.closingStatus === 'DRAFT'
                    - var canReopen = (user.Role === 'SuperUser') || (user.Role === 'PowerUser') || (user.Role === 'Admin' && allowShiftReopen === 'Y')
                    - var showDelete = isDraft && user.isAdmin
                    - var showReopen = !isDraft && canReopen && canReopenShift
                    - var exShort = parseFloat(val.expenseData || 0)
                    //- Same quantities as the desktop columns, zero ones left out
                    - var qty = []
                    if productColumns && productColumns.length > 0
                        each column in productColumns
                            - qty.push({ label: column.label, value: val[column.key] })
                            if showTestingSummary === 'Y' && column.type === 'pump'
                                - qty.push({ label: column.label + ' (T)', value: val['test_' + column.key] })
                    else
                        - qty = [{ label: 'MS', value: val.msData }, { label: 'HSD', value: val.hsdData }, { label: 'XMS', value: val.xmsData }, { label: '2T Loose', value: val.l2tData }]
                    - qty = qty.filter(function (q) { return parseFloat(q.value || 0) > 0; })

                    .sl-card.closing-card(class=isDraft ? 'draft' : 'closed')
                        a.sl-card-main(href=`/edit-draft-closing?closingId=${val.closingId}` aria-label=`${isDraft ? 'Edit' : 'View'} shift ${val.closingId} of ${val.cashierName}`)
                            .sl-card-top
                                span.sl-cashier= val.cashierName
                                if isDraft
                                    span.sl-status.sl-status-draft Draft
                                else if val.closingStatus === 'CLOSED'
                                    span.sl-status.sl-status-closed Closed
                                else
                                    span.sl-status= val.closingStatus
                            .sl-meta
                                span #{val.closingDate} · ##{val.closingId}
                                span.sl-open
                                    | #{isDraft ? 'Edit' : 'View'}
                                    i.bi.bi-chevron-right
                            if qty.length
                                .sl-qty
                                    each q in qty
                                        span.sl-chip
                                            span.sl-chip-label= q.label
                                            | #{fmtQty(q.value)}
                        if exShort !== 0 || showDelete || showReopen
                            .sl-card-foot
                                if exShort !== 0
                                    span.sl-exshort(class=exShort > 0 ? 'text-success' : 'text-danger')
                                        +exShortBreakdownLink(`showExShortBreakdown(${val.closingId});`)
                                            | #{exShort > 0 ? 'Excess' : 'Shortage'} #{Math.abs(exShort).toFixed(2)}
                                else
                                    span.sl-exshort
                                if showDelete
                                    button.sl-action.sl-action-delete(type='button' onClick=`deleteClosing(${val.closingId})`) Delete
                                if showReopen
                                    button.sl-action.sl-action-reopen(type='button' onClick=`reopenShift(${val.closingId})`) Reopen
        else
            div.row.bg-light.sl-empty No records to display.

        //- On phones this is hidden and the button at the top is used instead;
        //- the form stays in the page because that button submits it
        if canCreateShiftClosing
            .sl-desktop-only
                if draftsCnt < maxAllowedDrafts && draftDaysCnt <= 0
                    form(method='GET' action='/new-closing' id='get-new-closing')
                        button.btn.btn-primary(type='button' onclick='getNewClosingPage()') Add New
                else if draftDaysCnt > 0
                    .alert.alert-warning.text-danger
                        div Note: These draft shifts are open for too long. Please close or delete them to add a new closing.
                        +staleDraftList
                else
                    pre.text-danger.bg-warning Note: Cannot allow to add new closings, max #{maxAllowedDrafts} allowed drafts are met.
                .mb-4

        if deadlineMessage && deadlineMessage.length > 0
            .deadline-section
                .deadline-header Important Deadlines
                table.table#deadlineWarning-table
                    thead.thead-light
                        tr
                            th Deadline Date
                            th Message
                    tbody
                        each val, index in deadlineMessage
                            tr(id="deadlineWarning_row_"+index)
                                td(scope="row")= val.deadlineDate
                                td(scope="row")= val.message
    
    script(src=`/javascripts/app-report-date.js?v=${CACHE_BUST}`)
    if showExShortBreakdown
        script(src=`/javascripts/exshort-breakdown.js?v=${CACHE_BUST}`)

    script.
        // Phones: start with the filter collapsed so the shifts come first
        if (window.matchMedia('(max-width: 768px)').matches) {
            var fc = document.getElementById('filterContent');
            if (fc && fc.classList.contains('show')) toggleFilters();
        }

        // Toggle filter collapse
        function toggleFilters() {
            const filterContent = document.getElementById('filterContent');
            const icon = document.getElementById('filter-toggle-icon');
            
            if (filterContent.classList.contains('show')) {
                filterContent.classList.remove('show');
                icon.classList.remove('bi-chevron-down');
                icon.classList.add('bi-chevron-up');
            } else {
                filterContent.classList.add('show');
                icon.classList.remove('bi-chevron-up');
                icon.classList.add('bi-chevron-down');
            }
        }

        function reopenShift(closingId) {
            if (!confirm('Are you sure you want to reopen this shift? It will change status back to DRAFT.')) {
                return;
            }

            fetch('/reopen-shift?id=' + closingId, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert('Error: ' + data.error);
                } else {
                    alert(data.message);
                    location.reload();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while reopening the shift.');
            });
        }

        // Live search function for closings table with dynamic totals recalculation
        function searchClosingsTable() {
            const searchInput = document.getElementById('searchInput');
            if (!searchInput) return;
            
            const searchValue = searchInput.value.toLowerCase();
            
            // Search in desktop table
            const desktopTable = document.querySelector('.table-desktop');
            if (desktopTable) {
                const thead = desktopTable.querySelector('thead');
                const tbody = desktopTable.querySelector('tbody');
                const rows = tbody.getElementsByTagName('tr');
                const totalRow = tbody.querySelector('tr.table-info');
                
                // Count total columns and identify product columns dynamically
                const headerCells = thead.querySelectorAll('th');
                const totalColumns = headerCells.length;
                
                // Product columns are after: Date(0), Closing ID(1), Cashier(2)
                // and before: Shortage/Excess(-4), Status(-3), Edit/View(-2), Delete(-1)
                const productStartIndex = 3;
                const productEndIndex = totalColumns - 4;
                const productColumnCount = productEndIndex - productStartIndex;
                
                // Initialize totals array for product columns
                const totals = new Array(productColumnCount).fill(0);
                let visibleCount = 0;
                
                // Hide all day close header rows when searching
                const dayCloseHeaders = tbody.querySelectorAll('tr.day-close-header');
                dayCloseHeaders.forEach(header => {
                    header.style.display = searchValue ? 'none' : '';
                });
                
                for (let i = 0; i < rows.length; i++) {
                    const row = rows[i];
                    
                    // Skip total row and day close header rows
                    if (row.classList.contains('table-info') || row.classList.contains('day-close-header')) {
                        continue;
                    }
                    
                    const cells = row.getElementsByTagName('td');
                    let found = false;
                    
                    // Search through all cells
                    for (let j = 0; j < cells.length; j++) {
                        const cellText = cells[j].textContent || cells[j].innerText;
                        if (cellText.toLowerCase().indexOf(searchValue) > -1) {
                            found = true;
                            break;
                        }
                    }
                    
                    if (found) {
                        row.style.display = '';
                        visibleCount++;
                        
                        // Remove background color when searching
                        if (searchValue) {
                            row.style.backgroundColor = '';
                        } else {
                            // Restore original background color when search is cleared
                            const originalBgColor = row.getAttribute('data-original-bg');
                            if (originalBgColor) {
                                row.style.backgroundColor = originalBgColor;
                            }
                        }
                        
                        // Add product values to totals
                        for (let j = productStartIndex; j < productEndIndex; j++) {
                            const cellValue = parseFloat(cells[j].textContent) || 0;
                            const totalIndex = j - productStartIndex;
                            totals[totalIndex] += cellValue;
                        }
                    } else {
                        row.style.display = 'none';
                    }
                }
                
                // Update total row if it exists
                if (totalRow) {
                    if (visibleCount > 0) {
                        const totalCells = totalRow.getElementsByTagName('td');
                        
                        // Update each product total
                        // Total row structure: Total(0), -(1), -(2), product1(3), product2(4), ..., -(last 4 columns)
                        for (let i = 0; i < productColumnCount; i++) {
                            const totalCellIndex = productStartIndex + i;
                            
                            if (totalCells[totalCellIndex]) {
                                const strongTag = totalCells[totalCellIndex].querySelector('strong');
                                if (strongTag) {
                                    strongTag.textContent = totals[i].toFixed(2);
                                }
                            }
                        }
                        totalRow.style.display = '';
                    } else {
                        totalRow.style.display = 'none';
                    }
                }
            }
            
            // Search in mobile cards
            const mobileCards = document.querySelectorAll('.mobile-cards-container .closing-card');
            mobileCards.forEach(card => {
                const cardText = card.textContent || card.innerText;
                if (cardText.toLowerCase().indexOf(searchValue) > -1) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }
