extends layout

block content
    include mixins/dev-tracker-style
    - var typeBadge = { Bug: 'danger', Feature: 'primary', Enhancement: 'info', Task: 'secondary' }
    - var statusBadge = { 'Open': 'warning', 'In Progress': 'info', 'Testing': 'primary', 'Complete': 'success', 'Closed': 'secondary' }
    - var priorityBadge = { Critical: 'danger', High: 'warning', Medium: 'info', Low: 'secondary' }
    - var typeLabel = { Bug: 'Issue', Feature: 'Feature request', Enhancement: 'Enhancement', Task: 'Task' }
    .container-fluid.ticket-page
        .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3
            div
                h2.mb-1
                    i.bi.bi-life-preserver.mr-2
                    | Support Tickets
                p.text-muted.mb-0 Issues and feature requests from the stations
            .d-flex.gap-2
                if canManage
                    a.btn.btn-outline-secondary(href="/dev-tracker/hours")
                        i.bi.bi-stopwatch.mr-1
                        | Hours
                a.btn.btn-primary(href="/dev-tracker/new")
                    i.bi.bi-plus-circle.mr-1
                    | New Ticket

        .row.g-2.mb-3
            each s in [['Open', stats.open, 'warning'], ['In Progress', stats.inProgress, 'info'], ['Testing', stats.testing, 'primary'], ['Complete', stats.complete, 'success']]
                .col-6.col-lg-3
                    a.card.stat-card.text-decoration-none(href=`/dev-tracker?status=${encodeURIComponent(s[0])}` class=`border-${s[2]}`)
                        .card-body.py-2.text-center
                            h4.mb-0= s[1]
                            small.text-muted= s[0]

        - var hasFilters = filters.search || filters.status || filters.type || filters.location_code || filters.scope || filters.hours || filters.tokens
        button.btn.btn-outline-secondary.btn-sm.w-100.mb-2.d-md-none(type="button" data-toggle="collapse" data-target="#ticketFilters")
            i.bi.bi-funnel.mr-1
            | Filters
            if hasFilters
                span.badge.badge-primary.ml-1 on
        form.card.card-body.mb-3.collapse.d-md-block#ticketFilters(method="GET" action="/dev-tracker" class=hasFilters ? 'show' : '')
            .row.g-2.align-items-end
                .col-12.col-md-3
                    label.small Search
                    input.form-control.form-control-sm(type="text" name="search" value=filters.search placeholder="Title or description")
                .col-6.col-md-2
                    label.small Status
                    select.form-control.form-control-sm(name="status")
                        option(value="") Active (not closed)
                        each st in ['Open', 'In Progress', 'Testing', 'Complete', 'Closed']
                            option(value=st selected=(filters.status === st))= st
                .col-6.col-md-2
                    label.small Type
                    select.form-control.form-control-sm(name="type")
                        option(value="") All
                        each t in ['Bug', 'Feature', 'Enhancement', 'Task']
                            option(value=t selected=(filters.type === t))= typeLabel[t]
                .col-6.col-md-2
                    label.small Station
                    select.form-control.form-control-sm(name="location_code")
                        option(value="") All my stations
                        each loc in locations
                            option(value=loc.location_code selected=(filters.location_code === loc.location_code))= loc.location_code
                        if canManage
                            option(value="NONE" selected=(filters.location_code === 'NONE')) Platform (no station)
                if canManage
                    .col-6.col-md-2
                        label.small Scope
                        select.form-control.form-control-sm(name="scope")
                            option(value="") All
                            option(value="LOCATION" selected=(filters.scope === 'LOCATION')) Station request
                            option(value="ALL" selected=(filters.scope === 'ALL')) All locations
                    .col-6.col-md-2
                        label.small Hours
                        select.form-control.form-control-sm(name="hours")
                            option(value="") All
                            each r, key in hoursRanges
                                option(value=key selected=(filters.hours === key))= r.label
                if isSuperUser
                    .col-6.col-md-2
                        label.small Claude tokens
                        select.form-control.form-control-sm(name="tokens")
                            option(value="") All
                            each r, key in tokenRanges
                                option(value=key selected=(filters.tokens === key))= r.label
                .col-12.col-md-1.d-flex.gap-1
                    button.btn.btn-sm.btn-primary.flex-fill(type="submit") Go
                    a.btn.btn-sm.btn-outline-secondary(href="/dev-tracker" title="Clear")
                        i.bi.bi-x-lg

        if trackers && trackers.length > 0
            .card
                .table-responsive-md
                    table.table.table-hover.table-sm.mb-0.m-stack.ticket-table
                        thead.thead-light
                            tr
                                th.text-right #
                                th Title
                                th Type
                                th Status
                                th Station
                                if canManage
                                    th Priority
                                th Raised on
                                th Raised by
                                if canManage
                                    th.text-right Tasks
                                    th.text-right Hours
                                if isSuperUser
                                    th.text-right(title="Claude tokens") Tokens
                                    th.text-right(title="Claude cost at API list price") Cost
                                th.text-center(title="Attachments")
                                    i.bi.bi-paperclip
                        tbody
                            each tracker in trackers
                                - var files = attachmentCount[tracker.tracker_id] || 0
                                tr.ticket-row(data-href=`/dev-tracker/${tracker.tracker_id}` class=`priority-${tracker.priority.toLowerCase()}`)
                                    td.text-right.text-muted.m-hide ##{tracker.tracker_id}
                                    td.m-title
                                        a.text-body(href=`/dev-tracker/${tracker.tracker_id}`)
                                            span.text-muted.d-md-none ##{tracker.tracker_id}&nbsp;
                                            = tracker.title
                                    td(data-label="Type")= typeLabel[tracker.type] || tracker.type
                                    td(data-label="Status")
                                        span.badge(class=`badge-${statusBadge[tracker.status] || 'secondary'}`)= tracker.status
                                    td.text-nowrap(data-label="Station")
                                        = tracker.location_code || 'Platform'
                                        if tracker.scope === 'ALL'
                                            span.text-muted.small  (all)
                                    if canManage
                                        td(data-label="Priority")
                                            span(class=`text-${priorityBadge[tracker.priority]} font-weight-bold`)= tracker.priority
                                    td.text-nowrap(data-label="Raised on")= fmtDate(tracker.creation_date)
                                    td(data-label="Raised by")= tracker.created_by
                                    if canManage
                                        td.text-right(data-label="Tasks")
                                            if tracker.tasks && tracker.tasks.length
                                                | #{tracker.tasks.filter(t => t.task_status === 'Done').length}/#{tracker.tasks.length}
                                            else
                                                span.text-muted -
                                        td.text-right(data-label="Hours")= tracker.actual_hours ? Number(tracker.actual_hours) : '-'
                                    if isSuperUser
                                        td.text-right.text-nowrap(data-label="Tokens")= tracker.claude_tokens ? `${(Number(tracker.claude_tokens) / 1e6).toFixed(1)}M` : '-'
                                        td.text-right.text-nowrap(data-label="Cost")= tracker.claude_cost_usd ? `$${Number(tracker.claude_cost_usd).toFixed(2)}` : '-'
                                    td.text-center(data-label="Files" class=files ? '' : 'm-hide')
                                        if files
                                            i.bi.bi-paperclip
                                            | #{files}
            script.
                document.querySelectorAll('.ticket-table tr[data-href]').forEach(function (row) {
                    row.addEventListener('click', function (e) {
                        if (e.target.closest('a, button')) return;
                        window.location.href = row.getAttribute('data-href');
                    });
                });
        else
            .card.card-body.text-center.text-muted.py-5
                i.bi.bi-inbox.display-4
                p.mt-2.mb-0 No tickets found

