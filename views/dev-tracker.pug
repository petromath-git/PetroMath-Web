extends layout

block content
    include mixins/dev-tracker-style
    - var typeBadge = { Bug: 'danger', Feature: 'primary', Enhancement: 'info', Task: 'secondary' }
    - var statusBadge = { 'Open': 'warning', 'In Progress': 'info', 'Testing': 'primary', 'Complete': 'success', 'Closed': 'secondary' }
    - var priorityBadge = { Critical: 'danger', High: 'warning', Medium: 'info', Low: 'secondary' }
    - var typeLabel = { Bug: 'Issue', Feature: 'Feature request', Enhancement: 'Enhancement', Task: 'Task' }
    .container-fluid.ticket-page
        .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-3
            div
                h2.mb-1
                    i.bi.bi-life-preserver.mr-2
                    | Support Tickets
                p.text-muted.mb-0 Issues and feature requests from the stations
            .d-flex.gap-2
                if canManage
                    a.btn.btn-outline-secondary(href="/dev-tracker/hours")
                        i.bi.bi-stopwatch.mr-1
                        | Hours
                a.btn.btn-primary(href="/dev-tracker/new")
                    i.bi.bi-plus-circle.mr-1
                    | New Ticket

        .row.g-2.mb-3
            each s in [['Open', stats.open, 'warning'], ['In Progress', stats.inProgress, 'info'], ['Testing', stats.testing, 'primary'], ['Complete', stats.complete, 'success']]
                .col-6.col-lg-3
                    a.card.stat-card.text-decoration-none(href=`/dev-tracker?status=${encodeURIComponent(s[0])}` class=`border-${s[2]}`)
                        .card-body.py-2.text-center
                            h4.mb-0= s[1]
                            small.text-muted= s[0]

        - var hasFilters = filters.search || filters.status || filters.type || filters.location_code || filters.scope
        button.btn.btn-outline-secondary.btn-sm.w-100.mb-2.d-md-none(type="button" data-toggle="collapse" data-target="#ticketFilters")
            i.bi.bi-funnel.mr-1
            | Filters
            if hasFilters
                span.badge.badge-primary.ml-1 on
        form.card.card-body.mb-3.collapse.d-md-block#ticketFilters(method="GET" action="/dev-tracker" class=hasFilters ? 'show' : '')
            .row.g-2.align-items-end
                .col-12.col-md-3
                    label.small Search
                    input.form-control.form-control-sm(type="text" name="search" value=filters.search placeholder="Title or description")
                .col-6.col-md-2
                    label.small Status
                    select.form-control.form-control-sm(name="status")
                        option(value="") Active (not closed)
                        each st in ['Open', 'In Progress', 'Testing', 'Complete', 'Closed']
                            option(value=st selected=(filters.status === st))= st
                .col-6.col-md-2
                    label.small Type
                    select.form-control.form-control-sm(name="type")
                        option(value="") All
                        each t in ['Bug', 'Feature', 'Enhancement', 'Task']
                            option(value=t selected=(filters.type === t))= typeLabel[t]
                .col-6.col-md-2
                    label.small Station
                    select.form-control.form-control-sm(name="location_code")
                        option(value="") All my stations
                        each loc in locations
                            option(value=loc.location_code selected=(filters.location_code === loc.location_code))= loc.location_code
                        if canManage
                            option(value="NONE" selected=(filters.location_code === 'NONE')) Platform (no station)
                if canManage
                    .col-6.col-md-2
                        label.small Scope
                        select.form-control.form-control-sm(name="scope")
                            option(value="") All
                            option(value="LOCATION" selected=(filters.scope === 'LOCATION')) Station request
                            option(value="ALL" selected=(filters.scope === 'ALL')) All locations
                .col-12.col-md-1.d-flex.gap-1
                    button.btn.btn-sm.btn-primary.flex-fill(type="submit") Go
                    a.btn.btn-sm.btn-outline-secondary(href="/dev-tracker" title="Clear")
                        i.bi.bi-x-lg

        if trackers && trackers.length > 0
            .card
                .list-group.list-group-flush
                    each tracker in trackers
                        a.list-group-item.list-group-item-action.ticket-row(href=`/dev-tracker/${tracker.tracker_id}` class=`priority-${tracker.priority.toLowerCase()}`)
                            .d-flex.justify-content-between.align-items-start.gap-2
                                .flex-grow-1(style="min-width:0")
                                    .font-weight-bold.text-truncate
                                        span.text-muted.mr-1 ##{tracker.tracker_id}
                                        = tracker.title
                                    .d-flex.flex-wrap.gap-1.mt-1.small
                                        span.badge(class=`badge-${typeBadge[tracker.type] || 'secondary'}`)= typeLabel[tracker.type] || tracker.type
                                        span.badge(class=`badge-${statusBadge[tracker.status] || 'secondary'}`)= tracker.status
                                        span.badge.badge-light.border
                                            i.bi.bi-geo-alt.mr-1
                                            = tracker.location_code || 'Platform'
                                        if tracker.scope === 'ALL'
                                            span.badge.badge-dark All locations
                                        if canManage
                                            span.badge(class=`badge-${priorityBadge[tracker.priority]}`)= tracker.priority
                                            if tracker.tasks && tracker.tasks.length
                                                span.badge.badge-light.border #{tracker.tasks.filter(t => t.task_status === 'Done').length}/#{tracker.tasks.length} tasks
                                .text-right.small.text-muted.text-nowrap
                                    div= fmtDate(tracker.creation_date)
                                    div= tracker.created_by
                                    if canManage && tracker.actual_hours
                                        div #{Number(tracker.actual_hours)} h
        else
            .card.card-body.text-center.text-muted.py-5
                i.bi.bi-inbox.display-4
                p.mt-2.mb-0 No tickets found

