extends layout
include mixins/card-toggle-mobile

block content
    style.
        @media (max-width: 767px) {
            /* cards sit on the page, not inside another bordered box */
            .tr-history { border: 0; background: transparent; }
            .tr-history > .card-header { background: transparent; border: 0; padding: 0 0 .5rem; }
            .tr-history > .card-header form { width: 100%; }
            .tr-history > .card-header form select { flex: 1 1 auto; }
            /* open card: show the columns desktop hides below lg, drop the summary copy */
            .tr-table tr.card-open > td.d-none { display: block !important; }
            .tr-table tr.card-open > td.m-summary { display: none !important; }
            .tr-table .tr-sum-date { display: block; font-size: .85rem; white-space: nowrap; }
            .tr-table .tr-sum-amt { display: block; font-size: .75rem; color: #6c757d; white-space: nowrap; }
        }
    - const fmtAmt = (n) => Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    - const ranges = [['this_week', 'This Week'], ['this_month', 'This Month'], ['last_month', 'Last Month'], ['this_financial_year', 'This Financial Year'], ['last_financial_year', 'Last Financial Year'], ['custom', 'Custom Dates']];
    - const isCustom = range === 'custom';

    //- ── Page header: creating a receipt is a separate action from browsing history ──
    div.d-flex.flex-wrap.justify-content-between.align-items-center.mb-3
        h4.my-1 Tank Receipts
        if(user.isAdmin)
            form.my-1(method='GET' action='/new-decant' id='get-new-decant')
                button.btn.btn-primary(type='button' onclick='getNewDecantPage()')
                    span.oi.oi-plus
                    span &nbsp;New Tank Receipt

    //- ── Receipt History ──
    div.card.tr-history
        div.card-header.d-flex.flex-wrap.justify-content-between.align-items-center
            strong.my-1 Receipt History
            form.form-inline.my-1(method='GET' action='/tankreceipts' id='receipts-by-date')
                label.mr-2(for='tankReceiptDateRange') Show
                select#tankReceiptDateRange.form-control.form-control-sm.mr-2(name='range' onchange='updateTankReceiptDateRange()')
                    each r in ranges
                        option(value=r[0] selected=(range === r[0]))= r[1]
                label.mr-2#tankrcpt_fromDateLabel(for='tankreceipts_fromDate' class=(isCustom ? '' : 'd-none')) From
                input#tankreceipts_fromDate.form-control.form-control-sm.mr-2(type='date', name='tankreceipts_fromDate', value=fromDate max=currentDate required class=(isCustom ? '' : 'd-none'))
                label.mr-2#tankrcpt_toDateLabel(for='tankreceipts_toDate' class=(isCustom ? '' : 'd-none')) To
                input#tankreceipts_toDate.form-control.form-control-sm.mr-2(type='date', name='tankreceipts_toDate', value=toDate max=currentDate required class=(isCustom ? '' : 'd-none'))
                button.btn.btn-sm.btn-outline-primary#tankrcpt_showBtn(type='submit' class=(isCustom ? '' : 'd-none')) Show
        div.card-body.p-0
            if tankReceiptsValues && tankReceiptsValues.length > 0
                div.table-responsive
                    //- Phones: each receipt is a card, collapsed to invoice no. + date; tap to open
                    table.table.table-hover.mb-0.tr-table.m-stack.m-collapse
                        thead.thead-light
                            tr
                                th Invoice Date
                                th Invoice No.
                                th Decanted On
                                th TT Number
                                th.d-none.d-lg-table-cell Incharge
                                th.d-none.d-lg-table-cell Driver
                                if productColumns && productColumns.length > 0
                                    each col in productColumns
                                        th.text-right #{col.label} (KL)
                                else
                                    th.text-right MS (KL)
                                    th.text-right HSD (KL)
                                    th.text-right XMS (KL)
                                th.text-right Amount
                                th Status
                                th Actions
                        tbody
                            each val in tankReceiptsValues
                                tr(id=`tank-receipt-${val.ttank_id}`)
                                    //- phones only: the right side of a collapsed card
                                    td.m-summary.d-md-none
                                        span.tr-sum-date= val.invoice_date
                                        span.tr-sum-amt= val.closingStatus === 'CLOSED' ? 'Closed' : 'Draft'
                                    td.text-nowrap(data-label='Invoice Date')= val.invoice_date
                                    td.text-nowrap.m-title
                                        span= val.invoice_number
                                        if val.hasInvoice
                                            button.btn.btn-link.btn-sm.p-0.ml-1(type='button' title='View invoice' onclick=`showInvoicePreview('${val.invoice_number}')`)
                                                span.bi.bi-file-pdf-fill.text-danger
                                    td.text-nowrap(data-label='Decanted On')
                                        span= val.decant_date
                                        if val.decant_time
                                            small.text-muted.ml-1= val.decant_time
                                    td.text-nowrap(data-label='TT Number')= val.truck_number
                                    td.d-none.d-lg-table-cell(data-label='Incharge')= val.decant_incharge
                                    td.d-none.d-lg-table-cell(data-label='Driver')= val.driver
                                    if productColumns && productColumns.length > 0
                                        each col in productColumns
                                            td.text-right(data-label=`${col.label} (KL)`)= val[col.key]
                                    else
                                        td.text-right(data-label='MS (KL)')= val.MS
                                        td.text-right(data-label='HSD (KL)')= val.HSD
                                        td.text-right(data-label='XMS (KL)')= val.XMS
                                    if Number(val.amount) > 0
                                        td.text-right.text-nowrap(data-label='Amount') ₹ #{fmtAmt(val.amount)}
                                    else
                                        td.text-right.text-muted(data-label='Amount') —
                                    td(data-label='Status')
                                        if val.closingStatus === 'CLOSED'
                                            span.badge.badge-success Closed
                                        else
                                            span.badge.badge-warning Draft
                                    td.text-nowrap.m-actions
                                        if val.closingStatus === 'CLOSED'
                                            a.btn.btn-sm.btn-outline-secondary.my-1(href='/edit-draft-tankrcpt?closingId=' + val.ttank_id, title='View receipt')
                                                span.oi.oi-eye
                                                span &nbsp;View
                                        else
                                            a.btn.btn-sm.btn-primary.mr-1.my-1(href='/edit-draft-tankrcpt?closingId=' + val.ttank_id, title='Continue receipt')
                                                span.oi.oi-pencil
                                                span &nbsp;Continue
                                            if(user.isAdmin)
                                                button.btn.btn-sm.btn-outline-danger.my-1(type='button' onClick=`deleteTankReceipt(${val.ttank_id})`, title='Delete draft')
                                                    span.oi.oi-trash
                                                    span &nbsp;Delete
            else
                p.text-muted.text-center.my-4 No tank receipts in this date range.
    +cardToggleMobile('table.m-collapse > tbody > tr:not(.m-static)')

    div.modal.fade#invoicePreviewModal(tabindex='-1' role='dialog' aria-labelledby='invoicePreviewTitle' aria-hidden='true')
        div.modal-dialog.modal-lg(role='document')
            div.modal-content
                div.modal-header.bg-light
                    h5.modal-title#invoicePreviewTitle Purchase Invoice
                    button.close(type='button' data-dismiss='modal' aria-label='Close')
                        span(aria-hidden='true') &times;
                div.modal-body#invoicePreviewBody
                    div.text-center.text-muted Loading...
                div.modal-footer
                    button.btn.btn-secondary(type='button' data-dismiss='modal') Close
