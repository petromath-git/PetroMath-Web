extends ../layout

block content
    .container.mt-3
        .d-flex.flex-wrap.justify-content-between.align-items-start.mb-3
            div
                h4.mb-1
                    i.bi.bi-file-earmark-text.mr-2
                    | GST Returns
                p.text-muted.mb-0 Make the GSTR-1 file from PetroMath and upload it on the GST portal yourself.
            div.text-md-right.mt-2.mt-md-0
                if gstConfig
                    .small.text-muted GSTIN
                    .font-weight-bold= gstConfig.gstin
                    a.small(href='/gst/config') Settings
                else
                    a.btn.btn-warning.btn-sm(href='/gst/config')
                        i.bi.bi-gear.mr-1
                        | Enter GSTIN first

        .row
            .col-lg-7.mb-3
                .card.h-100.border-success
                    .card-body
                        h5.card-title Each month
                        p.small.text-muted
                            | Pick the month, then go through the steps in order. Every figure ties to the GST Summary report and the books.
                        form(method='GET' action='/gst/gstr1')
                            select.custom-select.mb-3(name='period' style='max-width:12rem')
                                each p in periods
                                    option(value=p.code)= p.label
                            if gstConfig
                                - const steps = [{ url: '/gst/rcm', icon: 'bi-house', name: 'Reverse charge (rent)', when: 'self-invoice, any time in the month' }, { url: '/gst/gstr1', icon: 'bi-file-earmark-arrow-up', name: 'GSTR-1', when: 'download the JSON and upload by the 11th' }, { url: '/gst/itc', icon: 'bi-inbox', name: 'GSTR-2B and ITC', when: 'upload 2B after the 14th; Rule 42' }, { url: '/gst/gstr3b', icon: 'bi-calculator', name: 'GSTR-3B worksheet', when: 'type, pay and file by the 20th' }, { url: '/gst/workings', icon: 'bi-file-earmark-excel', name: 'GST Workings (Excel)', when: 'both returns laid out to file by hand, for the auditor' }]
                                .list-group
                                    each s, n in steps
                                        button.list-group-item.list-group-item-action.d-flex.align-items-center.text-left(type='submit' formaction=s.url)
                                            span.badge.badge-success.mr-3= n + 1
                                            i.bi.mr-2(class=s.icon)
                                            span.d-md-flex.align-items-center
                                                span.d-block.d-md-inline.font-weight-bold.mr-2= s.name
                                                span.d-block.d-md-inline.small.text-muted= s.when
                            else
                                button.btn.btn-secondary(type='button' disabled) Enter GSTIN first
            .col-lg-5.mb-3
                .card.h-100.border-info
                    .card-body
                        h5.card-title How to file
                        p.small.text-muted Step by step: one-time setup, uploading GSTR-1, checking and paying GSTR-3B, and the yearly return.
                        a.btn.btn-outline-info(href='/gst/guide')
                            i.bi.bi-journal-text.mr-1
                            | Open the guide
                        .small.mt-3
                            | GSTR-1 by the #[strong 11th] · GSTR-3B by the #[strong 20th]
                        hr
                        h6.mb-1 Set up once
                        a.small(href='/gst/hsn')
                            i.bi.bi-upc.mr-1
                            | HSN codes for products

        .card.mb-4
            .card-header.d-flex.justify-content-between.align-items-center.py-2
                span.font-weight-bold Files downloaded
                a.small(href='/gst/history') All
            if recentReturns && recentReturns.length
                .table-responsive
                    table.table.table-sm.mb-0.m-stack
                        thead
                            tr
                                th Return
                                th Period
                                th Downloaded
                                th.text-right Taxable value
                                th.text-right CGST
                                th.text-right SGST
                        tbody
                            each ret in recentReturns.slice(0, 10)
                                tr
                                    td.m-title #{ret.return_type} · #{ret.return_period.substring(0, 2) + '-' + ret.return_period.substring(2)}
                                    td.m-hide= ret.return_period.substring(0, 2) + '-' + ret.return_period.substring(2)
                                    td(data-label='Downloaded')= dateFmt(ret.creation_date)
                                    td.text-right(data-label='Taxable value')= Number(ret.total_taxable_value || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })
                                    td.text-right(data-label='CGST')= Number(ret.total_cgst || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })
                                    td.text-right(data-label='SGST')= Number(ret.total_sgst || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 })
            else
                .card-body.text-muted.small Nothing downloaded yet.
