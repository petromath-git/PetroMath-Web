extends layout

block content
    style.
        .timeline { list-style: none; padding-left: 0; margin: 0; }
        .timeline li { border-left: 3px solid #dee2e6; padding: 0 0 14px 14px; position: relative; }
        .timeline li::before { content: ''; position: absolute; left: -7px; top: 4px; width: 11px; height: 11px; border-radius: 50%; background: #1a73e8; }
        .timeline li.edit::before { background: #adb5bd; }
        .timeline .when { font-size: .8rem; color: #6c757d; }
        .lead-files { display: flex; flex-wrap: wrap; gap: 10px; }
        .lead-file { position: relative; width: 88px; }
        .lead-file .thumb { display: flex; align-items: center; justify-content: center; width: 88px; height: 88px; border: 1px solid #dee2e6; border-radius: 6px; overflow: hidden; background: #f8f9fa; color: #dc3545; font-size: 2rem; }
        .lead-file .thumb img { width: 100%; height: 100%; object-fit: cover; }
        .lead-file .meta { font-size: .7rem; color: #6c757d; line-height: 1.2; margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .lead-file .remove { position: absolute; top: -8px; right: -8px; width: 26px; height: 26px; padding: 0; border-radius: 50%; line-height: 1; }
        .attach-btn { cursor: pointer; margin-bottom: 0; }
        .attach-btn input { display: none; }

    - var statusOf = {}
    each s in statuses
        - statusOf[s.code] = s
    - var st = statusOf[lead.status] || { label: lead.status, badge: 'light' }
    - var isClosed = closedStatuses.indexOf(lead.status) !== -1
    - var tomorrow = moment().add(1, 'day').format('YYYY-MM-DD')
    - var defaultOwner = lead.assigned_to || user.Person_id
    - var leadOilCompanies = oilCompanies.indexOf(lead.oil_company) === -1 ? oilCompanies.concat([lead.oil_company]) : oilCompanies

    .container-fluid.mt-3
        a.btn.btn-sm.btn-link.pl-0.mb-2(href='/dealer-leads/admin' + (backQuery ? '?' + backQuery : ''))
            i.bi.bi-arrow-left
            |  Back to leads

        //- ── Lead header ──
        .card.mb-3
            .card-body
                .d-flex.justify-content-between.flex-wrap
                    div.mb-2
                        h4.mb-1
                            if lead.is_priority === 'Y'
                                span.text-warning(title='Priority') ★
                            = lead.contact_person_name || lead.bunk_name
                        .text-muted
                            if lead.contact_person_name && lead.bunk_name !== 'Not noted'
                                | #{lead.bunk_name} ·
                            | #{lead.place}
                            if lead.district && lead.district !== lead.place && lead.district !== 'Not noted'
                                | , #{lead.district}
                            |  · #{lead.oil_company}
                        if lead.phone_number
                            .mt-2
                                a.btn.btn-sm.btn-outline-primary.mr-2(href='tel:' + lead.phone_number)
                                    i.bi.bi-telephone
                                    |  #{lead.phone_number}
                                if waNumber
                                    a.btn.btn-sm.btn-outline-success(href='https://wa.me/' + waNumber target='_blank' rel='noopener')
                                        i.bi.bi-whatsapp
                                        |  WhatsApp
                        else
                            .mt-2.text-danger No phone number on record
                    div.text-md-right
                        span.badge(class='badge-' + st.badge style='font-size:1rem')= st.label
                        .small.mt-2 Owner:
                            strong= lead.assigned_to_name || 'Unassigned'
                        if !isClosed
                            .small Next follow-up:
                                strong= lead.next_followup_date ? moment(lead.next_followup_date).format('DD-MMM-YYYY') : 'not set'
                        .small.text-muted
                            | #{lead.event_name || lead.lead_mode} · collected #{moment(lead.creation_date).format('DD-MMM-YYYY')}
                if lead.needs_verification
                    .alert.alert-warning.py-2.mt-2.mb-0
                        i.bi.bi-exclamation-triangle
                        |  Check: #{lead.needs_verification}
                if lead.notes
                    .mt-2.small
                        strong Notes:
                        = lead.notes

        //- ── Attachments: visiting card, bunk photo, quote... ──
        - var remaining = maxFiles - attachments.length
        .card.mb-3#attachments
            .card-header.d-flex.justify-content-between.align-items-center
                strong
                    i.bi.bi-paperclip
                    |  Photos & files
                span.small.text-muted #{attachments.length} of #{maxFiles}
            .card-body
                if attachments.length
                    .lead-files.mb-3
                        each a in attachments
                            - var fileUrl = '/dealer-leads/admin/' + lead.lead_id + '/attachments/' + a.doc_id
                            .lead-file
                                a.thumb(href=fileUrl target='_blank' rel='noopener' title=a.file_name)
                                    if a.mime_type === 'application/pdf'
                                        i.bi.bi-file-earmark-pdf
                                    else
                                        img(src=fileUrl alt=a.file_name loading='lazy')
                                .meta(title=a.file_name)= a.file_name
                                .meta #{moment(a.creation_date).format('DD-MMM-YYYY')} · #{a.created_by}
                                if canRemoveAny || a.created_by === user.User_Name
                                    button.btn.btn-danger.btn-sm.remove(type='button' data-doc=a.doc_id title='Remove')
                                        i.bi.bi-x
                if remaining > 0
                    .d-flex.flex-wrap.align-items-center
                        label.btn.btn-primary.attach-btn.mr-2.mb-2
                            i.bi.bi-camera
                            |  Take photo
                            input#attachCamera(type='file' accept='image/*' capture='environment' data-source='CAMERA')
                        label.btn.btn-outline-primary.attach-btn.mr-2.mb-2
                            i.bi.bi-upload
                            |  Upload file
                            input#attachFile(type='file' accept='image/*,application/pdf' multiple=(remaining > 1) data-source='UPLOAD')
                        span#attachStatus.small.text-muted.mb-2
                    .small.text-muted Photo or PDF, up to #{maxMb} MB each. Large photos are shrunk before upload.
                else
                    .small.text-muted Limit reached. Remove a file to attach another.

        .row
            //- ── Log an activity ──
            .col-lg-5.mb-3
                .card
                    .card-header
                        strong Log call / follow-up
                    .card-body
                        form(method='POST' action='/dealer-leads/admin/' + lead.lead_id + '/activity')
                            .form-row
                                .col-5.mb-2
                                    label.small.mb-1 Type
                                    select.form-control.form-control-sm(name='activity_type' required)
                                        each t in activityTypes
                                            option(value=t.code)= t.label
                                .col-7.mb-2
                                    label.small.mb-1 Outcome
                                    select#outcome.form-control.form-control-sm(name='outcome' required)
                                        option(value='') Choose...
                                        each o in outcomes
                                            option(value=o.code data-suggest=o.suggestStatus || '')= o.label
                            .mb-2
                                label.small.mb-1 What was discussed
                                textarea.form-control.form-control-sm(name='notes' rows='3' maxlength='1000' placeholder='e.g. Owner busy, call after 6 pm. Wants day-close reports.')
                            .form-row
                                .col-6.mb-2
                                    label.small.mb-1 Status now
                                    select#status.form-control.form-control-sm(name='status' required)
                                        each s in statuses
                                            option(value=s.code selected=s.code === lead.status)= s.label
                                .col-6.mb-2
                                    label.small.mb-1 Owner
                                    select.form-control.form-control-sm(name='assigned_to')
                                        option(value='') Unassigned
                                        each a in assignees
                                            option(value=a.Person_id selected=a.Person_id === defaultOwner)= a.Person_Name
                            #followupGroup.mb-2
                                label.small.mb-1 Next follow-up
                                input#nextFollowup.form-control.form-control-sm(type='date' name='next_followup_date' value=tomorrow)
                                .mt-1
                                    each d in [{ n: 1, l: 'Tomorrow' }, { n: 3, l: '+3 days' }, { n: 7, l: '+1 week' }, { n: 30, l: '+1 month' }]
                                        button.btn.btn-sm.btn-outline-secondary.mr-1.mb-1.quick-date(type='button' data-date=moment().add(d.n, 'day').format('YYYY-MM-DD'))= d.l
                            #closedNote.small.text-muted.mb-2(style='display:none') This closes the lead, so no follow-up date is needed.
                            button.btn.btn-primary.btn-block(type='submit')
                                i.bi.bi-check2-circle
                                |  Save

                //- ── Correct lead details ──
                .card.mt-3
                    .card-header
                        a.text-dark(data-toggle='collapse' href='#editDetails')
                            i.bi.bi-pencil
                            |  Edit lead details
                    #editDetails.collapse
                        .card-body
                            form(method='POST' action='/dealer-leads/admin/' + lead.lead_id)
                                .form-row
                                    .col-6.mb-2
                                        label.small.mb-1 Contact person
                                        input.form-control.form-control-sm(name='contact_person_name' value=lead.contact_person_name || '' maxlength='100')
                                    .col-6.mb-2
                                        label.small.mb-1 Role
                                        select.form-control.form-control-sm(name='contact_role')
                                            each r in roles
                                                option(value=r selected=r === lead.contact_role)= r.charAt(0) + r.slice(1).toLowerCase()
                                    .col-12.mb-2
                                        label.small.mb-1 Bunk name
                                        input.form-control.form-control-sm(name='bunk_name' value=lead.bunk_name required maxlength='150')
                                    .col-6.mb-2
                                        label.small.mb-1 Phone
                                        input.form-control.form-control-sm(name='phone_number' value=lead.phone_number maxlength='15')
                                    .col-6.mb-2
                                        label.small.mb-1 Oil company
                                        select.form-control.form-control-sm(name='oil_company')
                                            each o in leadOilCompanies
                                                option(value=o selected=o === lead.oil_company)= o
                                    .col-6.mb-2
                                        label.small.mb-1 Place
                                        input.form-control.form-control-sm(name='place' value=lead.place required maxlength='100')
                                    .col-6.mb-2
                                        label.small.mb-1 District
                                        input.form-control.form-control-sm(name='district' value=lead.district required maxlength='100')
                                    .col-12.mb-2
                                        label.small.mb-1 Notes
                                        textarea.form-control.form-control-sm(name='notes' rows='2' maxlength='500')= lead.notes || ''
                                    .col-12.mb-2
                                        label.small.mb-1 Needs verification (clear it once checked)
                                        input.form-control.form-control-sm(name='needs_verification' value=lead.needs_verification || '' maxlength='255')
                                    .col-12.mb-2
                                        .custom-control.custom-checkbox
                                            input#editPriority.custom-control-input(type='checkbox' name='is_priority' value='Y' checked=lead.is_priority === 'Y')
                                            label.custom-control-label(for='editPriority') ★ Priority lead
                                button.btn.btn-outline-primary.btn-sm(type='submit') Save details

            //- ── History ──
            .col-lg-7.mb-3
                .card
                    .card-header
                        strong History (#{activities.length})
                    .card-body
                        if activities.length === 0
                            .text-muted No calls logged yet.
                        else
                            ul.timeline
                                each a in activities
                                    li(class=a.activity_type === 'EDIT' ? 'edit' : '')
                                        .when
                                            | #{moment(a.creation_date).format('DD-MMM-YYYY HH:mm')} · #{a.created_by_name || a.created_by}
                                        div
                                            strong= a.activity_label
                                            if a.outcome_label
                                                |  — #{a.outcome_label}
                                        if a.notes
                                            div(style='white-space:pre-wrap')= a.notes
                                        if a.activity_type !== 'EDIT'
                                            .small.text-muted
                                                | Status: #{a.status_label}
                                                if a.assigned_to_after_name
                                                    |  · Owner: #{a.assigned_to_after_name}
                                                if a.next_followup_date
                                                    |  · Next: #{moment(a.next_followup_date).format('DD-MMM-YYYY')}

    script.
        (function () {
            var closed = !{JSON.stringify(closedStatuses)};
            var status = document.getElementById('status');
            var followupGroup = document.getElementById('followupGroup');
            var closedNote = document.getElementById('closedNote');
            var nextFollowup = document.getElementById('nextFollowup');

            function syncFollowup() {
                var isClosed = closed.indexOf(status.value) !== -1;
                followupGroup.style.display = isClosed ? 'none' : '';
                closedNote.style.display = isClosed ? '' : 'none';
                nextFollowup.required = !isClosed;
            }

            document.getElementById('outcome').addEventListener('change', function () {
                var suggest = this.options[this.selectedIndex].getAttribute('data-suggest');
                if (suggest) status.value = suggest;
                syncFollowup();
            });
            status.addEventListener('change', syncFollowup);
            document.querySelectorAll('.quick-date').forEach(function (btn) {
                btn.addEventListener('click', function () { nextFollowup.value = btn.getAttribute('data-date'); });
            });
            syncFollowup();
        })();

    script.
        // Attachments: phone photos are 3-6 MB, so images over 1.5 MB (or in a format
        // the server won't take, e.g. HEIC) are redrawn as a 1920 px JPEG first.
        // The server checks type (by the file's bytes), size and count again.
        (function () {
            var leadId = !{JSON.stringify(lead.lead_id)};
            var remaining = !{JSON.stringify(remaining)};
            var maxBytes = !{JSON.stringify(maxMb)} * 1024 * 1024;
            var okTypes = ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
            var statusEl = document.getElementById('attachStatus');
            var baseUrl = '/dealer-leads/admin/' + leadId + '/attachments';

            function sizeText(b) { return b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB'; }

            function prepare(file) {
                if (file.type === 'application/pdf') return Promise.resolve(file);
                if (file.type.indexOf('image/') !== 0) return Promise.reject(new Error(file.name + ': only photos and PDF files can be attached'));
                if (okTypes.indexOf(file.type) >= 0 && file.size <= 1.5 * 1048576) return Promise.resolve(file);
                return new Promise(function (resolve, reject) {
                    var img = new Image();
                    var url = URL.createObjectURL(file);
                    img.onload = function () {
                        var scale = Math.min(1, 1920 / Math.max(img.width, img.height));
                        var c = document.createElement('canvas');
                        c.width = Math.round(img.width * scale);
                        c.height = Math.round(img.height * scale);
                        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
                        URL.revokeObjectURL(url);
                        c.toBlob(function (blob) {
                            if (!blob) return okTypes.indexOf(file.type) >= 0 ? resolve(file) : reject(new Error(file.name + ': could not read this photo'));
                            var name = (file.name || 'photo').replace(/\.[^.]*$/, '') + '.jpg';
                            resolve(new File([blob], name, { type: 'image/jpeg' }));
                        }, 'image/jpeg', 0.8);
                    };
                    img.onerror = function () {
                        URL.revokeObjectURL(url);
                        if (okTypes.indexOf(file.type) >= 0) return resolve(file);
                        reject(new Error(file.name + ': this photo format is not supported. Please take it again as JPEG.'));
                    };
                    img.src = url;
                });
            }

            function setBusy(busy, text) {
                document.querySelectorAll('.attach-btn').forEach(function (b) { b.classList.toggle('disabled', busy); });
                document.querySelectorAll('.attach-btn input').forEach(function (i) { i.disabled = busy; });
                if (statusEl) statusEl.textContent = text || '';
            }

            function onPick(e) {
                var input = e.target;
                var files = Array.prototype.slice.call(input.files || []);
                input.value = '';
                if (!files.length) return;
                if (files.length > remaining) return alert('You can attach ' + remaining + ' more ' + (remaining === 1 ? 'file' : 'files') + ' only');

                setBusy(true, 'Preparing...');
                Promise.all(files.map(prepare)).then(function (out) {
                    for (var i = 0; i < out.length; i++) {
                        if (out[i].size > maxBytes) throw new Error(out[i].name + ' is ' + sizeText(out[i].size) + '. Each file must be ' + (maxBytes / 1048576) + ' MB or smaller');
                    }
                    var fd = new FormData();
                    fd.append('capture_source', input.getAttribute('data-source'));
                    out.forEach(function (f) { fd.append('attachments', f, f.name); });
                    setBusy(true, 'Uploading...');
                    return fetch(baseUrl, { method: 'POST', body: fd, credentials: 'same-origin' })
                        .then(function (r) { return r.json().catch(function () { return { success: false, error: 'Upload failed (' + r.status + ')' }; }); });
                }).then(function (d) {
                    if (!d.success) throw new Error(d.error || 'Upload failed');
                    location.hash = 'attachments';
                    location.reload();
                }).catch(function (err) {
                    setBusy(false, '');
                    alert(err.message || 'Upload failed');
                });
            }

            ['attachCamera', 'attachFile'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.addEventListener('change', onPick);
            });

            document.querySelectorAll('.lead-file .remove').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    if (!confirm('Remove this attachment?')) return;
                    btn.disabled = true;
                    fetch(baseUrl + '/' + btn.getAttribute('data-doc'), { method: 'DELETE', credentials: 'same-origin' })
                        .then(function (r) { return r.json(); })
                        .then(function (d) {
                            if (!d.success) throw new Error(d.error || 'Failed to remove');
                            location.reload();
                        })
                        .catch(function (err) { btn.disabled = false; alert(err.message); });
                });
            });
        })();
