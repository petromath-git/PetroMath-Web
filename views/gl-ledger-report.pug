extends layout
include mixins/mixins

block content
    .container-fluid.pt-3

        .d-flex.justify-content-between.align-items-center.mb-3
            h4.mb-0 Ledger Report
            a.btn.btn-sm.btn-outline-secondary(href="/gl/day-book") &larr; Day Book

        form.row.align-items-end.mb-3(method="GET" action="/gl/ledger")
            .col-md-4
                label.small.mb-1 Ledger
                select#ledgerSelect.form-control.form-control-sm(name="ledger_id")
                    if ledger
                        option(value=ledger.ledger_id selected)= ledger.ledger_name
                    else
                        option(value="") — Search ledger —
            .col-auto
                label.small.mb-1 Period
                select.form-control.form-control-sm#glPeriod(onchange="glSetPeriod(this)" data-from="glFrom" data-to="glTo" data-monthyear="glMonthYearWrap" data-month="glMonth" data-year="glYear")
                    option(value="month_year") Month / Year
                    option(value="this_month") This Month
                    option(value="last_month") Last Month
                    option(value="this_fy") This Financial Year
                    option(value="last_fy") Last Financial Year
                    option(value="custom" selected) Custom
            +monthYearPicker('gl')
            .col-auto
                label.small.mb-1 From Date
                input.form-control.form-control-sm#glFrom(type="date" name="from_date" value=fromDate)
            .col-auto
                label.small.mb-1 To Date
                input.form-control.form-control-sm#glTo(type="date" name="to_date" value=toDate)
            if allowManualOb
                .col-auto
                    label.small.mb-1(title="Not saved — e.g. the SAP / bank statement opening, to compare closing balances") Opening Balance (manual)
                    .input-group.input-group-sm
                        input.form-control.form-control-sm(type="number" step="0.01" min="0" name="manual_ob" value=manualOb placeholder="System" style="width:130px")
                        .input-group-append
                            select.form-control.form-control-sm(name="manual_ob_side" style="width:60px")
                                option(value="DR" selected=(manualObSide !== 'CR')) Dr
                                option(value="CR" selected=(manualObSide === 'CR')) Cr
            .col-auto.align-self-end
                button.btn.btn-primary.btn-sm(type="submit") View

        if !ledger
            .alert.alert-info.py-2 Select a ledger to view its account statement.
        else
            .mb-2.d-flex.align-items-center
                span.font-weight-bold= ledger.ledger_name
                span.text-muted.ml-2.small= ledger.group_name + ' — ' + ledger.group_nature
                if allowManualOb && monthRows.length
                    button.btn.btn-sm.btn-outline-primary.ml-auto(type="button" data-toggle="modal" data-target="#monthlyBalModal") Monthly Balances

            - const fmt = (n) => Math.abs(n).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2})
            - const balLabel = (n) => n >= 0 ? fmt(n) + ' Dr' : fmt(n) + ' Cr'

            .row.mb-3
                .col-3
                    .card.text-center.py-2
                        .small.text-muted
                            | Opening Balance
                            if systemObNet !== null
                                |
                                span.badge.badge-warning.ml-1 Manual
                        strong(class=(obNet >= 0 ? 'text-dark' : 'text-danger'))= balLabel(obNet)
                        if systemObNet !== null
                            .small.text-muted System: #{balLabel(systemObNet)}
                .col-3
                    .card.text-center.py-2
                        .small.text-muted Period DR (₹)
                        strong= fmt(periodDr)
                .col-3
                    .card.text-center.py-2
                        .small.text-muted Period CR (₹)
                        strong= fmt(periodCr)
                .col-3
                    .card.text-center.py-2
                        .small.text-muted Closing Balance
                        strong(class=(closingBalance >= 0 ? 'text-dark' : 'text-danger'))= balLabel(closingBalance)

            if !entries.length
                .alert.alert-info.py-2 No transactions in this date range.
            else
                .table-responsive
                    table.table.table-bordered.table-sm#ledgerTable
                        thead.thead-dark
                            tr
                                th(style="width:90px") Date
                                th(style="width:95px") Voucher No
                                th(style="width:80px") Type
                                th Particulars
                                th.text-right(style="width:110px") DR (₹)
                                th.text-right(style="width:110px") CR (₹)
                                th.text-right(style="width:120px") Balance
                        tbody
                            tr.table-light.font-weight-bold
                                td(colspan="6")= systemObNet !== null ? 'Opening Balance (manual — not saved)' : 'Opening Balance'
                                td.text-right= balLabel(obNet)
                            each e in entries
                                tr(class=(e.is_reversal === 'Y' ? 'table-warning' : ''))
                                    td.small= e.voucher_date
                                    td.small
                                        = e.voucher_no
                                        if e.is_reversal === 'Y'
                                            |
                                            span.badge.badge-warning REV
                                    td.text-center
                                        - const tc = {SALES:'success',PURCHASE:'primary',PAYMENT:'danger',RECEIPT:'info',JOURNAL:'secondary',CONTRA:'dark'}[e.voucher_type] || 'secondary'
                                        span.badge(class='badge-' + tc)= e.voucher_type
                                    td.small(style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title=e.narration)= e.narration
                                    td.text-right.small
                                        if e.dr_amount > 0
                                            = fmt(e.dr_amount)
                                    td.text-right.small
                                        if e.cr_amount > 0
                                            = fmt(e.cr_amount)
                                    td.text-right.small.font-weight-bold= balLabel(e.balance)
                        tfoot
                            tr.font-weight-bold.bg-light
                                td(colspan="4") Closing Balance
                                td.text-right= fmt(periodDr)
                                td.text-right= fmt(periodCr)
                                td.text-right= balLabel(closingBalance)

            if allowManualOb && monthRows.length
                #monthlyBalModal.modal.fade(tabindex="-1" role="dialog")
                    .modal-dialog.modal-xl(role="document")
                        .modal-content
                            .modal-header.py-2
                                div
                                    h6.modal-title.mb-0 Monthly Balances — #{ledger.ledger_name}
                                    .small.text-muted
                                        | Starting from #{systemObNet !== null ? 'manual' : 'system'} opening #{balLabel(obNet)}
                                    if stmt && stmt.ambiguous
                                        .small.text-warning More than one statement is linked to this ledger (#{stmt.ambiguous}) — statement comparison not shown.
                                    else if stmt
                                        .small.text-muted
                                            | Statement: #{stmt.nickname} (#{stmt.firstDate} to #{stmt.lastDate})
                                            if stmt.opening !== null && stmt.opening !== undefined
                                                |  · opening #{balLabel(stmt.opening)}
                                                if Math.abs(stmt.opening - obNet) >= 0.005
                                                    |  ·
                                                    a.ml-1(href=`/gl/ledger?ledger_id=${ledgerId}&from_date=${fromDate}&to_date=${toDate}&manual_ob=${Math.abs(stmt.opening).toFixed(2)}&manual_ob_side=${stmt.opening < 0 ? 'CR' : 'DR'}&show_monthly=1`) Use statement opening
                                button.close(type="button" data-dismiss="modal") &times;
                            .modal-body.p-0
                                .table-responsive
                                    table.table.table-sm.table-bordered.mb-0#monthlyBalTable
                                        thead.thead-light
                                            tr
                                                th Month
                                                th.text-right Opening
                                                th.text-right Debit (₹)
                                                th.text-right Credit (₹)
                                                th.text-right Closing
                                                if stmt && !stmt.ambiguous
                                                    th.text-right Statement Closing
                                                    th.text-right Difference
                                        tbody
                                            each m in monthRows
                                                tr(data-ym=m.ym)
                                                    td.text-nowrap
                                                        a.mb-daily-link(href="#" title="Show this month day by day" data-start=m.start data-end=m.end data-opening=m.opening.toFixed(2) data-label=m.label data-ym=m.ym)= m.label
                                                    td.text-right.text-nowrap= balLabel(m.opening)
                                                    td.text-right= m.dr > 0 ? fmt(m.dr) : ''
                                                    td.text-right= m.cr > 0 ? fmt(m.cr) : ''
                                                    td.text-right.text-nowrap.font-weight-bold= balLabel(m.closing)
                                                    if stmt && !stmt.ambiguous
                                                        if m.stmtClosing === undefined
                                                            td.text-right.text-muted —
                                                            td
                                                        else
                                                            td.text-right.text-nowrap(title=(m.stmtPartial ? 'Statement ends ' + stmt.lastDate : ''))
                                                                = balLabel(m.stmtClosing)
                                                                if m.stmtPartial
                                                                    | *
                                                            td.text-right.text-nowrap(class=(Math.abs(m.diff) >= 0.005 ? 'text-danger font-weight-bold' : 'text-success'))
                                                                = Math.abs(m.diff) >= 0.005 ? balLabel(m.diff) : '✓'
                                if stmt && !stmt.ambiguous && monthRows.some(m => m.stmtPartial)
                                    .small.text-muted.px-3.py-1 * Statement uploaded only up to #{stmt.lastDate}.
                                .small.text-muted.px-3.py-1 Click a month to see it day by day.
                                #mbDaily.border-top.d-none(data-ledger=ledgerId)

    script.
        $(document).ready(function() {
            if (/[?&]show_monthly=1/.test(location.search)) $('#monthlyBalModal').modal('show');
            initMonthlyDrill();
            $('#ledgerSelect').select2({
                placeholder: '— Search ledger —',
                allowClear: true,
                minimumInputLength: 1,
                ajax: {
                    url: '/gl/api/ledgers/search',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return { q: params.term };
                    },
                    processResults: function(data) {
                        return {
                            results: data.map(function(l) {
                                return { id: l.ledger_id, text: l.ledger_name };
                            })
                        };
                    }
                }
            });
        });

        // ── Monthly Balances → one month day by day ──
        function initMonthlyDrill() {
            var $box = $('#mbDaily');
            if (!$box.length) return;
            var MON = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
            var current = null, showAll = false, showSmall = false;
            var SMALL = 1;   // paise rounding on invoices (book in paise, SAP in whole rupees)

            function esc(s) { return $('<div>').text(s == null ? '' : String(s)).html(); }
            function fmt(n) { return Math.abs(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
            function bal(n) { return fmt(n) + (n >= 0 ? ' Dr' : ' Cr'); }
            function amt(n) { return n > 0 ? fmt(n) : ''; }
            function dmy(ymd) { return ymd.substring(8, 10) + '-' + MON[+ymd.substring(5, 7) - 1] + '-' + ymd.substring(0, 4); }
            function signed(n) { return (n > 0 ? '+' : '−') + fmt(n); }

            function entriesHtml(d) {
                var gl = (d.glEntries || []).map(function(e) {
                    return '<tr><td class="text-nowrap">' + esc(e.voucher_no) + '</td><td>' + esc(e.narration) + '</td>' +
                        '<td class="text-right">' + amt(e.dr) + '</td><td class="text-right">' + amt(e.cr) + '</td></tr>';
                }).join('') || '<tr><td colspan="4" class="text-muted">No entries</td></tr>';
                var st = (d.stmtEntries || []).map(function(e) {
                    return '<tr><td>' + esc(e.description) + '</td>' +
                        '<td class="text-right">' + amt(e.dr) + '</td><td class="text-right">' + amt(e.cr) + '</td></tr>';
                }).join('') || '<tr><td colspan="3" class="text-muted">No entries</td></tr>';
                return '<tr class="mb-daily-detail"><td colspan="7" class="bg-light p-2"><div class="row">' +
                    '<div class="col-md-6"><div class="small font-weight-bold mb-1">PetroMath</div>' +
                    '<table class="table table-sm table-bordered bg-white mb-0"><thead><tr><th>Voucher</th><th>Particulars</th><th class="text-right">Dr</th><th class="text-right">Cr</th></tr></thead><tbody>' + gl + '</tbody></table></div>' +
                    '<div class="col-md-6"><div class="small font-weight-bold mb-1">Statement</div>' +
                    '<table class="table table-sm table-bordered bg-white mb-0"><thead><tr><th>Description</th><th class="text-right">Dr</th><th class="text-right">Cr</th></tr></thead><tbody>' + st + '</tbody></table></div>' +
                    '</div></td></tr>';
            }

            function render() {
                var data = current.data;
                var anyChange = data.days.filter(function(d) { return d.change && Math.abs(d.change) >= 0.005; });
                var changed = anyChange.filter(function(d) { return showSmall || Math.abs(d.change) >= SMALL; });
                var smallCount = anyChange.length - anyChange.filter(function(d) { return Math.abs(d.change) >= SMALL; }).length;
                var html = '<div class="d-flex align-items-center px-3 pt-2 pb-1">' +
                    '<strong>' + esc(current.label) + ' — day by day</strong>';
                if (data.hasStmt) {
                    html += '<label class="small mb-0 ml-3"><input type="checkbox" id="mbDailySmall"' + (showSmall ? ' checked' : '') + '> Include changes under ₹1</label>' +
                        '<label class="small mb-0 ml-3"><input type="checkbox" id="mbDailyAll"' + (showAll ? ' checked' : '') + '> Show all days</label>';
                }
                html += '<a href="#" class="small ml-auto" id="mbDailyClose">Close</a></div>';
                if (data.hasStmt && !showAll) {
                    var note = !changed.length
                        ? '<span class="text-success">No new difference in this period ✓</span>'
                        : 'Days where the difference changes (' + changed.length + '). A change reversed the next day is usually the same entry posted a day apart.';
                    if (!showSmall && smallCount) note += ' ' + smallCount + ' day(s) with paise rounding under ₹1 hidden.';
                    html += '<div class="px-3 pb-1 small text-muted">' + note + '</div>';
                }
                var rows = (data.hasStmt && !showAll) ? changed : data.days;
                if (rows.length) {
                    html += '<div class="table-responsive"><table class="table table-sm table-bordered mb-0" id="mbDailyTable"><thead class="thead-light"><tr>' +
                        '<th>Date</th><th class="text-right">Debit (₹)</th><th class="text-right">Credit (₹)</th><th class="text-right">Closing</th>' +
                        (data.hasStmt ? '<th class="text-right">Statement Closing</th><th class="text-right">Difference</th><th class="text-right">Change</th>' : '') +
                        '</tr></thead><tbody>';
                    rows.forEach(function(d) {
                        var isChange = d.change && Math.abs(d.change) >= (showSmall ? 0.005 : SMALL);
                        html += '<tr' + (isChange ? ' class="table-warning"' : '') + '><td class="text-nowrap">' + dmy(d.date) + '</td>' +
                            '<td class="text-right">' + amt(d.dr) + '</td><td class="text-right">' + amt(d.cr) + '</td>' +
                            '<td class="text-right text-nowrap font-weight-bold">' + bal(d.closing) + '</td>';
                        if (data.hasStmt) {
                            if (d.stmtClosing === undefined) {
                                html += '<td class="text-right text-muted">—</td><td></td><td></td>';
                            } else {
                                html += '<td class="text-right text-nowrap">' + bal(d.stmtClosing) + (d.date > data.stmtLastDate ? ' *' : '') + '</td>' +
                                    '<td class="text-right text-nowrap ' + (Math.abs(d.diff) >= 0.005 ? 'text-danger' : 'text-success') + '">' + (Math.abs(d.diff) >= 0.005 ? bal(d.diff) : '✓') + '</td>' +
                                    '<td class="text-right text-nowrap font-weight-bold">' + (isChange ? signed(d.change) : '') + '</td>';
                            }
                        }
                        html += '</tr>';
                        if (isChange) html += entriesHtml(d);
                    });
                    html += '</tbody></table></div>';
                }
                $box.html(html).removeClass('d-none');
            }

            $('#monthlyBalTable').on('click', '.mb-daily-link', function(e) {
                e.preventDefault();
                var $a = $(this);
                $('#monthlyBalTable tr').removeClass('table-active');
                $a.closest('tr').addClass('table-active');
                $box.removeClass('d-none').html('<div class="p-3 small text-muted">Loading…</div>');
                $.getJSON('/gl/ledger/daily', {
                    ledger_id: $box.data('ledger'),
                    start: $a.data('start'),
                    end: $a.data('end'),
                    opening: $a.data('opening')
                }).done(function(data) {
                    current = { label: $a.data('label'), data: data };
                    showAll = false;
                    render();
                    $box[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
                }).fail(function(xhr) {
                    $box.html('<div class="p-3 small text-danger">' + esc((xhr.responseJSON && xhr.responseJSON.error) || 'Failed to load') + '</div>');
                });
            });
            $box.on('change', '#mbDailyAll', function() { showAll = this.checked; render(); });
            $box.on('change', '#mbDailySmall', function() { showSmall = this.checked; render(); });
            $box.on('click', '#mbDailyClose', function(e) {
                e.preventDefault();
                $box.addClass('d-none').empty();
                $('#monthlyBalTable tr').removeClass('table-active');
            });
        }

    style.
        #ledgerTable, #monthlyBalTable, #mbDaily { font-size: 0.8rem; }
